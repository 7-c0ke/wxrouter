# 30-real-stack.fz: the real thing on both boxes. One workflow:
#
#   box-a, box-b   one GPU service per box. Each runs our supervisor (serve/node_stack.py), which keeps two
#                  servers alive on the box's GPU: the real forecast server and llama-server with the NVIDIA LLM.
#                  The supervisor also starts a real fine-tune job when asked over HTTP.
#   router         the team's router.py in front of the two forecast servers
#   router2        the second router (router/router.py): LLM traffic and the split forecast; not yet used by the page
#   ui             the Control Room (ui/), with the supervisors' addresses and the LLM's address
#   prep           a short job that brings /wx/repo up to date and checks that the files are there
#   hold           a job that only waits, so that Fuzzball keeps the services running. It names ui and router2:
#                  Fuzzball starts a service only when a job needs it, directly or through another service.
#
# Why one service per box: Fuzzball gives a box's GPU to one job or service at a time. Everything that
# needs the GPU on a box (forecasts, the LLM, a fine-tune) therefore lives inside that one service.
#
# Everything runs from the team volume, which 04-fetch-llm.fz and 05-setup-volume.fz (in quick/) fill:
#   /wx/repo     the team repository          /wx/pydeps   the Python packages the PyTorch image lacks
#   /wx/bundle   the weather model and data   /wx/llama    llama.cpp      /wx/models   the LLM file
#
#   fuzzball workflow validate fuzzball/30-real-stack.fz
#   fuzzball workflow start -n real-stack fuzzball/30-real-stack.fz
#   fuzzball workflow log <id> box-a -f
#   fuzzball workflow port-forward <id> ui 8080:8080        then open http://localhost:8080
#   fuzzball workflow stop <id>                             it holds both GPUs until it is stopped (8 hours at most)
#
# Ports: forecast 8001 / 8002, LLM 8090 / 8091, supervisor 8109 / 8110, router 8000, page 8080,
# second router 8100 (router2: chat to either box's LLM, a forecast split across both boxes).
#
# Start it only from the current copy of this file (git pull first; in the web page, paste it from GitHub).
# A copy that is older than the repo's stops at once and says so: in the first job, or in the box's log.
# When you change this file in a way that matters, raise STACK_REV in prep and WX_STACK_REV on both boxes.
#
# The model in use is the link /wx/bundle/weights/serving.pt. prep makes it (to the base model,
# afno_event.pt) when it is missing and never changes it otherwise. Back to the base model:
#   bench/swap_weights.py --to /wx/bundle/weights/afno_event.pt
# The stack ends by itself 8 hours after its start (the hold job), if nobody stops it sooner.
# Five scripts run from inside the stack, each with one command
# (fuzzball workflow exec <id> box-a -- bash -c "cd /wx/repo && python3 bench/<script>" < /dev/null):
#   bench/preflight.py                                one minute of read-only checks; run it first
#   bench/scene_finetune.py                           a real fine-tune on box-a while forecasts flow
#   bench/swap_weights.py --to /wx/ft/box-a/tuned.pt  the tuned model goes live, one box at a time
#   bench/scene_split.py                              one 20-member forecast split across both boxes
#   bench/fault_table.py                              all five routing rules against the same trace and the same
#                                                     two real faults (a fine-tune on box-a, box-b's server killed)
# Written at the hackathon (Nov 14, 2026).
version: v4

volumes:
  wx:
    use: team14
    name: wxdesk

jobs:
  prep:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:26.02-py3
    mounts:
      /wx:
        volume: wx
    script: |
      #!/bin/bash
      export HOME=/wx/home GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0='*'
      echo "=== prep on $(hostname -I) $(date -u +%FT%TZ)"
      git -C /wx/repo pull --ff-only origin main || echo "WARNING: git pull failed; the copy on the volume is used as it is"
      git -C /wx/repo log -1 --format='/wx/repo is at %h "%s" (%cd)' --date=iso
      # STACK_REV goes up whenever this file changes in a way that matters. The code always comes from the
      # repo on the volume, but the commands below come from the copy of this file that was started. A saved
      # draft in the web page, or an old checkout, would run old commands with new code. So compare, and
      # stop here, in the first seconds, before a GPU is asked for. (The two boxes give the same number to
      # their supervisor as WX_STACK_REV. A copy from before this check gives none, and the supervisor stops.)
      STACK_REV=4
      repo_rev=$(sed -n 's/^ *STACK_REV=\([0-9][0-9]*\) *$/\1/p' /wx/repo/fuzzball/30-real-stack.fz | head -1)
      echo "stack file: this copy is revision $STACK_REV, the repo's is ${repo_rev:-unknown}"
      if [ -n "$repo_rev" ] && [ "$STACK_REV" -lt "$repo_rev" ]; then
          echo "STOP: this stack was started from an OLD copy of fuzzball/30-real-stack.fz."
          echo "      Use the repo's current file. After git pull:"
          echo "        fuzzball workflow start -n real-stack fuzzball/30-real-stack.fz    (or: python deploy/fb.py up)"
          echo "      In the web page, paste the current file from GitHub first: the editor keeps an old draft."
          exit 1
      fi
      missing=0
      for f in /wx/repo/serve/node_stack.py /wx/repo/serve/forecast_server.py /wx/repo/router.py /wx/repo/ui/server.py \
          /wx/bundle/weights/afno_event.pt /wx/bundle/stats.json /wx/pydeps/physicsnemo; do
          if [ -e "$f" ]; then echo "  yes      $f"; else echo "  MISSING  $f"; missing=1; fi
      done
      for f in /wx/llama/llama-server /wx/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q4_0.gguf /wx/gfs-year/analyses.npy; do
          if [ -e "$f" ]; then echo "  yes      $f"; else echo "  not yet  $f  (the stack starts without it)"; fi
      done
      # The newest NOAA analysis as the model's starting weather (about 18 MB from NOAA's open bucket), so
      # that "the next 48 hours" starts near now and not at this morning's analysis. Not fatal: without it
      # the boxes start from the newest state that is already on the volume.
      fetched=$(cd /wx/repo && PYTHONPATH=/wx/pydeps PYTHONUSERBASE=/wx/pyuser timeout 240 \
          python weather/gfs_live.py --out /wx/bundle/states --data /wx/bundle 2>&1); code=$?
      echo "$fetched" | tail -4
      [ $code -eq 0 ] || echo "WARNING: no newer NOAA analysis was fetched (exit $code); the newest state on the volume is used"
      echo "  states: $(ls /wx/bundle/states 2>/dev/null | tr '\n' ' ')"
      mkdir -p /wx/logs/box-a /wx/logs/box-b /wx/kv /wx/ft
      # The forecast servers load the model through this link, so that a tuned model can be put in use while
      # the stack runs (bench/swap_weights.py). This job makes the link when it is not there, and otherwise
      # leaves it alone: this job runs at once, also when a second copy of the stack is started by mistake,
      # and it must not change the model under a stack that is serving.
      W=/wx/bundle/weights
      if [ -L $W/serving.pt ] && [ -r $W/serving.pt ]; then
          echo "  model in use: serving.pt -> $(readlink $W/serving.pt)  (left as it was)"
      elif ln -sfn afno_event.pt $W/serving.pt.new 2>/dev/null && mv -Tf $W/serving.pt.new $W/serving.pt 2>/dev/null; then
          echo "  model in use: serving.pt -> afno_event.pt  (the link was missing or broken; made now)"
      else
          echo "  MISSING  $W/serving.pt, and it could not be made"; missing=1
      fi
      exit $missing
    resource:
      cpu:
        cores: 2
      memory:
        size: 4GB
    policy:
      timeout:
        execute: 10m

  hold:
    image:
      uri: docker://rockylinux:9
    command: ["sleep", "28800"]
    # hold names every service that nothing else leads to. In the first run of revision 4 (Nov 14) nothing
    # depended on router2, and Fuzzball 4.3.1 ended that service after 0 s with an empty log, while the rest
    # of the stack ran. (The revision number stays 4: a copy without this line still starts a working stack,
    # only without the second router.)
    depends-on:
      - name: ui
        status: RUNNING
      - name: router2
        status: RUNNING
    resource:
      cpu:
        cores: 1
      memory:
        size: 256MB

services:
  box-a:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:26.02-py3
    mounts:
      /wx:
        volume: wx
    depends-on:
      - name: prep
        status: FINISHED
    script: |
      #!/bin/bash
      export HOME=/wx/home USER="${USER:-wx}" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
      export PYTHONPATH=/wx/pydeps PYTHONUSERBASE=/wx/pyuser
      export LD_LIBRARY_PATH=/wx/llama:${LD_LIBRARY_PATH:-}
      export WX_STACK_REV=4      # the same number as STACK_REV in prep; serve/node_stack.py checks it
      RUN=/tmp/wx-run; mkdir -p $RUN/cache
      export XDG_CACHE_HOME=$RUN/cache TORCHINDUCTOR_CACHE_DIR=$RUN/cache/inductor TRITON_CACHE_DIR=$RUN/cache/triton
      echo "[box-a] host=$(hostname) ip=$(hostname -I) $(date -u +%FT%TZ)"
      nvidia-smi --query-gpu=name,memory.used,utilization.gpu --format=csv,noheader
      cd /wx/repo || exit 1
      exec python serve/node_stack.py --name box-a --admin --port 8109 --log-dir /wx/logs/box-a \
        --serve forecast="python serve/forecast_server.py --node box-a --host 0.0.0.0 --port 8001 --admin --weights /wx/bundle/weights/serving.pt --data /wx/bundle" \
        --serve llm="/wx/llama/llama-server --model /wx/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q4_0.gguf --alias nemotron --host 0.0.0.0 --port 8090 --n-gpu-layers 999 --metrics -c 65536 -np 4 -fa on -lm dio --fit off --jinja --no-webui --slot-save-path /wx/kv" \
        --job finetune="python weather/finetune.py --init /wx/bundle/weights/afno_event.pt --analyses /wx/gfs-year --stats /wx/bundle --out /wx/ft/box-a --steps 300 --rollout 4 --lr 3e-5"
    resource:
      cpu:
        cores: 12
      memory:
        size: 64GB
      devices:
        nvidia.com/gpu: 1
    network:
      ports:
        - name: forecast
          port: 8001
          protocol: tcp
        - name: llm
          port: 8090
          protocol: tcp
        - name: stack
          port: 8109
          protocol: tcp

  box-b:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:26.02-py3
    mounts:
      /wx:
        volume: wx
    depends-on:
      - name: prep
        status: FINISHED
    script: |
      #!/bin/bash
      export HOME=/wx/home USER="${USER:-wx}" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
      export PYTHONPATH=/wx/pydeps PYTHONUSERBASE=/wx/pyuser
      export LD_LIBRARY_PATH=/wx/llama:${LD_LIBRARY_PATH:-}
      export WX_STACK_REV=4      # the same number as STACK_REV in prep; serve/node_stack.py checks it
      RUN=/tmp/wx-run; mkdir -p $RUN/cache
      export XDG_CACHE_HOME=$RUN/cache TORCHINDUCTOR_CACHE_DIR=$RUN/cache/inductor TRITON_CACHE_DIR=$RUN/cache/triton
      echo "[box-b] host=$(hostname) ip=$(hostname -I) $(date -u +%FT%TZ)"
      nvidia-smi --query-gpu=name,memory.used,utilization.gpu --format=csv,noheader
      cd /wx/repo || exit 1
      exec python serve/node_stack.py --name box-b --admin --port 8110 --log-dir /wx/logs/box-b \
        --serve forecast="python serve/forecast_server.py --node box-b --host 0.0.0.0 --port 8002 --admin --weights /wx/bundle/weights/serving.pt --data /wx/bundle" \
        --serve llm="/wx/llama/llama-server --model /wx/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q4_0.gguf --alias nemotron --host 0.0.0.0 --port 8091 --n-gpu-layers 999 --metrics -c 65536 -np 4 -fa on -lm dio --fit off --jinja --no-webui --slot-save-path /wx/kv" \
        --job finetune="python weather/finetune.py --init /wx/bundle/weights/afno_event.pt --analyses /wx/gfs-year --stats /wx/bundle --out /wx/ft/box-b --steps 300 --rollout 4 --lr 3e-5"
    resource:
      cpu:
        cores: 12
      memory:
        size: 64GB
      devices:
        nvidia.com/gpu: 1
    network:
      ports:
        - name: forecast
          port: 8002
          protocol: tcp
        - name: llm
          port: 8091
          protocol: tcp
        - name: stack
          port: 8110
          protocol: tcp

  router:
    image:
      uri: docker://python:3.12-slim
    mounts:
      /wx:
        volume: wx
    depends-on:
      - name: box-a
        status: RUNNING
      - name: box-b
        status: RUNNING
    script: |
      #!/bin/sh
      set -e
      pip install --quiet --no-cache-dir --disable-pip-version-check fastapi uvicorn httpx pydantic
      for h in box-a box-b; do echo "[router] $h -> $(getent hosts $h || echo unresolved)"; done
      cd /wx/repo
      # The real model needs seconds for a large request (20 members x 5 days: 3.9 s alone, 8.4 s beside a
      # fine-tune), so the per-attempt timeout is well above the default of 5 s.
      # It starts with "balanced": at 15 requests a second on these boxes the rules that use both boxes held
      # p95 near 0.2 s, and adaptive (one active box) queued to 13-15 s. Adaptive is one click away on the
      # page, for the training scene; box-b stays its home box.
      exec python router.py --host 0.0.0.0 --port 8000 --policy balanced --preferred box-b --timeout 30 \
        --backend box-a=http://box-a:8001 --backend box-b=http://box-b:8002
    resource:
      cpu:
        cores: 2
      memory:
        size: 2GB
    network:
      ports:
        - name: http
          port: 8000
          protocol: tcp

  router2:
    image:
      uri: docker://python:3.12-slim
    mounts:
      /wx:
        volume: wx
    depends-on:
      - name: box-a
        status: RUNNING
      - name: box-b
        status: RUNNING
    script: |
      #!/bin/sh
      # The second router (router/router.py, standard library only): one address for both kinds of traffic.
      #   POST /v1/chat/completions   the LLM of either box; a chat stays on one box, the other takes over
      #   POST /v1/ensemble           one forecast split across both boxes
      #   POST /v1/state              a new starting analysis, sent to both boxes
      # The page does not use it yet: its forecasts go through "router" and its chat to box-a's LLM.
      # If this router ends for any reason, the service only waits, so that the rest of the stack stays up.
      cd /tmp
      python /wx/repo/router/router.py --host 0.0.0.0 --port 8100 --policy least_loaded \
        --forecast box-a=http://box-a:8001,box-b=http://box-b:8002 \
        --llm box-a=http://box-a:8090,box-b=http://box-b:8091 --llm-probe llamacpp
      echo "[router2] the second router ended with code $?; this service now only waits"
      exec sleep 86400
    resource:
      cpu:
        cores: 2
      memory:
        size: 1GB
    network:
      ports:
        - name: http
          port: 8100
          protocol: tcp

  ui:
    image:
      uri: docker://python:3.12-slim
    mounts:
      /wx:
        volume: wx
    depends-on:
      - name: router
        status: RUNNING
    script: |
      #!/bin/sh
      set -e
      pip install --quiet --no-cache-dir --disable-pip-version-check fastapi uvicorn httpx pydantic
      cd /wx/repo/ui
      exec python server.py --host 0.0.0.0 --port 8080 --router http://router:8000 \
        --box box-a=http://box-a:8001 --box box-b=http://box-b:8002 \
        --stack box-a=http://box-a:8109 --stack box-b=http://box-b:8110 \
        --llm-base-url http://box-a:8090/v1 --llm-model nemotron --llm-thinking off
    resource:
      cpu:
        cores: 2
      memory:
        size: 2GB
    network:
      ports:
        - name: http
          port: 8080
          protocol: tcp
      endpoints:
        - name: control-room
          port-name: http
          protocol: http
