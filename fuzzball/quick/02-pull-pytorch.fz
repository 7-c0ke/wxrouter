# Pulls the PyTorch image (9.3 GB as Fuzzball reports it: 9,992,933,376 bytes) and checks that PyTorch sees the GPU on each box.
# Ran on the event cluster on Nov 14, 2026 (Fuzzball 4.3.1), in two starts. In the first, the image step finished after 24 min 37 s
# (the download itself was seen to take under 5 minutes), then the workflow ended in an error before its jobs ran. The second
# start, with the image in the cache, finished in 35 s (times from fuzzball workflow describe).
version: v4
jobs:
  pull-1:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:26.02-py3
    script: |
      #!/bin/sh
      echo === $FB_JOB_NAME $(date -u +%FT%TZ)
      nvidia-smi --query-gpu=name,driver_version --format=csv,noheader
      python -c 'import torch; print(torch.__version__, torch.cuda.is_available(), torch.cuda.get_device_name(0))'
      sleep 20
    resource:
      cpu:
        cores: 2
      memory:
        size: 8GB
      devices:
        nvidia.com/gpu: 1
    policy:
      timeout:
        execute: 15m
  pull-2:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:26.02-py3
    script: |
      #!/bin/sh
      echo === $FB_JOB_NAME $(date -u +%FT%TZ)
      nvidia-smi --query-gpu=name,driver_version --format=csv,noheader
      python -c 'import torch; print(torch.__version__, torch.cuda.is_available(), torch.cuda.get_device_name(0))'
      sleep 20
    resource:
      cpu:
        cores: 2
      memory:
        size: 8GB
      devices:
        nvidia.com/gpu: 1
    policy:
      timeout:
        execute: 15m
