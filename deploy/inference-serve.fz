  contract-py: |
    """Shared API contract for the forecast servers (real and mock) and the router.

    Both the real GPU forecast server and the mock MUST accept and return exactly
    these shapes, so the router and load generator never need to know which one
    they are talking to. See API.md for the human-readable version.
    """
    from __future__ import annotations

    from typing import Literal, Optional

    from pydantic import BaseModel, Field

    CONTRACT_VERSION = "1.0"
    MAX_HOURS_AHEAD = 120  # 5 days; most accurate under 72
    MAX_ENSEMBLE_MEMBERS = 20


    # ---------------------------------------------------------------- forecast
    class ForecastRequest(BaseModel):
        lat: float = Field(..., ge=-90, le=90)
        lon: float = Field(..., ge=-180, le=180)
        hours_ahead: int = Field(..., ge=1, le=MAX_HOURS_AHEAD)
        step_hours: int = Field(1, ge=1, le=24, description="Spacing between forecast points")
        ensemble_members: int = Field(1, ge=1, le=MAX_ENSEMBLE_MEMBERS)
        request_id: Optional[str] = Field(None, description="Client-chosen id, echoed back")


    class ForecastPoint(BaseModel):
        lead_hours: int
        valid_time: str  # ISO-8601 UTC
        temp_c: float
        wind_ms: float
        precip_mm: float
        pressure_hpa: float


    class EnsembleMember(BaseModel):
        member: int
        points: list[ForecastPoint]


    class Timing(BaseModel):
        queue_ms: float  # waiting for a GPU slot
        compute_ms: float  # model run
        total_ms: float  # server-side wall time


    class ForecastResponse(BaseModel):
        request_id: Optional[str]
        box: str  # which box produced it, e.g. "box-a"
        model_version: str
        contract_version: str = CONTRACT_VERSION
        issued_at: str  # ISO-8601 UTC
        lat: float
        lon: float
        hours_ahead: int
        step_hours: int
        low_confidence: bool  # true when hours_ahead > 72
        forecast: list[ForecastPoint]  # ensemble mean when members > 1
        members: Optional[list[EnsembleMember]] = None
        timing: Timing


    # ---------------------------------------------------------------- health/stats
    class Health(BaseModel):
        status: Literal["ok", "degraded", "down"]
        box: str
        model_version: str
        contract_version: str = CONTRACT_VERSION
        uptime_s: float


    class Stats(BaseModel):
        box: str
        in_flight: int  # requests currently on the GPU
        queue_depth: int  # requests waiting for a GPU slot
        max_concurrency: int
        gpu_util: float  # 0..1
        ewma_latency_ms: float  # server-side total_ms, smoothed
        p50_latency_ms: float  # over the last ~200 requests
        p95_latency_ms: float
        requests_total: int
        errors_total: int
        mode: str  # mock only: normal | slow | error | hang ; real server: "normal" or "training"
  router-py: |
    """Forecast router: one address in front of box A and box B.

    Policies (switch at runtime with POST /router/config):
      static        always the first backend (box A); the other only on failure
      round_robin   take turns
      least_loaded  fewest requests in flight (router's own count + box queue_depth)
      adaptive      stay on one box; switch only when the other box has been clearly
                    better (by `margin`) for `window_s` seconds, then don't switch
                    again for `cooldown_s` seconds. A dead active box switches at once.
                    With `preferred` set, traffic starts on that box and goes back to
                    it once it is healthy and within `return_margin` of the active
                    box for `window_s` seconds (cooldown still applies).

    Every policy fails over: if a box refuses the connection, times out or returns
    5xx, the request is retried once on the other box. Forecasts are read-only, so
    sending one twice is safe.

    Run:
      python router.py --backend box-a=http://127.0.0.1:8001 \
                       --backend box-b=http://127.0.0.1:8002 --policy adaptive
    """
    from __future__ import annotations

    import argparse
    import asyncio
    import itertools
    import random
    import time
    from contextlib import asynccontextmanager
    from typing import Optional

    import httpx
    import uvicorn
    from fastapi import FastAPI, Request, Response
    from fastapi.responses import JSONResponse
    from pydantic import BaseModel, Field

    POLICIES = ("static", "round_robin", "least_loaded", "adaptive")
    PROBE_BODY = {"lat": 0.0, "lon": 0.0, "hours_ahead": 12, "step_hours": 6, "request_id": "router-probe"}


    class Backend:
        def __init__(self, name: str, url: str):
            self.name, self.url = name, url.rstrip("/")
            self.healthy = True
            self.fail_streak = 0
            self.ok_streak = 0
            self.in_flight = 0  # requests this router has outstanding on the box
            self.queue_depth = 0  # from the box's /stats
            self.max_concurrency = 1
            self.gpu_util = 0.0
            self.probe_ms: Optional[float] = None  # EWMA of the probe's GPU compute time
            self.probe_started: Optional[float] = None  # set while a probe is outstanding
            self.served = 0
            self.failures = 0

        def score(self, now: float, stall_ms: float) -> Optional[float]:
            """Adaptive's view of how fast this box is. A probe stuck longer than
            `stall_ms` (queued behind a backlog, or hanging) counts as that slow."""
            if self.probe_started is not None:
                waited = (now - self.probe_started) * 1000
                if waited > stall_ms:
                    return max(self.probe_ms or 0.0, waited)
            return self.probe_ms

        def load(self) -> float:
            return (self.in_flight + self.queue_depth) / max(1, self.max_concurrency)

        def view(self) -> dict:
            return {
                "url": self.url, "healthy": self.healthy, "in_flight": self.in_flight,
                "queue_depth": self.queue_depth, "gpu_util": self.gpu_util,
                "probe_ms": None if self.probe_ms is None else round(self.probe_ms, 1),
                "served": self.served, "failures": self.failures,
            }


    class AdaptiveConfig(BaseModel):
        margin: float = Field(0.25, ge=0, le=0.95, description="other box must be this much faster (0.25 = 25%)")
        window_s: float = Field(1.0, ge=0, description="...for this long without a break")
        cooldown_s: float = Field(10.0, ge=0, description="minimum time between switches")
        preferred: Optional[str] = Field(None, description="home box; traffic returns here when it recovers")
        return_margin: float = Field(0.20, ge=0, le=1.0,
                                     description="go home once preferred is no more than this much slower (0.20 = 20%)")


    class ConfigUpdate(BaseModel):
        policy: Optional[str] = Field(None, pattern="^(static|round_robin|least_loaded|adaptive)$")
        margin: Optional[float] = None
        window_s: Optional[float] = None
        cooldown_s: Optional[float] = None
        preferred: Optional[str] = None  # "" clears it
        return_margin: Optional[float] = None


    class Router:
        def __init__(self, backends: list[Backend], policy: str, adaptive: AdaptiveConfig,
                     timeout_s: float, poll_s: float, probe_s: float, down_after: int, up_after: int,
                     stall_ms: float = 1000.0):
            self.backends = backends
            self.by_name = {b.name: b for b in backends}
            self.policy = policy
            self.adaptive = adaptive
            self.timeout_s, self.poll_s, self.probe_s = timeout_s, poll_s, probe_s
            self.down_after, self.up_after = down_after, up_after
            self.stall_ms = stall_ms
            self.rr = itertools.count()
            self.rng = random.Random(0)
            self.started = time.monotonic()
            self.failovers = 0
            self.reset_adaptive()
            self.client: httpx.AsyncClient | None = None

        def reset_adaptive(self) -> None:
            self.active = self.by_name.get(self.adaptive.preferred or "", self.backends[0])
            self.better_since: Optional[float] = None
            self.last_switch = -1e9
            self.switches: list[dict] = []

        # ------------------------------------------------------------ health
        def mark(self, b: Backend, ok: bool, hard: bool = False) -> None:
            """Update health with hysteresis. `hard` = connection refused: down at once."""
            if ok:
                b.fail_streak, b.ok_streak = 0, b.ok_streak + 1
                if not b.healthy and b.ok_streak >= self.up_after:
                    b.healthy = True
            else:
                b.ok_streak, b.fail_streak = 0, b.fail_streak + 1
                if hard or b.fail_streak >= self.down_after:
                    if b.healthy:
                        b.probe_ms = None  # stale once down; re-measure after it rejoins
                    b.healthy = False

        async def poll_loop(self) -> None:
            while True:
                await asyncio.gather(*(self.poll_one(b) for b in self.backends))
                await asyncio.sleep(self.poll_s)

        async def poll_one(self, b: Backend) -> None:
            try:
                h, s = await asyncio.gather(
                    self.client.get(f"{b.url}/health", timeout=0.5),
                    self.client.get(f"{b.url}/stats", timeout=0.5),
                )
                self.mark(b, h.status_code == 200)
                if s.status_code == 200:
                    st = s.json()
                    b.queue_depth = st["queue_depth"]
                    b.max_concurrency = st["max_concurrency"]
                    b.gpu_util = st["gpu_util"]
            except httpx.HTTPError:
                self.mark(b, False)

        async def probe_loop(self) -> None:
            """Send the same tiny forecast to every box, so adaptive can compare
            boxes even when one of them is getting no real traffic."""
            while True:
                # Fire probes without waiting for them: a box with a deep queue must
                # not hold up decisions about the other one.
                for b in self.backends:
                    if b.probe_started is None:
                        asyncio.create_task(self.probe_one(b))
                self.decide_adaptive()
                await asyncio.sleep(self.probe_s)

        async def probe_one(self, b: Backend) -> None:
            if not b.healthy:
                return
            t0 = time.perf_counter()
            b.probe_started = time.monotonic()
            try:
                r = await self.client.post(f"{b.url}/v1/forecast", json=PROBE_BODY, timeout=self.timeout_s)
                if r.status_code != 200:
                    # 503 = queue full / overloaded: as bad as a timeout.
                    r_ms = self.timeout_s * 1000
                    b.probe_ms = r_ms if b.probe_ms is None else 0.7 * b.probe_ms + 0.3 * r_ms
                    return
                # Use the box's own GPU compute time, not round-trip time. Round trip
                # includes queueing behind our own traffic, so the busy active box
                # would always look worse than the idle one and adaptive would flap.
                # Compute time rises only when the GPU itself is slower (training).
                ms = r.json().get("timing", {}).get("compute_ms") or (time.perf_counter() - t0) * 1000
            except httpx.TimeoutException:
                ms = self.timeout_s * 1000  # a hanging box scores as badly as possible
            except httpx.HTTPError:
                return
            finally:
                b.probe_started = None
            b.probe_ms = ms if b.probe_ms is None else 0.7 * b.probe_ms + 0.3 * ms

        def decide_adaptive(self) -> None:
            now = time.monotonic()
            cur = self.active
            others = [b for b in self.backends if b is not cur and b.healthy]
            if not others:
                self.better_since = None
                return
            if not cur.healthy:  # failover: no hysteresis
                self.switch(others[0], now, "active box down")
                return
            sc = {b.name: b.score(now, self.stall_ms) for b in self.backends}
            pref = self.by_name.get(self.adaptive.preferred or "")
            if pref is not None and pref is not cur and pref.healthy:
                # Away from home: go back once home is about as good as where we are.
                target = pref
                if sc[cur.name] is None or sc[pref.name] is None:
                    return
                wants = sc[pref.name] <= sc[cur.name] * (1 + self.adaptive.return_margin)
                reason = f"back to preferred {pref.name} ({sc[pref.name]:.0f}ms vs {sc[cur.name]:.0f}ms)"
            else:
                target = min(others, key=lambda b: sc[b.name] if sc[b.name] is not None else float("inf"))
                if sc[cur.name] is None or sc[target.name] is None:
                    return
                wants = sc[target.name] < sc[cur.name] * (1 - self.adaptive.margin)
                reason = f"{target.name} {sc[target.name]:.0f}ms vs {cur.name} {sc[cur.name]:.0f}ms"
            if wants:
                if self.better_since is None:
                    self.better_since = now
                elif (now - self.better_since >= self.adaptive.window_s
                      and now - self.last_switch >= self.adaptive.cooldown_s):
                    self.switch(target, now, reason)
            else:
                self.better_since = None

        def switch(self, to: Backend, now: float, reason: str) -> None:
            self.switches.append({"t": round(now - self.started, 2), "from": self.active.name,
                                  "to": to.name, "reason": reason})
            self.active, self.last_switch, self.better_since = to, now, None

        # ------------------------------------------------------------ routing
        def order(self) -> list[Backend]:
            """Backends in the order to try them. Healthy ones first."""
            bs = self.backends
            if self.policy == "static":
                ranked = list(bs)
            elif self.policy == "round_robin":
                healthy = [b for b in bs if b.healthy] or bs
                first = healthy[next(self.rr) % len(healthy)]
                ranked = [first] + [b for b in bs if b is not first]
            elif self.policy == "least_loaded":
                ranked = sorted(bs, key=lambda b: (b.load(), self.rng.random()))
            else:  # adaptive
                ranked = [self.active] + [b for b in bs if b is not self.active]
            return sorted(ranked, key=lambda b: not b.healthy)  # stable: keeps policy order

        async def forward(self, body: bytes) -> Response:
            tried: list[str] = []
            last_error = "no backends"
            for b in self.order():
                tried.append(b.name)
                b.in_flight += 1
                try:
                    r = await self.client.post(
                        f"{b.url}/v1/forecast", content=body,
                        headers={"content-type": "application/json"}, timeout=self.timeout_s)
                except httpx.ConnectError as e:
                    b.failures += 1
                    self.mark(b, False, hard=True)
                    last_error = f"{b.name}: connect failed ({e.__class__.__name__})"
                    continue
                except httpx.HTTPError as e:
                    b.failures += 1
                    self.mark(b, False)
                    last_error = f"{b.name}: {e.__class__.__name__}"
                    continue
                finally:
                    b.in_flight -= 1

                if r.status_code >= 500:
                    b.failures += 1
                    self.mark(b, False)
                    last_error = f"{b.name}: HTTP {r.status_code}"
                    continue
                # 2xx and 4xx (bad input) go straight back to the client.
                b.served += r.status_code < 400
                if len(tried) > 1:
                    self.failovers += 1
                return Response(content=r.content, status_code=r.status_code,
                                media_type="application/json", headers=self.headers(b, tried))
            return JSONResponse({"detail": f"all backends failed; last: {last_error}"},
                                status_code=503, headers=self.headers(None, tried))

        def headers(self, b: Optional[Backend], tried: list[str]) -> dict:
            return {
                "X-Served-By": b.name if b else "none",
                "X-Router-Policy": self.policy,
                "X-Router-Attempts": str(len(tried)),
                "X-Router-Failover": "true" if len(tried) > 1 else "false",
            }

        def status(self) -> dict:
            return {
                "policy": self.policy,
                "adaptive": {**self.adaptive.model_dump(), "active": self.active.name,
                             "switches": self.switches},
                "failovers": self.failovers,
                "backends": {b.name: b.view() for b in self.backends},
            }


    def create_app(router: Router) -> FastAPI:
        @asynccontextmanager
        async def lifespan(app: FastAPI):
            limits = httpx.Limits(max_connections=1000, max_keepalive_connections=200)
            router.client = httpx.AsyncClient(limits=limits)
            tasks = [asyncio.create_task(router.poll_loop()), asyncio.create_task(router.probe_loop())]
            yield
            for t in tasks:
                t.cancel()
            await router.client.aclose()

        app = FastAPI(title="forecast router", lifespan=lifespan)

        @app.post("/v1/forecast")
        async def forecast(request: Request):
            return await router.forward(await request.body())

        @app.get("/health")
        async def health():
            up = [b.name for b in router.backends if b.healthy]
            return JSONResponse({"status": "ok" if up else "down", "healthy_backends": up},
                                status_code=200 if up else 503)

        @app.get("/router/status")
        async def status():
            return router.status()

        @app.post("/router/config")
        async def config(u: ConfigUpdate):
            if u.policy and u.policy != router.policy:
                router.policy = u.policy
                router.reset_adaptive()
            for k in ("margin", "window_s", "cooldown_s", "return_margin"):
                if getattr(u, k) is not None:
                    setattr(router.adaptive, k, getattr(u, k))
            if u.preferred is not None:
                if u.preferred and u.preferred not in router.by_name:
                    return JSONResponse({"detail": f"unknown backend {u.preferred!r}"}, status_code=422)
                router.adaptive.preferred = u.preferred or None
            return router.status()

        return app


    def parse_backend(s: str) -> Backend:
        name, _, url = s.partition("=")
        if not url:
            raise argparse.ArgumentTypeError("use NAME=URL, e.g. box-a=http://127.0.0.1:8001")
        return Backend(name, url)


    def main() -> None:
        ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
        ap.add_argument("--backend", type=parse_backend, action="append", required=True,
                        help="NAME=URL; repeat. The first one is 'box A' for the static policy.")
        ap.add_argument("--policy", choices=POLICIES, default="adaptive")
        ap.add_argument("--host", default="127.0.0.1")
        ap.add_argument("--port", type=int, default=8000)
        ap.add_argument("--timeout", type=float, default=5.0, help="per-attempt timeout (s) before failing over")
        ap.add_argument("--poll", type=float, default=0.25, help="health/stats poll interval (s)")
        ap.add_argument("--probe", type=float, default=0.5, help="adaptive probe interval (s)")
        ap.add_argument("--stall-ms", type=float, default=1000.0,
                        help="a probe outstanding longer than this counts as a slow box")
        ap.add_argument("--down-after", type=int, default=2, help="failed checks before a box is marked down")
        ap.add_argument("--up-after", type=int, default=2, help="good checks before a box rejoins")
        ap.add_argument("--margin", type=float, default=0.25)
        ap.add_argument("--window", type=float, default=1.0)
        ap.add_argument("--cooldown", type=float, default=10.0)
        ap.add_argument("--preferred", default=None, help="adaptive home box, e.g. box-b")
        ap.add_argument("--return-margin", type=float, default=0.20)
        a = ap.parse_args()
        if a.preferred and a.preferred not in {b.name for b in a.backend}:
            ap.error(f"--preferred {a.preferred!r} is not one of the --backend names")
        r = Router(a.backend, a.policy,
                   AdaptiveConfig(margin=a.margin, window_s=a.window, cooldown_s=a.cooldown,
                                  preferred=a.preferred, return_margin=a.return_margin),
                   a.timeout, a.poll, a.probe, a.down_after, a.up_after, a.stall_ms)
        uvicorn.run(create_app(r), host=a.host, port=a.port, log_level="warning")


    if __name__ == "__main__":
        main()
  inference-init-py: |
    """GPU inference subsystem for wxrouter.

      model.py     tiny autoregressive forecast net; weights + numpy/torch backends
      engine.py    batching, concurrency, warm-up, timeouts, retries
      metrics.py   p50/p95/p99, throughput, error rate, JSON snapshot for the router
      gpu.py       GPU utilisation and memory (nvidia-smi / torch)
      forecast.py  contract.ForecastRequest <-> model rows
      server.py    real forecast server implementing API.md (drop-in for mock_server.py)
      bench.py     cold/warm, batch and concurrency benchmark -> JSON

    Run from the repo root: `python -m inference.server`, `python -m inference.bench`.
    """
    from .config import EngineConfig
    from .engine import InferenceEngine, InferenceError, InferenceTimeout, Overloaded

    __all__ = ["EngineConfig", "InferenceEngine", "InferenceError", "InferenceTimeout", "Overloaded"]
  inference-bench-py: |
    """Benchmark the inference engine and write machine-readable JSON.

      python -m inference.bench                 # full run, results/inference/<timestamp>/
      python -m inference.bench --quick         # a few seconds; used by the Fuzzball smoke test
      python -m inference.bench --require-gpu   # exit 2 instead of falling back to CPU

    What it measures:
      cold_start   import, model load, first inference, then warm inference
      batch_sweep  one direct GPU call per batch size: latency and rows/s
      serving      the async engine under N concurrent clients, with batching off
                   (baseline, max_batch_rows=1) and on (optimized), same requests
      precision    fp32 vs fp16 autocast (CUDA only)

    Nothing here is simulated. Every number is a wall-clock measurement on the
    device named in `environment`.
    """
    from __future__ import annotations

    import argparse
    import asyncio
    import json
    import platform
    import sys
    import time
    from dataclasses import replace
    from datetime import UTC, datetime
    from pathlib import Path

    import numpy as np

    from .config import EngineConfig, add_engine_args, engine_config_from_args
    from .engine import InferenceEngine, InferenceError, InferenceTimeout, Overloaded
    from .forecast import build_rows, issue_time
    from .gpu import query_smi
    from .metrics import latency_summary, log_event, setup_logging
    from .model import MODEL_VERSION

    BENCH_SCHEMA = "wxrouter.inference.bench/v1"
    BEGIN, END = "===WXROUTER_BENCH_JSON_BEGIN===", "===WXROUTER_BENCH_JSON_END==="


    def rows_for(n: int, seed: int = 0) -> np.ndarray:
        """n single-member requests at seeded random locations."""
        rng = np.random.default_rng(seed)
        issued = issue_time()
        return np.concatenate([build_rows(float(rng.uniform(-60, 60)), float(rng.uniform(-180, 180)), 1, issued)
                               for _ in range(n)])


    def environment(engine: InferenceEngine, import_ms: float | None) -> dict:
        b = engine.backend
        env = {"python": platform.python_version(), "platform": platform.platform(), "machine": platform.machine(),
               "backend": b.name, "device": b.device, "device_name": b.device_name, "precision": b.precision,
               "model_version": MODEL_VERSION, "hidden": engine.cfg.hidden, "layers": engine.cfg.layers,
               "numpy": np.__version__, "torch_import_ms": import_ms, "nvidia_smi": query_smi() or None}
        if b.name == "torch":
            env["torch"] = b.torch.__version__
            env["cuda_available"] = b.torch.cuda.is_available()
            env["torch_threads"] = b.torch.get_num_threads()
        return env


    def time_import(backend: str) -> float | None:
        if backend == "numpy":
            return None
        t0 = time.perf_counter()
        try:
            import torch  # noqa: F401
        except ImportError:
            return None
        return round((time.perf_counter() - t0) * 1000, 1)


    def batch_sweep(engine: InferenceEngine, sizes: list[int], hours: int, iters: int) -> list[dict]:
        out = []
        for n in sizes:
            x = rows_for(n)
            engine.infer_sync(x, hours)  # settle allocator for this shape
            engine.backend.reset_peak_memory()
            ms = []
            for _ in range(iters):
                t = time.perf_counter()
                engine.infer_sync(x, hours)
                ms.append((time.perf_counter() - t) * 1000)
            mean = sum(ms) / len(ms)
            out.append({"batch_rows": n, "hours_ahead": hours, "iterations": iters, "latency_ms": latency_summary(ms),
                        "rows_per_s": round(n / mean * 1000, 1), "ms_per_row": round(mean / n, 4),
                        "gpu_memory": engine.backend.memory()})
            log_event("bench_batch", **{k: v for k, v in out[-1].items() if k != "gpu_memory"})
        return out


    async def serve_once(cfg: EngineConfig, backend, clients: int, requests: int, hours: int, label: str) -> dict:
        """`clients` closed-loop clients send `requests` single-member forecasts through the engine."""
        engine = InferenceEngine(cfg, backend=backend)
        engine.ready = True  # backend is already warm
        await engine.start()
        xs = rows_for(requests, seed=1)
        lat_ms, errors = [], 0
        todo = iter(range(requests))

        async def client() -> None:
            nonlocal errors
            for i in todo:
                t = time.perf_counter()
                try:
                    await engine.infer(xs[i:i + 1], hours)
                    lat_ms.append((time.perf_counter() - t) * 1000)
                except (Overloaded, InferenceTimeout, InferenceError):
                    errors += 1

        backend.reset_peak_memory()
        t0 = time.perf_counter()
        await asyncio.gather(*(client() for _ in range(clients)))
        wall = time.perf_counter() - t0
        snap = engine.snapshot()
        await engine.stop()
        row = {"mode": label, "clients": clients, "requests": requests, "hours_ahead": hours,
               "max_batch_rows": cfg.max_batch_rows, "engine_concurrency": cfg.concurrency,
               "latency_ms": latency_summary(lat_ms), "requests_per_s": round(len(lat_ms) / wall, 1),
               "errors": errors, "error_rate": round(errors / requests, 5),
               "mean_batch_rows": snap["batches"]["mean_rows"], "gpu_memory": snap["gpu_memory"]}
        log_event("bench_serving", **{k: v for k, v in row.items() if k != "gpu_memory"})
        return row


    async def serving_sweep(cfg: EngineConfig, backend, clients: list[int], requests: int, hours: int) -> list[dict]:
        out = []
        for c in clients:
            out.append(await serve_once(replace(cfg, max_batch_rows=1), backend, c, requests, hours, "baseline"))
            out.append(await serve_once(cfg, backend, c, requests, hours, "batched"))
        return out


    def precision_compare(cfg: EngineConfig, rows: int, hours: int, iters: int) -> list[dict]:
        out = []
        for amp in (False, True):
            eng = InferenceEngine(replace(cfg, amp=amp))
            eng.load()
            r = batch_sweep(eng, [rows], hours, iters)[0]
            out.append({"precision": eng.backend.precision, **r})
        return out


    def markdown(res: dict) -> str:
        env, cold = res["environment"], res["cold_start"]
        lines = [f"# Inference benchmark, {res['created_at']}", "",
                 (f"Device: **{env['device_name']}** ({env['backend']}, {env['precision']}), "
                 f"model `{env['model_version']}` hidden={env['hidden']} layers={env['layers']}"), "",
                 "## Cold start", "", "| torch import ms | model load ms | first inference ms | warm inference ms |",
                 "|---:|---:|---:|---:|",
                 f"| {env['torch_import_ms']} | {cold['load_ms']} | {cold['first_inference_ms']} | {cold['warm_inference_ms']} |",
                 "", f"## One GPU call per batch ({res['params']['hours_ahead']} h forecast)", "",
                 "| batch rows | p50 ms | p95 ms | p99 ms | rows/s | ms/row | peak GPU MB |", "|---:|---:|---:|---:|---:|---:|---:|"]
        for r in res["batch_sweep"]:
            l = r["latency_ms"]
            lines.append(f"| {r['batch_rows']} | {l['p50']:.2f} | {l['p95']:.2f} | {l['p99']:.2f} | {r['rows_per_s']} | "
                         f"{r['ms_per_row']} | {r['gpu_memory'].get('peak_allocated_mb', '')} |")
        lines += ["", "## Serving: baseline (no batching) vs batched", "",
                  "| clients | mode | p50 ms | p95 ms | p99 ms | req/s | mean batch | errors |", "|---:|---|---:|---:|---:|---:|---:|---:|"]
        for r in res["serving"]:
            l = r["latency_ms"]
            lines.append(f"| {r['clients']} | {r['mode']} | {l['p50']:.2f} | {l['p95']:.2f} | {l['p99']:.2f} | "
                         f"{r['requests_per_s']} | {r['mean_batch_rows']} | {r['errors']} |")
        if res.get("precision"):
            lines += ["", "## Precision", "", "| precision | batch rows | p50 ms | rows/s |", "|---|---:|---:|---:|"]
            lines += [f"| {r['precision']} | {r['batch_rows']} | {r['latency_ms']['p50']:.2f} | {r['rows_per_s']} |"
                      for r in res["precision"]]
        return "\n".join(lines) + "\n"


    def ints(s: str) -> list[int]:
        return [int(v) for v in s.split(",") if v]


    def run(a: argparse.Namespace) -> dict:
        import_ms = time_import(a.backend)
        cfg = engine_config_from_args(a)
        engine = InferenceEngine(cfg)
        engine.load()
        x1 = rows_for(1)
        warm = []
        for _ in range(20):
            t = time.perf_counter()
            engine.infer_sync(x1, 12)
            warm.append((time.perf_counter() - t) * 1000)
        cold = {**engine.cold_start, "warm_inference_ms": round(sorted(warm)[len(warm) // 2], 3),
                "note": "first_inference_ms and warm_inference_ms are one 12 h, 1-row forecast"}
        res = {
            "schema": BENCH_SCHEMA,
            "created_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "environment": environment(engine, import_ms),
            "params": {"hours_ahead": a.hours, "batch_sizes": a.batch_sizes, "clients": a.clients,
                       "requests": a.requests, "iterations": a.iterations, "quick": a.quick},
            "cold_start": cold,
            "batch_sweep": batch_sweep(engine, a.batch_sizes, a.hours, a.iterations),
            "serving": asyncio.run(serving_sweep(cfg, engine.backend, a.clients, a.requests, a.hours)),
            "precision": (precision_compare(cfg, max(a.batch_sizes), a.hours, a.iterations)
                          if engine.backend.device == "cuda" else []),
        }
        return res


    def main() -> None:
        ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
        ap.add_argument("--out", default="results/inference", help="a <timestamp>/ folder is created inside")
        ap.add_argument("--hours", type=int, default=48, help="forecast length used for every request")
        ap.add_argument("--batch-sizes", type=ints, default=[1, 4, 16, 64, 256])
        ap.add_argument("--clients", type=ints, default=[1, 8, 32], help="concurrent client counts")
        ap.add_argument("--requests", type=int, default=400, help="requests per serving run")
        ap.add_argument("--iterations", type=int, default=30, help="GPU calls per batch size")
        ap.add_argument("--quick", action="store_true", help="small smoke run")
        ap.add_argument("--emit-markers", action="store_true",
                        help="also print the JSON on stdout between marker lines, for scraping job logs")
        ap.add_argument("--log-level", default="INFO")
        add_engine_args(ap)
        a = ap.parse_args()
        if a.quick:
            a.batch_sizes, a.clients, a.requests, a.iterations = [1, 16, 64], [1, 16], 64, 5
        setup_logging(a.log_level)
        try:
            res = run(a)
        except RuntimeError as e:
            if "GPU required" not in str(e):
                raise
            log_event("bench_no_gpu", error=str(e))
            print(f"FAILED: {e}", file=sys.stderr)
            sys.exit(2)
        out = Path(a.out) / datetime.now().strftime("%Y%m%d-%H%M%S")
        out.mkdir(parents=True, exist_ok=True)
        (out / "bench.json").write_text(json.dumps(res, indent=2))
        (out / "table.md").write_text(markdown(res))
        print(markdown(res))
        print(f"wrote {out}/bench.json and table.md")
        if a.emit_markers:
            print(BEGIN)
            print(json.dumps(res))
            print(END)


    if __name__ == "__main__":
        main()
  inference-config-py: |
    """Engine settings. Every field is also a CLI flag on the server and the bench."""
    from __future__ import annotations

    import argparse
    from dataclasses import dataclass, fields


    @dataclass
    class EngineConfig:
        box: str = "box-a"
        device: str = "auto"  # auto (cuda, else cpu) | cuda | mps | cpu
        backend: str = "auto"  # auto (torch if installed, else numpy) | torch | numpy
        hidden: int = 256  # model width
        layers: int = 4  # residual blocks per forecast hour
        seed: int = 0  # weight seed; both boxes must use the same one
        amp: bool = True  # fp16 autocast on CUDA
        max_batch_rows: int = 64  # rows (request x ensemble member) per GPU call; 1 disables batching
        max_wait_ms: float = 0.0  # extra wait to fill a batch; 0 = only batch what is already queued
        concurrency: int = 1  # GPU calls running at once
        max_queue: int = 256  # waiting requests before 503
        timeout_s: float = 10.0  # per GPU call
        retries: int = 1  # retries after a failed GPU call (not after a timeout)
        retry_backoff_ms: float = 20.0
        warmup_runs: int = 3
        require_gpu: bool = False  # fail at load instead of falling back to CPU


    def add_engine_args(ap: argparse.ArgumentParser) -> None:
        for f in fields(EngineConfig):
            flag = "--" + f.name.replace("_", "-")
            if f.type == "bool":
                ap.add_argument(flag, action=argparse.BooleanOptionalAction, default=f.default)
            else:
                ap.add_argument(flag, type=type(f.default), default=f.default)


    def engine_config_from_args(a: argparse.Namespace) -> EngineConfig:
        return EngineConfig(**{f.name: getattr(a, f.name) for f in fields(EngineConfig)})
  inference-engine-py: |
    """Inference engine: loads the model, batches requests, runs them on the GPU.

    Requests wait in a queue. Each of `concurrency` workers takes whatever is queued
    (up to `max_batch_rows` rows), runs it as one GPU call on a thread, and hands
    each request its slice. So batches form by themselves under load and a lone
    request is never delayed, unless `max_wait_ms` is set.

    A GPU call that raises is retried `retries` times. One that exceeds `timeout_s`
    is not retried: its thread is still busy, so the caller gets InferenceTimeout
    (503 from the server) and the router fails over to the other box.
    """
    from __future__ import annotations

    import asyncio
    import logging
    import time
    from concurrent.futures import ThreadPoolExecutor
    from dataclasses import asdict, dataclass

    import numpy as np

    from .config import EngineConfig
    from .gpu import GpuMonitor
    from .metrics import METRICS_SCHEMA, MetricsRecorder, log_event
    from .model import FEATURES, MODEL_VERSION, make_backend


    class Overloaded(Exception):
        """Queue full or engine not ready. Maps to 503."""


    class InferenceTimeout(Exception):
        """GPU call exceeded timeout_s. Maps to 503."""


    class InferenceError(Exception):
        """GPU call failed after all retries. Maps to 500."""


    @dataclass
    class _Job:
        x: np.ndarray  # (rows, FEATURES)
        steps: int
        future: asyncio.Future
        enqueued: float


    class InferenceEngine:
        def __init__(self, cfg: EngineConfig | None = None, backend=None):
            self.cfg = cfg or EngineConfig()
            self.backend = backend  # tests inject fakes here
            self.metrics = MetricsRecorder()
            self.gpu = GpuMonitor()
            self.ready = False
            self.load_error: str | None = None
            self.cold_start: dict = {}
            self.in_flight = 0  # requests inside a GPU call
            self.started = time.monotonic()
            self._queue: asyncio.Queue[_Job] | None = None
            self._workers: list[asyncio.Task] = []
            self._pool: ThreadPoolExecutor | None = None

        # ------------------------------------------------------------ load
        def load(self) -> None:
            """Build the backend and warm it up. Blocking; safe to call from a thread."""
            t0 = time.perf_counter()
            if self.backend is None:
                self.backend = make_backend(self.cfg)
            load_ms = (time.perf_counter() - t0) * 1000
            x = np.zeros((1, FEATURES), np.float32)
            warm = []
            for _ in range(max(1, self.cfg.warmup_runs)):
                t = time.perf_counter()
                self.backend.rollout(x, 12)
                warm.append(round((time.perf_counter() - t) * 1000, 3))
            self.backend.reset_peak_memory()
            self.cold_start = {"load_ms": round(load_ms, 3), "first_inference_ms": warm[0],
                               "warmup_ms": warm, "ready_ms": round((time.perf_counter() - t0) * 1000, 3)}
            self.ready = True
            log_event("engine_ready", box=self.cfg.box, backend=self.backend.name, device=self.backend.device,
                      device_name=self.backend.device_name, precision=self.backend.precision, **self.cold_start)

        async def start(self) -> None:
            self._queue = asyncio.Queue()
            self._pool = ThreadPoolExecutor(self.cfg.concurrency + 1, thread_name_prefix="gpu")
            try:
                if not self.ready:
                    await asyncio.get_running_loop().run_in_executor(self._pool, self.load)
            except Exception as e:
                self.load_error = f"{type(e).__name__}: {e}"
                log_event("engine_load_failed", logging.ERROR, box=self.cfg.box, error=self.load_error)
                raise
            self.gpu.start()
            self._workers = [asyncio.create_task(self._worker()) for _ in range(self.cfg.concurrency)]

        async def stop(self) -> None:
            self.ready = False
            for w in self._workers:
                w.cancel()
            await asyncio.gather(*self._workers, return_exceptions=True)
            self._workers = []
            self.gpu.stop()
            if self._pool:
                self._pool.shutdown(wait=False, cancel_futures=True)

        # ------------------------------------------------------------ inference
        def infer_sync(self, x: np.ndarray, steps: int) -> np.ndarray:
            """One direct GPU call, no queue. For offline batch jobs and the bench."""
            return self.backend.rollout(np.ascontiguousarray(x, np.float32), steps)

        async def infer(self, x: np.ndarray, steps: int) -> tuple[np.ndarray, dict]:
            """Queue `x` (rows, FEATURES) for a `steps`-hour rollout.

            Returns (y, timing): y is (rows, steps, OUTPUTS); timing has queue_ms and compute_ms.
            """
            if not self.ready or self._queue is None:
                self.metrics.error("rejected")
                raise Overloaded("engine not ready")
            if self._queue.qsize() >= self.cfg.max_queue:
                self.metrics.error("rejected")
                raise Overloaded("queue full")
            job = _Job(np.ascontiguousarray(x, np.float32), steps,
                       asyncio.get_running_loop().create_future(), time.perf_counter())
            self._queue.put_nowait(job)
            return await job.future

        async def _worker(self) -> None:
            cfg, queue = self.cfg, self._queue
            carry: _Job | None = None
            while True:
                batch = [carry or await queue.get()]
                carry = None
                rows = len(batch[0].x)
                deadline = time.perf_counter() + cfg.max_wait_ms / 1000
                while rows < cfg.max_batch_rows:
                    wait = deadline - time.perf_counter()
                    try:
                        nxt = queue.get_nowait() if wait <= 0 else await asyncio.wait_for(queue.get(), wait)
                    except (TimeoutError, asyncio.QueueEmpty):
                        break
                    if rows + len(nxt.x) > cfg.max_batch_rows:
                        carry = nxt  # starts the next batch
                        break
                    batch.append(nxt)
                    rows += len(nxt.x)
                batch = [j for j in batch if not j.future.done()]  # drop requests whose client left
                if batch:
                    await self._run_batch(batch)

        async def _run_batch(self, batch: list[_Job]) -> None:
            cfg, loop = self.cfg, asyncio.get_running_loop()
            steps = max(j.steps for j in batch)
            x = np.concatenate([j.x for j in batch]) if len(batch) > 1 else batch[0].x
            started = time.perf_counter()
            self.in_flight += len(batch)
            self.metrics.batch(len(batch), len(x))
            y, err, kind = None, None, "error"
            try:
                for attempt in range(cfg.retries + 1):
                    try:
                        y = await asyncio.wait_for(
                            loop.run_in_executor(self._pool, self.backend.rollout, x, steps), cfg.timeout_s)
                        break
                    except TimeoutError:
                        err, kind = InferenceTimeout(f"GPU call exceeded {cfg.timeout_s}s"), "timeout"
                        log_event("inference_timeout", logging.ERROR, box=cfg.box, rows=len(x), steps=steps)
                        break
                    except Exception as e:  # noqa: BLE001 - any backend failure is retryable
                        err = InferenceError(f"{type(e).__name__}: {e}")
                        log_event("inference_failed", logging.WARNING, box=cfg.box, rows=len(x), steps=steps,
                                  attempt=attempt + 1, error=str(err))
                        if attempt < cfg.retries:
                            self.metrics.retries += 1
                            await asyncio.sleep(cfg.retry_backoff_ms / 1000 * (attempt + 1))
            finally:
                self.in_flight -= len(batch)
            done = time.perf_counter()
            compute_ms = (done - started) * 1000
            offset = 0
            for j in batch:
                n = len(j.x)
                if y is None:
                    self.metrics.error(kind)
                    if not j.future.done():
                        j.future.set_exception(err)
                else:
                    queue_ms = (started - j.enqueued) * 1000
                    self.metrics.ok(queue_ms, compute_ms, (done - j.enqueued) * 1000, n)
                    if not j.future.done():
                        j.future.set_result((y[offset:offset + n, :j.steps],
                                             {"queue_ms": queue_ms, "compute_ms": compute_ms,
                                              "batch_requests": len(batch), "batch_rows": len(x)}))
                offset += n
            log_event("batch", logging.DEBUG, box=cfg.box, requests=len(batch), rows=len(x), steps=steps,
                      compute_ms=round(compute_ms, 2), ok=y is not None)

        # ------------------------------------------------------------ metrics
        @property
        def queue_depth(self) -> int:
            return self._queue.qsize() if self._queue else 0

        def gpu_util(self) -> float:
            """NVML utilisation when there is a GPU, else the busy share of GPU slots."""
            util = self.gpu.last.get("gpu_util")
            if util is None:
                calls = min(self.cfg.concurrency, self.in_flight)
                util = calls / self.cfg.concurrency
            return round(float(util), 3)

        def status(self) -> str:
            if not self.ready:
                return "down"
            return "degraded" if self.queue_depth >= self.cfg.max_queue // 2 else "ok"

        def snapshot(self) -> dict:
            """Everything the router might want, as one JSON-able dict."""
            b = self.backend
            return {
                "schema": METRICS_SCHEMA,
                "box": self.cfg.box,
                "model_version": MODEL_VERSION,
                "availability": {"status": self.status(), "ready": self.ready, "load_error": self.load_error,
                                 "uptime_s": round(time.monotonic() - self.started, 1)},
                "device": {"backend": getattr(b, "name", None), "type": getattr(b, "device", None),
                           "name": getattr(b, "device_name", None), "precision": getattr(b, "precision", None)},
                "load": {"in_flight": self.in_flight, "queue_depth": self.queue_depth,
                         "max_concurrency": self.cfg.concurrency, "max_queue": self.cfg.max_queue,
                         "gpu_util": self.gpu_util()},
                **self.metrics.snapshot(),
                "gpu_memory": {**(b.memory() if b and self.ready else {}),
                               "device_used_mb": self.gpu.last.get("memory_used_mb"),
                               "device_total_mb": self.gpu.last.get("memory_total_mb")},
                "cold_start": self.cold_start,
                "config": asdict(self.cfg),
            }
  inference-forecast-py: |
    """Turn an API.md forecast request into model rows, and model output into the response.

    Works on plain dicts so this module (and the bench) does not need pydantic.
    """
    from __future__ import annotations

    import math
    from datetime import UTC, datetime, timedelta

    import numpy as np

    from .model import FEATURES, MODEL_VERSION

    CONTRACT_VERSION = "1.0"  # kept equal to contract.CONTRACT_VERSION by a test
    _TWO_PI = 2 * math.pi


    def issue_time() -> datetime:
        return datetime.now(UTC).replace(minute=0, second=0, microsecond=0)


    def build_rows(lat: float, lon: float, members: int, issued: datetime) -> np.ndarray:
        """One row per ensemble member. Member 0 is unperturbed; the rest get a fixed nudge."""
        la, lo = math.radians(lat), math.radians(lon)
        hour = (issued.hour + lon / 15) % 24 / 24 * _TWO_PI
        doy = issued.timetuple().tm_yday / 365.25 * _TWO_PI
        base = np.array([math.sin(la), math.cos(la), math.sin(lo), math.cos(lo),
                         math.sin(hour), math.cos(hour), math.sin(doy), math.cos(doy)], np.float32)
        x = np.tile(base, (members, 1))
        for m in range(1, members):
            x[m] += 0.05 * np.random.default_rng(m).standard_normal(FEATURES).astype(np.float32)
        return x


    def to_physical(y: np.ndarray, lat: float, lon: float, issued: datetime, leads: list[int]) -> np.ndarray:
        """Map model output in [-1, 1] to temp_c, wind_ms, precip_mm, pressure_hpa at `leads`.

        y is (members, hours, 4) with one step per hour. Returns (members, len(leads), 4).
        """
        idx = np.array(leads) - 1
        y = y[:, idx, :].astype(np.float64)
        local_hour = (issued.hour + np.array(leads) + lon / 15) % 24
        diurnal = 5 * np.sin((local_hour - 9) / 24 * _TWO_PI)
        out = np.empty_like(y)
        out[..., 0] = 27 - 0.45 * abs(lat) + diurnal + 4 * y[..., 0]
        out[..., 1] = np.maximum(0.0, 4 + 3 * y[..., 1])
        out[..., 2] = np.maximum(0.0, 2 * y[..., 2] - 0.5)
        out[..., 3] = 1013 + 8 * y[..., 3]
        return out.round(1)


    def _points(values: np.ndarray, leads: list[int], valid: list[str]) -> list[dict]:
        return [{"lead_hours": lead, "valid_time": vt, "temp_c": t, "wind_ms": w, "precip_mm": p, "pressure_hpa": q}
                for lead, vt, (t, w, p, q) in zip(leads, valid, values.tolist())]


    def build_response(req: dict, y: np.ndarray, issued: datetime, box: str, timing: dict) -> dict:
        """`req` is a validated ForecastRequest as a dict; the result matches ForecastResponse."""
        hours, step, members = req["hours_ahead"], req.get("step_hours", 1), req.get("ensemble_members", 1)
        leads = list(range(step, hours + 1, step))
        valid = [(issued + timedelta(hours=h)).strftime("%Y-%m-%dT%H:%M:%SZ") for h in leads]
        phys = to_physical(y, req["lat"], req["lon"], issued, leads)
        if members > 1:
            member_list = [{"member": m, "points": _points(phys[m], leads, valid)} for m in range(members)]
            forecast = _points(phys.mean(axis=0).round(1), leads, valid)
        else:
            member_list, forecast = None, _points(phys[0], leads, valid)
        return {
            "request_id": req.get("request_id"), "box": box, "model_version": MODEL_VERSION,
            "contract_version": CONTRACT_VERSION, "issued_at": issued.strftime("%Y-%m-%dT%H:%M:%SZ"),
            "lat": req["lat"], "lon": req["lon"], "hours_ahead": hours, "step_hours": step,
            "low_confidence": hours > 72, "forecast": forecast, "members": member_list, "timing": timing,
        }
  inference-gpu-py: |
    """GPU utilisation and memory from nvidia-smi, sampled on a background thread.

    /stats must stay cheap, so readers only ever see the last sample. On machines
    without nvidia-smi (laptops) every field is None and callers fall back to
    in_flight / max_concurrency.
    """
    from __future__ import annotations

    import shutil
    import subprocess
    import threading

    QUERY = "utilization.gpu,memory.used,memory.total,name"


    def _num(s: str):
        try:
            return float(s)
        except ValueError:  # "[N/A]" on unified-memory boxes such as DGX Spark
            return None


    def parse_smi(line: str) -> dict:
        parts = [p.strip() for p in line.split(",")]
        if len(parts) < 4:
            return {}
        util = _num(parts[0])
        return {"gpu_util": None if util is None else round(util / 100, 3),
                "memory_used_mb": _num(parts[1]), "memory_total_mb": _num(parts[2]),
                "name": ",".join(parts[3:]).strip()}


    def query_smi(timeout: float = 2.0) -> dict:
        exe = shutil.which("nvidia-smi")
        if not exe:
            return {}
        try:
            out = subprocess.run([exe, f"--query-gpu={QUERY}", "--format=csv,noheader,nounits"],
                                 capture_output=True, text=True, timeout=timeout, check=True).stdout
        except (subprocess.SubprocessError, OSError):
            return {}
        lines = out.strip().splitlines()
        return parse_smi(lines[0]) if lines else {}


    class GpuMonitor:
        def __init__(self, interval_s: float = 1.0):
            self.interval_s = interval_s
            self.last: dict = {}
            self._stop = threading.Event()
            self._thread: threading.Thread | None = None

        def start(self) -> None:
            if self._thread or not shutil.which("nvidia-smi"):
                return
            self.last = query_smi()
            self._thread = threading.Thread(target=self._run, name="gpu-monitor", daemon=True)
            self._thread.start()

        def _run(self) -> None:
            while not self._stop.wait(self.interval_s):
                self.last = query_smi() or self.last

        def stop(self) -> None:
            self._stop.set()
  inference-metrics-py: |
    """Latency, throughput and error bookkeeping, plus JSON-lines logging."""
    from __future__ import annotations

    import json
    import logging
    import sys
    import time
    from collections import deque

    METRICS_SCHEMA = "wxrouter.inference.metrics/v1"


    def percentile(values, q: float) -> float:
        """Linear-interpolated percentile, q in 0..1. Empty input gives 0."""
        if not values:
            return 0.0
        s = sorted(values)
        pos = q * (len(s) - 1)
        lo = int(pos)
        hi = min(lo + 1, len(s) - 1)
        return s[lo] + (s[hi] - s[lo]) * (pos - lo)


    def latency_summary(values) -> dict:
        vals = list(values)
        return {"count": len(vals),
                "mean": round(sum(vals) / len(vals), 3) if vals else 0.0,
                "p50": round(percentile(vals, 0.50), 3),
                "p95": round(percentile(vals, 0.95), 3),
                "p99": round(percentile(vals, 0.99), 3),
                "max": round(max(vals), 3) if vals else 0.0}


    class MetricsRecorder:
        """Counters for one engine. Only touched from the event loop, so no locks."""

        def __init__(self, window: int = 2000, rate_window_s: float = 10.0):
            self.started = time.monotonic()
            self.rate_window_s = rate_window_s
            self.total_ms: deque[float] = deque(maxlen=window)
            self.queue_ms: deque[float] = deque(maxlen=window)
            self.compute_ms: deque[float] = deque(maxlen=window)
            self.done: deque[tuple[float, int]] = deque(maxlen=20000)  # (finish time, rows)
            self.ewma_ms = 0.0
            self.requests_total = 0  # finished, ok or not, plus rejected
            self.errors_total = 0
            self.timeouts = 0
            self.rejected = 0
            self.retries = 0
            self.batches = 0
            self.batch_rows = 0
            self.batch_requests = 0

        def ok(self, queue_ms: float, compute_ms: float, total_ms: float, rows: int) -> None:
            self.requests_total += 1
            self.total_ms.append(total_ms)
            self.queue_ms.append(queue_ms)
            self.compute_ms.append(compute_ms)
            self.done.append((time.monotonic(), rows))
            self.ewma_ms = total_ms if self.ewma_ms == 0 else 0.8 * self.ewma_ms + 0.2 * total_ms

        def error(self, kind: str) -> None:
            self.requests_total += 1
            self.errors_total += 1
            if kind == "timeout":
                self.timeouts += 1
            elif kind == "rejected":
                self.rejected += 1

        def batch(self, requests: int, rows: int) -> None:
            self.batches += 1
            self.batch_requests += requests
            self.batch_rows += rows

        def throughput(self) -> dict:
            now = time.monotonic()
            span = min(self.rate_window_s, max(now - self.started, 1e-6))
            recent = [rows for t, rows in self.done if now - t <= span]
            return {"window_s": round(span, 2),
                    "requests_per_s": round(len(recent) / span, 2),
                    "rows_per_s": round(sum(recent) / span, 2)}

        def snapshot(self) -> dict:
            n = self.requests_total
            return {
                "latency_ms": {"ewma": round(self.ewma_ms, 3), **latency_summary(self.total_ms)},
                "queue_ms": latency_summary(self.queue_ms),
                "compute_ms": latency_summary(self.compute_ms),
                "throughput": self.throughput(),
                "errors": {"requests_total": n, "errors_total": self.errors_total,
                           "error_rate": round(self.errors_total / n, 5) if n else 0.0,
                           "timeouts": self.timeouts, "rejected": self.rejected, "retries": self.retries},
                "batches": {"count": self.batches,
                            "mean_requests": round(self.batch_requests / self.batches, 2) if self.batches else 0.0,
                            "mean_rows": round(self.batch_rows / self.batches, 2) if self.batches else 0.0},
            }


    class JsonFormatter(logging.Formatter):
        def format(self, record: logging.LogRecord) -> str:
            out = {"ts": round(record.created, 3), "level": record.levelname, "event": record.getMessage()}
            out.update(getattr(record, "fields", {}))
            if record.exc_info:
                out["exc"] = self.formatException(record.exc_info)
            return json.dumps(out, default=str)


    def setup_logging(level: str = "INFO") -> None:
        """One JSON object per line on stderr, so stdout stays clean for results."""
        handler = logging.StreamHandler(sys.stderr)
        handler.setFormatter(JsonFormatter())
        log = logging.getLogger("wxrouter.inference")
        log.handlers[:] = [handler]
        log.setLevel(level.upper())
        log.propagate = False


    def log_event(event: str, level: int = logging.INFO, **fields) -> None:
        logging.getLogger("wxrouter.inference").log(level, event, extra={"fields": fields})
  inference-model-py: |
    """Tiny autoregressive forecast model with a torch (GPU) and a numpy (CPU) backend.

    The weights are seeded random numbers, NOT a trained weather model. The point is
    a real GPU workload whose cost grows with forecast length and ensemble size, the
    same way the mock's cost model does. Swap in the weather team's model by writing
    another backend with the same `rollout()` signature.

    One forecast hour is `layers` residual blocks on a `hidden`-wide state. A rollout
    of `steps` hours returns one 4-vector in [-1, 1] per hour; forecast.py turns that
    into temperature, wind, precipitation and pressure.
    """
    from __future__ import annotations

    import numpy as np

    FEATURES = 8
    OUTPUTS = 4
    MODEL_VERSION = "wx-tiny-untrained-0.1"


    def init_weights(hidden: int, layers: int, seed: int) -> dict[str, np.ndarray]:
        rng = np.random.default_rng(seed)

        def mat(i: int, o: int, gain: float = 1.0) -> np.ndarray:
            return (rng.standard_normal((i, o)) * gain / np.sqrt(i)).astype(np.float32)

        w = {"enc_w": mat(FEATURES, hidden), "enc_b": np.zeros(hidden, np.float32)}
        for i in range(layers):
            w[f"w1_{i}"] = mat(hidden, hidden)
            w[f"b1_{i}"] = np.zeros(hidden, np.float32)
            w[f"w2_{i}"] = mat(hidden, hidden, 0.5)
            w[f"b2_{i}"] = np.zeros(hidden, np.float32)
        w["dec_w"] = mat(hidden, OUTPUTS)
        w["dec_b"] = np.zeros(OUTPUTS, np.float32)
        return w


    class NumpyBackend:
        """CPU fallback that needs only numpy. Same weights and maths as TorchBackend."""

        name = "numpy"
        device = "cpu"
        device_name = "cpu (numpy)"
        precision = "fp32"

        def __init__(self, hidden: int, layers: int, seed: int):
            self.w = init_weights(hidden, layers, seed)
            self.layers = layers

        def rollout(self, x: np.ndarray, steps: int) -> np.ndarray:
            w = self.w
            h = np.tanh(x @ w["enc_w"] + w["enc_b"])
            out = np.empty((x.shape[0], steps, OUTPUTS), np.float32)
            for t in range(steps):
                for i in range(self.layers):
                    h = h + np.tanh(h @ w[f"w1_{i}"] + w[f"b1_{i}"]) @ w[f"w2_{i}"] + w[f"b2_{i}"]
                h = np.tanh(h)
                out[:, t] = np.tanh(h @ w["dec_w"] + w["dec_b"])
            return out

        def memory(self) -> dict:
            return {}

        def reset_peak_memory(self) -> None:
            pass


    class TorchBackend:
        name = "torch"

        def __init__(self, hidden: int, layers: int, seed: int, device: str, amp: bool):
            import torch

            self.torch = torch
            self.device = device
            self.layers = layers
            self.amp = amp and device == "cuda"
            self.precision = "fp16-autocast" if self.amp else "fp32"
            if device == "cuda":
                self.device_name = torch.cuda.get_device_name(0)
                torch.backends.cuda.matmul.allow_tf32 = True
            else:
                self.device_name = device
            self.w = {k: torch.from_numpy(v).to(device) for k, v in init_weights(hidden, layers, seed).items()}

        def rollout(self, x: np.ndarray, steps: int) -> np.ndarray:
            torch, w = self.torch, self.w
            try:
                with torch.inference_mode(), torch.autocast("cuda", dtype=torch.float16, enabled=self.amp):
                    h = torch.tanh(torch.from_numpy(x).to(self.device) @ w["enc_w"] + w["enc_b"])
                    out = torch.empty((x.shape[0], steps, OUTPUTS), dtype=h.dtype, device=self.device)
                    for t in range(steps):
                        for i in range(self.layers):
                            h = torch.addmm(w[f"b2_{i}"], torch.tanh(torch.addmm(w[f"b1_{i}"], h, w[f"w1_{i}"])),
                                            w[f"w2_{i}"]) + h
                        h = torch.tanh(h)
                        out[:, t] = torch.tanh(torch.addmm(w["dec_b"], h, w["dec_w"]))
                return out.float().cpu().numpy()  # .cpu() waits for the GPU, so timings are honest
            except torch.OutOfMemoryError:
                torch.cuda.empty_cache()  # give the retry a chance
                raise

        def memory(self) -> dict:
            if self.device != "cuda":
                return {}
            cuda, mb = self.torch.cuda, 1024 * 1024
            return {"allocated_mb": round(cuda.memory_allocated() / mb, 1),
                    "reserved_mb": round(cuda.memory_reserved() / mb, 1),
                    "peak_allocated_mb": round(cuda.max_memory_allocated() / mb, 1)}

        def reset_peak_memory(self) -> None:
            if self.device == "cuda":
                self.torch.cuda.reset_peak_memory_stats()


    def make_backend(cfg):
        """Pick the backend and device. Falls back to CPU unless cfg.require_gpu."""
        torch = None
        if cfg.backend in ("auto", "torch"):
            try:
                import torch
            except ImportError:
                if cfg.backend == "torch":
                    raise
        cuda = bool(torch and torch.cuda.is_available())
        if (cfg.require_gpu or cfg.device == "cuda") and not cuda:
            raise RuntimeError("CUDA GPU required but not available "
                               f"(torch={'missing' if torch is None else torch.__version__})")
        if torch is None:
            return NumpyBackend(cfg.hidden, cfg.layers, cfg.seed)
        device = cfg.device if cfg.device != "auto" else ("cuda" if cuda else "cpu")
        return TorchBackend(cfg.hidden, cfg.layers, cfg.seed, device, cfg.amp)
  inference-server-py: |
    """Real forecast server: the API.md contract backed by the inference engine.

    Drop-in replacement for mock_server.py, so the router needs no changes:

      python -m inference.server --box box-a --port 8001

    Adds one endpoint beyond the contract, `GET /v1/metrics`, with the full JSON
    metrics snapshot (latency p50/p95/p99, throughput, load, availability, GPU
    memory). `--metrics-file` also writes that snapshot to disk every few seconds.

    While the model loads, /health answers 503 "down", so the router keeps traffic
    away until warm-up has finished.
    """
    from __future__ import annotations

    import argparse
    import asyncio
    import json
    import os
    import time
    from contextlib import asynccontextmanager

    import uvicorn
    from fastapi import FastAPI, HTTPException
    from fastapi.responses import JSONResponse

    from contract import ForecastRequest, ForecastResponse, Health, Stats

    from .config import EngineConfig, add_engine_args, engine_config_from_args
    from .engine import InferenceEngine, InferenceError, InferenceTimeout, Overloaded
    from .forecast import build_response, build_rows, issue_time
    from .metrics import log_event, percentile, setup_logging
    from .model import MODEL_VERSION


    def write_json_atomic(path: str, data: dict) -> None:
        tmp = f"{path}.tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, path)


    def create_app(engine: InferenceEngine, metrics_file: str | None = None,
                   metrics_interval_s: float = 2.0) -> FastAPI:
        cfg = engine.cfg

        async def dump_metrics() -> None:
            while True:
                await asyncio.sleep(metrics_interval_s)
                write_json_atomic(metrics_file, engine.snapshot())

        @asynccontextmanager
        async def lifespan(app: FastAPI):
            tasks = [asyncio.create_task(engine.start())]  # load in the background; /health says "down" meanwhile
            if metrics_file:
                tasks.append(asyncio.create_task(dump_metrics()))
            yield
            for t in tasks:
                t.cancel()
            await asyncio.gather(*tasks, return_exceptions=True)
            await engine.stop()

        app = FastAPI(title=f"wxrouter inference server ({cfg.box})", lifespan=lifespan)

        @app.post("/v1/forecast", response_model=ForecastResponse)
        async def forecast(req: ForecastRequest):
            t0 = time.perf_counter()
            issued = issue_time()
            x = build_rows(req.lat, req.lon, req.ensemble_members, issued)
            try:
                y, t = await engine.infer(x, req.hours_ahead)
            except (Overloaded, InferenceTimeout) as e:
                raise HTTPException(503, str(e))
            except InferenceError as e:
                raise HTTPException(500, str(e))
            timing = {"queue_ms": round(t["queue_ms"], 2), "compute_ms": round(t["compute_ms"], 2), "total_ms": 0.0}
            body = build_response(req.model_dump(), y, issued, cfg.box, timing)
            timing["total_ms"] = round((time.perf_counter() - t0) * 1000, 2)
            return JSONResponse(body)  # already contract-shaped; skip a second validation pass

        @app.get("/health", response_model=Health)
        async def health():
            status = engine.status()
            body = {"status": status, "box": cfg.box, "model_version": MODEL_VERSION, "contract_version": "1.0",
                    "uptime_s": round(time.monotonic() - engine.started, 1)}
            return JSONResponse(body, status_code=503 if status == "down" else 200)

        @app.get("/stats", response_model=Stats)
        async def stats():
            m = engine.metrics
            recent = list(m.total_ms)[-200:]
            return Stats(
                box=cfg.box, in_flight=engine.in_flight, queue_depth=engine.queue_depth,
                max_concurrency=cfg.concurrency, gpu_util=engine.gpu_util(),
                ewma_latency_ms=round(m.ewma_ms, 1),
                p50_latency_ms=round(percentile(recent, 0.50), 1),
                p95_latency_ms=round(percentile(recent, 0.95), 1),
                requests_total=m.requests_total, errors_total=m.errors_total, mode="normal",
            )

        @app.get("/v1/metrics")
        async def metrics():
            return engine.snapshot()

        return app


    def main() -> None:
        ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
        ap.add_argument("--name", help="alias for --box, to match mock_server.py")
        ap.add_argument("--host", default="127.0.0.1")
        ap.add_argument("--port", type=int, default=8001)
        ap.add_argument("--metrics-file", help="write the JSON metrics snapshot here every --metrics-interval s")
        ap.add_argument("--metrics-interval", type=float, default=2.0)
        ap.add_argument("--log-level", default="INFO")
        add_engine_args(ap)
        a = ap.parse_args()
        if a.name:
            a.box = a.name
        setup_logging(a.log_level)
        cfg: EngineConfig = engine_config_from_args(a)
        log_event("server_start", box=cfg.box, host=a.host, port=a.port)
        uvicorn.run(create_app(InferenceEngine(cfg), a.metrics_file, a.metrics_interval),
                    host=a.host, port=a.port, log_level="warning")


    if __name__ == "__main__":
        main()
services:
  box-a:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.09-py3
    files:
      /app/contract.py: file://contract-py
      /app/inference/__init__.py: file://inference-init-py
      /app/inference/bench.py: file://inference-bench-py
      /app/inference/config.py: file://inference-config-py
      /app/inference/engine.py: file://inference-engine-py
      /app/inference/forecast.py: file://inference-forecast-py
      /app/inference/gpu.py: file://inference-gpu-py
      /app/inference/metrics.py: file://inference-metrics-py
      /app/inference/model.py: file://inference-model-py
      /app/inference/server.py: file://inference-server-py
    script: |
      #!/bin/sh
      set -e
      echo "[box-a] host=$(hostname) arch=$(uname -m)"
      nvidia-smi || echo "[box-a] nvidia-smi not available"
      python -c "import torch; print('[box-a] torch', torch.__version__, 'cuda', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NO GPU')"
      pip install --quiet --no-cache-dir --disable-pip-version-check fastapi uvicorn httpx pydantic
      cd /app
      exec python -m inference.server --name box-a --host 0.0.0.0 --port 8001 --require-gpu
    resource:
      cpu:
        cores: 4
      memory:
        size: 16GB
      devices:
        nvidia.com/gpu: 1
    network:
      ports:
        - name: http
          port: 8001
          protocol: tcp
  box-b:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.09-py3
    files:
      /app/contract.py: file://contract-py
      /app/inference/__init__.py: file://inference-init-py
      /app/inference/bench.py: file://inference-bench-py
      /app/inference/config.py: file://inference-config-py
      /app/inference/engine.py: file://inference-engine-py
      /app/inference/forecast.py: file://inference-forecast-py
      /app/inference/gpu.py: file://inference-gpu-py
      /app/inference/metrics.py: file://inference-metrics-py
      /app/inference/model.py: file://inference-model-py
      /app/inference/server.py: file://inference-server-py
    script: |
      #!/bin/sh
      set -e
      echo "[box-b] host=$(hostname) arch=$(uname -m)"
      nvidia-smi || echo "[box-b] nvidia-smi not available"
      python -c "import torch; print('[box-b] torch', torch.__version__, 'cuda', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NO GPU')"
      pip install --quiet --no-cache-dir --disable-pip-version-check fastapi uvicorn httpx pydantic
      cd /app
      exec python -m inference.server --name box-b --host 0.0.0.0 --port 8002 --require-gpu
    resource:
      cpu:
        cores: 4
      memory:
        size: 16GB
      devices:
        nvidia.com/gpu: 1
    network:
      ports:
        - name: http
          port: 8002
          protocol: tcp
  router:
    image:
      uri: docker://python:3.12-slim
    files:
      /app/router.py: file://router-py
    depends-on:
      - name: box-a
        status: RUNNING
      - name: box-b
        status: RUNNING
    script: |
      #!/bin/sh
      set -e
      pip install --quiet --no-cache-dir --disable-pip-version-check fastapi uvicorn httpx pydantic
      for h in box-a box-b; do echo "[router] $h -> $(getent hosts $h || echo unresolved)"; done
      cd /app
      exec python router.py --host 0.0.0.0 --port 8000 --policy adaptive --preferred box-b \
        --backend box-a=http://box-a:8001 --backend box-b=http://box-b:8002
    resource:
      cpu:
        cores: 1
      memory:
        size: 1GB
    network:
      ports:
        - name: http
          port: 8000
          protocol: tcp
