    }

    REAL_TOOLS = ("start_finetune", "stop_finetune", "kill_forecast_server")


    def fn(name: str, description: str, properties: dict, required: list[str] | None = None) -> dict:
        params = {"type": "object", "properties": properties}
        if required:
            params["required"] = required
        return {"type": "function", "function": {"name": name, "description": description, "parameters": params}}


    def build_tools(boxes: list[str], stack_boxes: list[str]) -> list[dict]:
        """The tools for the LLM. Boxes with a supervisor get the real actions; the others keep simulate_box."""
        sim_boxes = [b for b in boxes if b not in stack_boxes]
        tools = [
            fn("geocode", "Look up latitude/longitude for a city name.", {"place": {"type": "string"}}, ["place"]),
            fn("get_forecast",
               "Weather forecast for a location from the GPU weather model (via the router). "
               "Accurate up to 72 h, max 120 h. ensemble_members > 1 gives an uncertainty range. "
               "The summary has precip_mm (rain) only when the model gives rain; when the result says rain is "
               "not available, do not mention rain. simulated=true means the numbers come from a mock server.",
               {"lat": {"type": "number"}, "lon": {"type": "number"},
                "hours_ahead": {"type": "integer", "minimum": 1, "maximum": 120},
                "ensemble_members": {"type": "integer", "minimum": 1, "maximum": 20},
                "place": {"type": "string", "description": "Place name to show with the forecast"}},
               ["lat", "lon", "hours_ahead"]),
            fn("get_cluster_status",
               "Which boxes are healthy, which one is active, routing policy, and latency. Per box: simulated "
               "(true = a mock server) and, where a real fine-tune job can run, its state.", {}),
            fn("set_routing_policy", "Change the router's rule. preferred = home box for adaptive ('' clears it).",
               {"policy": {"type": "string", "enum": ["static", "round_robin", "least_loaded", "adaptive", "balanced"]},
                "preferred": {"type": "string"}}, ["policy"]),
        ]
        if sim_boxes:
            tools.append(fn(
                "simulate_box",
                "SIMULATED demo control (a test hook; no real job runs and nothing really fails): put a box in "
                "normal, slow (as if a training job were running) or error (as if it were down) mode.",
                {"box": {"type": "string", "enum": sim_boxes},
                 "mode": {"type": "string", "enum": ["normal", "slow", "error"]},
                 "slow_factor": {"type": "number"}}, ["box", "mode"]))
        if stack_boxes:
            box = {"type": "string", "enum": stack_boxes}
            tools += [
                fn("start_finetune",
                   "REAL job: start the fine-tune run on a box through its supervisor. It shares the GPU with the "
                   "forecasts, so the box gets slower while it runs. steps is optional (the job has its own default).",
                   {"box": box, "steps": {"type": "integer", "minimum": 1}}, ["box"]),
                fn("stop_finetune", "REAL job: stop the fine-tune run on a box.", {"box": box}, ["box"]),
                fn("kill_forecast_server",
                   "REAL failure: kill the forecast server process on a box. Its supervisor starts it again by "
                   "itself within seconds; the router sends requests to the other box meanwhile.",
                   {"box": box}, ["box"]),
            ]
        return tools


    def system_prompt(boxes: list[str], stack_boxes: list[str], units: str = "C") -> str:
        sim_boxes = [b for b in boxes if b not in stack_boxes]
        text = (
            "You are the forecast assistant for a two-box DGX Spark cluster. Answer weather questions "
            "with the get_forecast tool (call geocode first for place names, and pass the place name). "
            "The user sees a weather card, so keep the text to one or two sentences: the range, wind and "
            "humidity in the user's units (" + ("°F, mph" if units == "F" else "°C, km/h") + "), any "
            "low-confidence warning past 72 h, and which box served it. The model steps every 6 h; hourly "
            "values in between are interpolated. Give rain in mm only when the forecast summary has precip_mm. When the result says "
            "rain is not available, the model has no rain output: say nothing about rain, precipitation, "
            "showers or dry weather. Leave out any other number that is missing. When the result has "
            "simulated=true, the numbers come from a mock server and not from a weather model: say so in a "
            "few words. For cluster questions use get_cluster_status. Only change routing, box modes or "
            "jobs when the user asks. ")
        if stack_boxes:
            text += (f"On {', '.join(stack_boxes)} the actions are real: start_finetune and stop_finetune run a "
                     "real fine-tune job, and kill_forecast_server really kills the forecast server (its "
                     "supervisor restarts it by itself). ")
        if sim_boxes:
            text += (f"On {', '.join(sim_boxes)} simulate_box only simulates a training job (slow) or a failure "
                     "(error); nothing real runs or fails. ")
        return text + "Always say whether an action was real or simulated."


    class Agent:
        def __init__(self, ops: "Ops", llm_base_url: str | None, llm_model: str | None,
                     llm_api_key: str | None = None):
            self.ops = ops
            self.llm_base_url = llm_base_url.rstrip("/") if llm_base_url else None
            self.llm_model = llm_model or "local"
            self.llm_api_key = llm_api_key
            self.units = "C"

        @property
        def mode(self) -> str:
            return f"llm:{self.llm_model}" if self.llm_base_url else "offline"

        @property
        def boxes(self) -> list[str]:
            return list(self.ops.boxes)

        @property
        def stack_boxes(self) -> list[str]:
            return [b for b in self.ops.boxes if b in self.ops.stacks]

        # ---------------------------------------------------------------- tools
        async def run_tool(self, name: str, args: dict) -> dict:
            t0 = time.perf_counter()
            try:
                if name == "geocode":
                    out = geocode(str(args.get("place", "")))
                elif name == "get_forecast":
                    out = await self.ops.forecast(float(args["lat"]), float(args["lon"]),
                                                  int(args.get("hours_ahead", 24)),
                                                  int(args.get("ensemble_members", 1)), args.get("place"))
                elif name == "get_cluster_status":
                    out = await self.ops.cluster_status()
                elif name == "set_routing_policy":
                    out = await self.ops.set_policy(args["policy"], args.get("preferred"))
                elif name == "simulate_box":
                    if args["box"] in self.ops.stacks:
                        out = {"error": f"{args['box']} has a supervisor, so its actions are real: use start_finetune, "
                                        "stop_finetune or kill_forecast_server"}
                    else:
                        out = await self.ops.set_box_mode(args["box"], args["mode"], float(args.get("slow_factor") or 2))
                elif name == "start_finetune":
                    out = await self.ops.finetune(args["box"], "start", int(args["steps"]) if args.get("steps") else None)
                elif name == "stop_finetune":
                    out = await self.ops.finetune(args["box"], "stop")
                elif name == "kill_forecast_server":
                    out = await self.ops.kill_forecast(args["box"])
                else:
                    out = {"error": f"unknown tool {name}"}
            except Exception as e:  # report tool errors to the model/user instead of crashing the chat
                out = {"error": f"{e.__class__.__name__}: {e}"}
            return {"tool": name, "args": args, "result": out, "ms": round((time.perf_counter() - t0) * 1000, 1)}

        # ---------------------------------------------------------------- chat
        async def chat(self, messages: list[dict], units: str = "C") -> dict:
            self.units = units
            if self.llm_base_url:
                try:
                    return await self._chat_llm(messages)
                except httpx.HTTPError as e:
                    res = await self._chat_offline(messages)
                    res["note"] = f"LLM unreachable ({e.__class__.__name__}); answered offline."
                    return res
            return await self._chat_offline(messages)

        async def _chat_llm(self, messages: list[dict]) -> dict:
            tools = build_tools(self.boxes, self.stack_boxes)
            convo = [{"role": "system", "content": system_prompt(self.boxes, self.stack_boxes, getattr(self, "units", "C"))}] + [
                {"role": m["role"], "content": m["content"]} for m in messages if m["role"] in ("user", "assistant")]
            steps: list[dict] = []
            headers = {"Authorization": f"Bearer {self.llm_api_key}"} if self.llm_api_key else {}
            async with httpx.AsyncClient(timeout=120) as c:
                for _ in range(6):
                    r = await c.post(f"{self.llm_base_url}/chat/completions", headers=headers, json={
                        "model": self.llm_model, "messages": convo, "tools": tools, "temperature": 0.2})
                    r.raise_for_status()
                    msg = r.json()["choices"][0]["message"]
                    calls = msg.get("tool_calls") or []
                    if not calls:
                        return {"reply": msg.get("content") or "", "steps": steps, "mode": self.mode}
                    convo.append({"role": "assistant", "content": msg.get("content") or "", "tool_calls": calls})
                    for call in calls:
                        f = call["function"]
                        try:
                            args = json.loads(f.get("arguments") or "{}")
                        except json.JSONDecodeError:
                            args = {}
                        if not isinstance(args, dict):
                            args = {}
                        step = await self.run_tool(f["name"], args)
                        steps.append(step)
                        convo.append({"role": "tool", "tool_call_id": call.get("id", f["name"]),
                                      "content": json.dumps(slim(step["result"]))})
            return {"reply": "I couldn't finish that in a few steps; try asking more specifically.",
                    "steps": steps, "mode": self.mode}

        async def _chat_offline(self, messages: list[dict]) -> dict:
            text = next((m["content"] for m in reversed(messages) if m["role"] == "user"), "")
            low = text.lower()
            steps: list[dict] = []

            box = find_box(low, self.boxes)
            policy = next((p for p in ("least_loaded", "round_robin", "static", "adaptive", "balanced")
                           if p.replace("_", " ") in low or p in low or (p == "least_loaded" and "least loaded" in low)), None)

            # "Is box A down?" asks; it must not fail (or really kill) box A. A question about a box gets the status.
            asking = bool(re.match(r"\s*(is|are|was|were|why|what|which|how|does|did|has|have|when|who)\b", low))
            if box and not asking:
                real = box in self.ops.stacks  # a supervisor is known: the actions are real ones
                train = re.search(r"\b(slow|train|fine-?tun)", low)
                halt = re.search(r"\b(stop|cancel|halt|abort|end)\b", low)
                if train and halt:
                    return await (self._stop_real(box, steps) if real else self._sim(box, "normal", steps))
                if train:
                    return await (self._start_real(box, low, steps) if real else self._sim(box, "slow", steps))
                if re.search(r"\b(fail|kill|down|stop|crash)", low):
                    return await (self._kill_real(box, steps) if real else self._sim(box, "error", steps))
                if re.search(r"\b(normal|recover|restore|back|heal|fix)", low):
                    return await (self._recover_real(box, steps) if real else self._sim(box, "normal", steps))
            if policy and re.search(r"\b(switch|use|set|change|policy|rule)", low):
                pref = (box or ("box-b" if "box-b" in self.ops.boxes else self.boxes[-1])) if policy == "adaptive" else None
                step = await self.run_tool("set_routing_policy", {"policy": policy, **({"preferred": pref} if pref else {})})
                steps.append(step)
                if err := step["result"].get("error"):
                    return self._done(f"The routing rule was not changed: {err}", steps)
                return self._done(f"Routing rule is now **{policy}**" + (f" with {pref} as the preferred box." if pref else "."), steps)
            if (re.search(r"\b(status|health|which box|cluster|active|routing|latency)\b", low) or (box and asking)) \
                    and not find_city(low):
                step = await self.run_tool("get_cluster_status", {})
                steps.append(step)
                s = step["result"]
                if "error" in s:
                    return self._done(f"I could not read the cluster status: {s['error']}", steps)
                boxes = ", ".join(describe_box(n, b) for n, b in s["boxes"].items())
                p95 = s.get("p95_ms")
                return self._done(f"Policy **{s['policy']}**, active box **{s['active']}**. {boxes}. "
                                  f"Last 10 s: {s['rps']} req/s" + (f", p95 {p95:.0f} ms." if p95 else "."), steps)

            # Default: a forecast question.
            city = find_city(low)
            coords = re.search(r"(-?\d{1,2}(?:\.\d+)?)\s*,\s*(-?\d{1,3}(?:\.\d+)?)", text)
            if city:
                g = await self.run_tool("geocode", {"place": city})
                steps.append(g)
                lat, lon, place = g["result"]["lat"], g["result"]["lon"], city.title()
            elif coords:
                lat, lon, place = float(coords.group(1)), float(coords.group(2)), f"{coords.group(1)}, {coords.group(2)}"
            else:
                can = ("start or stop the real fine-tune job or kill a forecast server" if self.ops.stacks
                       else "simulate a slow or failed box for the demo")
                return self._done("I can forecast for a city (for example *\"Weather in Chicago for the next 48 hours\"*) "
                                  "or coordinates (*\"37.7, -122.4 next 3 days\"*). I can also show cluster status, "
                                  f"switch the routing rule, or {can}.", steps)
            hours = parse_hours(low)
            members = 10 if re.search(r"\b(ensemble|range|uncertain|spread|confidence)", low) else 1
            f = await self.run_tool("get_forecast", {"lat": lat, "lon": lon, "hours_ahead": hours,
                                                     "ensemble_members": members, "place": place})
            steps.append(f)
            r = f["result"]
            if "error" in r:
                return self._done(f"The forecast failed: {r['error']}", steps)
            return self._done(forecast_text(place, hours, members, r, self.units), steps)

        # ------------------------------------------------- box actions of the rule-based mode
        async def _sim(self, box: str, mode: str, steps: list[dict]) -> dict:
            """SIMULATED: the box's /admin/mode test hook."""
            step = await self.run_tool("simulate_box", {"box": box, "mode": mode, **({"slow_factor": 3} if mode == "slow" else {})})
            steps.append(step)
            if err := step["result"].get("error"):
                return self._done(f"The simulation on {box} did not work: {err}", steps)
            if mode == "slow":
                return self._done(f"Started a **simulated** training job on {box} (no real job runs): it's now about "
                                  "3× slower. Watch the dashboard: adaptive moves new requests off it within a few "
                                  "seconds.", steps)
            if mode == "error":
                return self._done(f"**Simulated** failure: {box} is now failing every request. The router retries on "
                                  "the other box, so users shouldn't see errors.", steps)
            return self._done(f"{box} is back to normal (simulation off). If it's the preferred box, traffic returns "
                              "to it shortly.", steps)

        async def _start_real(self, box: str, low: str, steps: list[dict]) -> dict:
            m = re.search(r"(\d+)\s*steps?\b", low)
            n = int(m.group(1)) if m and int(m.group(1)) > 0 else None
            step = await self.run_tool("start_finetune", {"box": box, **({"steps": n} if n else {})})
            steps.append(step)
            if err := step["result"].get("error"):
                return self._done(f"The real fine-tune job on {box} did not start: {err}", steps)
            return self._done(f"Started the **real** fine-tune job on {box} through its supervisor"
                              + (f" ({n} steps)" if n else "") + ". This is not a simulation: it shares the GPU with "
                              "the forecasts. Its progress shows on the box card, and adaptive moves new requests "
                              "off the box if it gets clearly slower.", steps)

        async def _stop_real(self, box: str, steps: list[dict]) -> dict:
            step = await self.run_tool("stop_finetune", {"box": box})
            steps.append(step)
            if err := step["result"].get("error"):
                return self._done(f"The real fine-tune job on {box} was not stopped: {err}", steps)
            status = step["result"].get("status") or {}
            state, code = status.get("state"), status.get("exit")
            if state == "failed" and isinstance(code, int) and code < 0:   # the supervisor's word for "ended by a signal"
                how = "It is stopped now (ended by the stop signal)."
            elif state == "done":
                how = "It has ended (done)."
            elif state == "idle":
                how = "It was not running."
            else:
                how = f"Its state is now: {state}."
            return self._done(f"Asked the supervisor of {box} to stop the **real** fine-tune job. {how}", steps)

        async def _kill_real(self, box: str, steps: list[dict]) -> dict:
            step = await self.run_tool("kill_forecast_server", {"box": box})
            steps.append(step)
            if err := step["result"].get("error"):
                return self._done(f"The forecast server on {box} was not killed: {err}", steps)
            return self._done(f"Killed the forecast server on {box}. This is a **real** process kill, not a "
                              "simulation. The router retries on the other box meanwhile, and the supervisor starts "
                              "the server again by itself within a few seconds.", steps)

        async def _recover_real(self, box: str, steps: list[dict]) -> dict:
            step = await self.run_tool("get_cluster_status", {})
            steps.append(step)
            s = step["result"]
            if "error" in s:
                return self._done(f"I could not read the cluster status: {s['error']}", steps)
            job = ((s.get("boxes") or {}).get(box) or {}).get("finetune") or {}
            if job.get("state") == "running":
                return await self._stop_real(box, steps)
            up = "healthy" if ((s.get("boxes") or {}).get(box) or {}).get("healthy") else "not healthy yet"
            return self._done(f"Nothing to undo by hand on {box}: no real fine-tune job is running there, and its "
                              f"supervisor restarts the forecast server by itself. The router sees {box} as {up}.", steps)

        def _done(self, reply: str, steps: list[dict]) -> dict:
            return {"reply": reply, "steps": steps, "mode": self.mode}


    # -------------------------------------------------------------------- helpers
    def forecast_text(place: str, hours: int, members: int, r: dict, units: str = "C") -> str:
        """The rule-based answer to a forecast question, in the user's units. A number the model did
        not give is left out: with no rain numbers there is no word about rain."""
        s = r.get("summary") or {}
        T, W = temp_fmt(units), wind_fmt(units)
        parts = []
        if s.get("min_c") is not None and s.get("max_c") is not None:
            parts.append(f"{T(s['min_c'])} to {T(s['max_c'])}")
        if s.get("max_wind_ms") is not None:
            parts.append(f"wind up to {W(s['max_wind_ms'])}")
        if s.get("humidity_avg_pct") is not None:
            parts.append(f"humidity around {s['humidity_avg_pct']}%")
        if not parts:
            return f"**{place}, next {hours} h:** the forecast came back without numbers."
        rain = "" if s.get("precip_mm") is None else (
            " No rain expected." if s["precip_mm"] == 0 else f" {s['precip_mm']} mm of rain in total.")
        warn = " Beyond 72 h the model is less reliable, so treat the later part as a rough guide." if r.get("low_confidence") else ""
        ens = (f" Across {members} ensemble members: {T(s['ens_min_c'])} to {T(s['ens_max_c'])}."
               if members > 1 and s.get("ens_min_c") is not None and s.get("ens_max_c") is not None else "")
        sim = " (Simulated data from a mock server.)" if r.get("simulated") else ""
        return f"**{place}, next {hours} h:** {', '.join(parts)}.{rain}{ens}{warn}{sim}"


    def describe_box(name: str, b: dict) -> str:
        """One box in the rule-based status answer: health, mode, whether it is a mock, a running real job."""
        notes = [str(b.get("mode"))]
        if b.get("simulated"):
            notes.append("simulated")
        job = b.get("finetune") or {}
        if job.get("state") == "running":
            at = f" at step {job['step']}/{job['total']}" if job.get("step") is not None and job.get("total") is not None else ""
            notes.append(f"real fine-tune job running{at}")
        return f"{name} {'healthy' if b.get('healthy') else 'DOWN'} ({', '.join(notes)})"


    def find_box(text: str, names: list[str]) -> str | None:
        """The first configured box that the (lower-case) text names: "box-b", "box b", "boxb", "node b"."""
        for name in names:
            key = name.lower()
            short = re.sub(r"^(?:box|node)[\s_-]*", "", key) or key
            if re.search(rf"\b(?:box|node)[\s_-]?{re.escape(short)}\b", text):
                return name
            if len(key) > 2 and re.search(rf"(?<![\w-]){re.escape(key)}(?![\w-])", text):
                return name
        return None


    def geocode(place: str) -> dict:
        key = place.strip().lower()
        if key in CITIES:
            lat, lon = CITIES[key]
            return {"place": place, "lat": lat, "lon": lon, "approximate": True}
        for name, (lat, lon) in CITIES.items():
            if key in name or name in key:
                return {"place": name.title(), "lat": lat, "lon": lon, "approximate": True}
        return {"error": f"unknown place {place!r}; give coordinates instead"}


    def find_city(text: str) -> str | None:
        hits = [c for c in CITIES if re.search(rf"\b{re.escape(c)}\b", text)]
        return max(hits, key=len) if hits else None


    def parse_hours(text: str) -> int:
        if m := re.search(r"(\d+)\s*(h|hr|hrs|hour|hours)\b", text):
            return max(1, min(120, int(m.group(1))))
        if m := re.search(r"(\d+)\s*(d|day|days)\b", text):
            return max(1, min(120, 24 * int(m.group(1))))
        if "week" in text:
            return 120
        if "tomorrow" in text:
            return 48
        if "tonight" in text or "today" in text:
            return 12
        return 24


    def temp_fmt(units: str):
        return (lambda c: f"{round(c * 9 / 5 + 32)} °F") if units == "F" else (lambda c: f"{round(c)} °C")


    def wind_fmt(units: str):
        return (lambda ms: f"{round(ms * 2.237)} mph") if units == "F" else (lambda ms: f"{round(ms * 3.6)} km/h")


    def slim(result: Any) -> Any:
        """What the LLM sees: drop the per-hour arrays the UI needs but the model doesn't. Numbers that are
        missing are dropped too, and missing rain is spelled out, so the model has nothing to make a rain
        sentence from."""
        if isinstance(result, dict) and "points" in result:
            out = {k: v for k, v in result.items() if k not in ("points", "members_temp")}
            summary = out.get("summary") or {}
            if summary.get("precip_mm") is None:
                out["rain"] = "not available: this model has no rain output, so say nothing about rain"
            out["summary"] = {k: v for k, v in summary.items() if v is not None}
            return out
        if isinstance(result, dict) and isinstance(result.get("status"), dict) and "last_lines" in result["status"]:
            # a supervisor's answer about a job: the last three lines are enough
            return {**result, "status": {**result["status"], "last_lines": result["status"]["last_lines"][-3:]}}
        return result


    Ops = Any  # implemented in server.py: forecast, cluster_status, set_policy, set_box_mode, finetune, kill_forecast
  ui-index-html: |
    <!doctype html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>wxrouter Control Room</title>
      <link rel="stylesheet" href="static/style.css">
    </head>
    <body>
    <header class="topbar">
      <div class="brand">
        <svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="2"/><path d="M6 19c4-6 8-6 10 0s6 6 10 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <div>
          <div class="brand-name">wxrouter</div>
          <div class="brand-sub">Forecast routing across two DGX Sparks</div>
        </div>
      </div>
      <div class="top-pills">
        <span class="pill" id="pill-router"><span class="dot"></span><span>Router</span></span>
        <span class="pill sim" id="pill-sim" title="At least one box is a mock: its forecast numbers are made up" hidden>simulated boxes</span>
        <span class="pill" id="pill-policy">policy –</span>
        <span class="pill" id="pill-agent">agent –</span>
      </div>
    </header>

    <main class="layout">
      <section class="dash" aria-label="Dashboard">
        <div class="kpis">
          <div class="kpi"><div class="kpi-label">Requests / s</div><div class="kpi-value" id="k-rps">–</div><div class="kpi-sub">last 10 s</div></div>
          <div class="kpi"><div class="kpi-label">p95 latency</div><div class="kpi-value" id="k-p95">–</div><div class="kpi-sub" id="k-p50">p50 –</div></div>
          <div class="kpi"><div class="kpi-label">p99 latency</div><div class="kpi-value" id="k-p99">–</div><div class="kpi-sub">tail users feel</div></div>
          <div class="kpi"><div class="kpi-label">Errors</div><div class="kpi-value" id="k-err">–</div><div class="kpi-sub" id="k-fo">failovers –</div></div>
          <div class="kpi kpi-active"><div class="kpi-label">Active box</div><div class="kpi-value" id="k-active">–</div><div class="kpi-sub" id="k-pref">preferred –</div></div>
        </div>

        <div class="boxes" id="boxes"></div>

        <div class="card model-card" id="model-card">
          <div class="card-head"><h2>Model</h2><span class="tag" id="model-badge" hidden></span></div>
          <div class="model-grid" id="model-grid">
            <div><div class="kpi-label">Model</div><div class="model-v" id="m-name">–</div></div>
            <div><div class="kpi-label">Parameters</div><div class="model-v" id="m-params">–</div></div>
            <div><div class="kpi-label">Device</div><div class="model-v" id="m-device">–</div></div>
            <div><div class="kpi-label">Newest starting state</div><div class="model-v" id="m-latest">–</div></div>
            <div><div class="kpi-label">Speed</div><div class="model-v" id="m-speed">–</div></div>
          </div>
          <p class="hint" id="model-note"></p>
        </div>

        <div class="card chart-card">
          <div class="card-head">
            <h2>Live traffic</h2>
            <div class="legend">
              <span><i class="sw sw-a"></i>box-a</span><span><i class="sw sw-b"></i>box-b</span><span><i class="sw sw-err"></i>error</span><span><i class="sw sw-fo"></i>failover</span>
            </div>
          </div>
          <canvas id="chart" height="260" aria-label="Request latency over the last 60 seconds, colored by box"></canvas>
          <canvas id="share" height="44" aria-label="Share of requests per box per second"></canvas>
          <div class="chart-foot"><span>60 s ago</span><span>each dot = one request · y = latency (log) · strip = share per second</span><span>now</span></div>
        </div>

        <div class="row2">
          <div class="card">
            <div class="card-head"><h2>Routing</h2></div>
            <div class="field">
              <label>Rule</label>
              <div class="seg" id="seg-policy" role="radiogroup">
                <button data-v="static">Static</button><button data-v="round_robin">Round robin</button><button data-v="least_loaded">Least loaded</button><button data-v="adaptive">Adaptive</button><button data-v="balanced">Balanced</button>
              </div>
              <p class="hint" id="policy-hint"></p>
            </div>
            <div class="field">
              <label for="sel-pref">Preferred box</label>
              <select id="sel-pref"><option value="">Both: pick per request by health score</option><option value="box-a">box-a (adaptive, home box)</option><option value="box-b">box-b (adaptive, home box)</option></select>
            </div>
            <div class="field">
              <label for="rng-load">Demo traffic <b id="load-val">0</b> req/s</label>
              <input type="range" id="rng-load" min="0" max="40" step="1" value="0">
              <div class="quick"><button data-rps="0">Off</button><button data-rps="8">Light</button><button data-rps="15">Busy</button><button data-rps="25">Heavy</button></div>
            </div>
          </div>
          <div class="card">
            <div class="card-head"><h2>Events</h2><span class="muted" id="ev-count"></span></div>
            <ol class="events" id="events"><li class="muted">Switches, failovers and demo actions show up here. Each action says if it was a real job or simulated.</li></ol>
          </div>
        </div>
      </section>

      <aside class="chat" aria-label="Forecast assistant">
        <div class="chat-head">
          <h2>Forecast assistant</h2>
          <span class="muted" id="chat-mode"></span>
        </div>
        <div class="msgs" id="msgs">
          <div class="msg bot intro">
            <p>Ask for a forecast anywhere, or drive the demo. Each answer shows which box served it, and whether the numbers are simulated or from the real model.</p>
          </div>
        </div>
        <div class="chips" id="chips">
          <button>Weather in Chicago next 48 hours</button>
          <button>Ensemble range for Tokyo, 3 days</button>
          <button>Which box is serving right now?</button>
          <button>Start a training job on box B</button>
          <button>Fail box A</button>
          <button>Recover box B</button>
        </div>
        <form class="composer" id="composer">
          <textarea id="input" rows="1" placeholder="Ask about the weather or the cluster…" aria-label="Message"></textarea>
          <button type="submit" id="send" aria-label="Send"><svg viewBox="0 0 24 24"><path d="M3 11l18-8-8 18-2-8-8-2z" fill="currentColor"/></svg></button>
        </form>
      </aside>
    </main>
    <script src="static/app.js"></script>
    </body>
    </html>
  ui-app-js: |
    // wxrouter Control Room: polls /api/overview once a second, draws the dashboard, runs the chat.
    // A revised copy of ui/static/app.js: it also says what is simulated and what is real, runs the real
    // fine-tune job and the real kill on boxes whose supervisor is known, and draws no rain when rain is unknown.
    "use strict";

    const $ = (s, el = document) => el.querySelector(s);
    const BOXES = ["box-a", "box-b"];
    const WINDOW_S = 60;
    const POLICY_HINT = {
      static: "Everything goes to box-a. The other box is used only if box-a fails.",
      round_robin: "Takes turns. Keeps sending half the traffic even to a slow box.",
      least_loaded: "Sends each request to the box with the fewest in flight.",
      adaptive: "One active box. Switches only when the other is clearly faster, then cools down.",
      balanced: "Both boxes in play. Each request goes by health score: GPU time, active requests, health-check ms, errors, recent work.",
    };
    const SIM_NOTE = "Simulated boxes: forecast numbers are made up by the mock.";

    const state = {
      reqs: [], lastT: null, routerNow: 0, clockOffset: 0,
      overview: null, seenSwitches: new Set(), health: {}, events: [],
      chat: [], busy: false, ok: null,
      sim: {},      // box -> the last answer of its /health that told mock from real (kept while the box is down)
      job: {},      // box -> the last state seen of its real fine-tune job
      pending: {},  // "box:train" / "box:kill" -> true while that request is on its way
    };

    function css(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
    function esc(s) { return String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])); }
    function fmtMs(v) { return v == null ? "–" : v >= 1000 ? `${(v / 1000).toFixed(1)}<small>s</small>` : `${Math.round(v)}<small>ms</small>`; }
    function clock(ts) { return new Date(ts * 1000).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" }); }
    function isNum(v) { return typeof v === "number" && Number.isFinite(v); }
    function nowS() { return Date.now() / 1000; }
    function shortVersion(v) { v = String(v ?? ""); return v.length > 18 ? v.slice(0, 17) + "…" : v; }

    async function api(path, body) {
      const r = await fetch(path, body === undefined ? {} : {
        method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body),
      });
      if (!r.ok) throw new Error(`${r.status} ${await r.text()}`);
      return r.json();
    }

    // ------------------------------------------------------------------ box cards
    function buildBoxes() {
      $("#boxes").innerHTML = BOXES.map(b => `
        <div class="card box" id="card-${b}" style="--c: var(--${b === "box-a" ? "a" : "b"})">
          <div class="box-top">
            <div class="box-name"><span class="dot" data-k="dot"></span>${b}<span class="tag" data-k="pref" hidden>preferred</span></div>
            <div class="box-tags"><span class="tag" data-k="sim" hidden></span><span class="tag" data-k="mode">–</span><span class="tag active" data-k="active" hidden>ACTIVE</span></div>
          </div>
          <div class="box-grid">
            <div><div class="share" data-k="share">–</div><div class="share-l">of traffic, last 10 s · p95 <span data-k="p95">–</span></div></div>
            <div class="meters">
              <div><div class="meter-l"><span>Queue + in flight</span><span data-k="q">–</span></div><div class="bar" data-k="qbar"><i></i></div></div>
              <div><div class="meter-l"><span>GPU</span><span data-k="gpu">–</span></div><div class="bar" data-k="gbar"><i></i></div></div>
              <div class="meter-l"><span>Probe compute</span><span data-k="probe">–</span></div>
              <div class="meter-l" data-k="scorebox" title=""><span>Health score <small>(lower = better)</small></span><b data-k="score">–</b></div>
              <div class="score-parts" data-k="parts"></div>
            </div>
          </div>
          <div class="job-line" data-k="job" hidden></div>
          <div class="box-actions five">
            <button data-mode="normal" title="Turn off the simulated slow or fail mode">Normal</button><button data-mode="slow" title="Simulated: the box's test hook makes it 3× slower. No job runs.">Slow (sim)</button><button data-mode="error" title="Simulated: the box's test hook answers 503. Nothing is killed.">Fail (sim)</button><button data-act="train" class="real" title="Real job: the fine-tune run on this box, through its supervisor">Fine-tune</button><button data-act="kill" class="real" title="Real: kills the forecast server process. Its supervisor starts it again by itself.">Kill server</button>
          </div>
        </div>`).join("");
      for (const b of BOXES) {
        const card = $(`#card-${b}`);
        card.querySelectorAll("button[data-mode]").forEach(btn =>
          btn.addEventListener("click", () => setMode(b, btn.dataset.mode)));
        card.querySelector('button[data-act="train"]').addEventListener("click", () => trainClick(b));
        card.querySelector('button[data-act="kill"]').addEventListener("click", () => killClick(b));
      }
    }

    // The supervisor's answer for a box: undefined = the box has no supervisor (simulated buttons),
    // null = it has one but it did not answer, else {finetune, forecast}.
    function stackOf(box) {
      const stacks = (state.overview && state.overview.stacks) || {};
      return Object.prototype.hasOwnProperty.call(stacks, box) ? stacks[box] : undefined;
    }

    // Simulated: the box's /admin/mode test hook.
    async function setMode(box, mode) {
      try {
        const res = await api(`api/box/${box}/mode`, { mode, slow_factor: 3 });
        if (res && res.error) addEvent(nowS(), "fail", `Simulated: couldn't change <b>${box}</b>: ${esc(res.error)}`);
        else addEvent(nowS(), "demo", `Simulated: <b>${box}</b> set to ${mode === "slow" ? "training (3× slower)" : mode}`);
        poll();
      } catch (e) { addEvent(nowS(), "fail", `Couldn't change ${box}: ${esc(e.message)}`); }
    }

    // Real job: start the fine-tune run of a box, or stop it when it runs.
    async function trainClick(box) {
      const key = `${box}:train`;
      if (state.pending[key]) return;
      const sk = stackOf(box), ft = sk && sk.finetune;
      const action = ft && ft.state === "running" ? "stop" : "start";
      state.pending[key] = true;
      try {
        const res = await api(`api/box/${box}/train`, { action });
        if (res && res.error) {
          addEvent(nowS(), "fail", `Real job: fine-tune on <b>${box}</b> did not ${action}: ${esc(res.error)}`);
        } else {
          const st = res && res.status && res.status.state;
          if (st) state.job[box] = st;
          addEvent(nowS(), "demo", action === "start"
            ? `Real job: fine-tune started on <b>${box}</b>`
            : `Real job: fine-tune on <b>${box}</b> stopped`);
        }
      } catch (e) {
        addEvent(nowS(), "fail", `Real job: couldn't ${action} the fine-tune on ${box}: ${esc(e.message)}`);
      } finally {
        state.pending[key] = false;
        poll();
      }
    }

    // Real: SIGKILL to the forecast server of a box. Its supervisor starts it again by itself.
    async function killClick(box) {
      const key = `${box}:kill`;
      if (state.pending[key]) return;
      state.pending[key] = true;
      try {
        const res = await api(`api/box/${box}/kill`, {});
        if (res && res.error) addEvent(nowS(), "fail", `Real job: forecast server on <b>${box}</b> was not killed: ${esc(res.error)}`);
        else addEvent(nowS(), "fail", `Real job: forecast server on <b>${box}</b> killed (a real crash, not simulated). Its supervisor restarts it by itself.`);
      } catch (e) {
        addEvent(nowS(), "fail", `Real job: couldn't kill the forecast server on ${box}: ${esc(e.message)}`);
      } finally {
        state.pending[key] = false;
        poll();
      }
    }

    // The line under the meters of a box with a supervisor.
    function jobText(sk, ft) {
      if (!sk) return "supervisor not reachable";
      if (!ft) return "fine-tune: this supervisor has no job named finetune";
      const prog = isNum(ft.step) && isNum(ft.total) ? `step ${ft.step}/${ft.total}` : null;
      const secs = isNum(ft.seconds) ? `${Math.round(ft.seconds)} s` : null;
      if (ft.state === "running") {
        const what = prog || (ft.last_line ? String(ft.last_line).slice(0, 60) : "starting");
        return "fine-tune: " + [what, prog ? ft.speed : null, secs].filter(Boolean).join(" · ");
      }
      if (ft.state === "done") return "fine-tune: done" + (prog ? ` (${prog})` : "") + (secs ? ` in ${secs}` : "");
      if (ft.state === "failed") {
        // The supervisor calls every run that did not exit with 0 "failed". A negative exit code is a signal: a stop.
        const stopped = isNum(ft.exit) && ft.exit < 0;
        return "fine-tune: " + (stopped ? "stopped" : `failed${isNum(ft.exit) ? ` (exit ${ft.exit})` : ""}`)
          + (prog ? ` at ${prog}` : "") + (ft.error ? ` · ${ft.error}` : "");
      }
      return "fine-tune: not started (real job, idle)";
    }

    function renderBoxes(ov) {
      const st = ov.router, m = ov.metrics;
      const total = m.overall.requests || 0;
      const health = ov.health || {};
      for (const b of BOXES) {
        const card = $(`#card-${b}`), k = n => card.querySelector(`[data-k="${n}"]`);
        const be = st.backends[b] || {}, bx = (ov.boxes || {})[b] || {}, pb = m.per_box[b] || {};
        const mode = bx.mode || (be.healthy ? "normal" : "unreachable");
        const training = mode === "slow" || mode === "training";   // the mock says "slow", the contract "training"
        card.classList.toggle("down", !be.healthy);
        k("dot").className = "dot " + (!be.healthy ? "bad" : training ? "warn" : "ok");
        const modeTag = k("mode");
        modeTag.textContent = !be.healthy ? "down" : training ? "training" : mode;
        modeTag.className = "tag " + (!be.healthy ? "downtag" : training ? "slow" : mode === "error" ? "error" : "");
        k("active").hidden = !(st.policy === "adaptive" && st.adaptive.active === b);
        k("pref").hidden = st.adaptive.preferred !== b;
        k("share").textContent = total ? `${Math.round(100 * (pb.requests || 0) / total)}%` : "–";
        k("p95").innerHTML = pb.p95_ms == null ? "–" : `${Math.round(pb.p95_ms)} ms`;
        const cap = bx.max_concurrency || 4, used = (bx.in_flight || 0) + (bx.queue_depth || 0);
        k("q").textContent = `${bx.in_flight ?? "–"} + ${bx.queue_depth ?? "–"} / ${cap}`;
        k("qbar").firstElementChild.style.width = `${Math.min(100, 100 * used / cap)}%`;
        k("qbar").classList.toggle("hot", used > cap);
        k("gpu").textContent = bx.gpu_util == null ? "–" : `${Math.round(100 * bx.gpu_util)}%`;
        k("gbar").firstElementChild.style.width = `${Math.round(100 * (bx.gpu_util || 0))}%`;
        k("probe").textContent = be.probe_ms == null ? "–" : `${Math.round(be.probe_ms)} ms`;
        const hs = be.health_score;
        if (hs) {
          const scores = BOXES.map(n => st.backends[n]?.health_score?.score).filter(v => v != null);
          k("score").textContent = Math.round(hs.score);
          k("score").style.color = be.healthy && hs.score === Math.min(...scores) ? "var(--ok)" : "";
          k("parts").textContent = `GPU ${hs.unit_ms} ms/unit · active ${hs.active} · health ${hs.health_ms} ms · errors ${Math.round(100 * hs.err_rate)}% · recent work ${Math.round(100 * hs.work_share)}%`;
        }
        card.querySelectorAll("button[data-mode]").forEach(btn => btn.classList.toggle("on", btn.dataset.mode === mode));

        // Simulated or real: from the box's own /health. Keep the last answer while the box is down.
        const hl = health[b];
        if (hl && hl.simulated != null) state.sim[b] = hl;
        const known = state.sim[b], simTag = k("sim");
        simTag.hidden = !known;
        if (known) {
          simTag.className = "tag " + (known.simulated ? "simtag" : "realtag");
          simTag.textContent = known.simulated ? "SIMULATED" : `REAL MODEL ${shortVersion(known.model_version)}`;
          simTag.title = `model_version: ${known.model_version ?? "?"}`;
        }

        // With a supervisor: the real fine-tune job and the real kill. Without one: the simulated buttons.
        const sk = stackOf(b), hasStack = sk !== undefined;
        const ft = sk && sk.finetune ? sk.finetune : null;
        const running = !!ft && ft.state === "running";
        // All five buttons are always shown. The two real ones need the box's supervisor (--stack).
        const trainBtn = card.querySelector('button[data-act="train"]'), killBtn = card.querySelector('button[data-act="kill"]');
        if (!hasStack) {
          trainBtn.disabled = killBtn.disabled = true;
          trainBtn.title = killBtn.title = "Needs this box's supervisor (serve/node_stack.py, given with --stack)";
        }
        const jobEl = k("job");
        jobEl.hidden = !hasStack;
        if (hasStack) {
          jobEl.textContent = jobText(sk, ft);
          jobEl.title = ft && ft.last_line ? String(ft.last_line) : "";
          const failed = !!ft && ft.state === "failed" && !(isNum(ft.exit) && ft.exit < 0);
          jobEl.className = "job-line" + (running ? " run" : failed || !sk ? " bad" : "");
          trainBtn.title = "Real job: the fine-tune run on this box, through its supervisor";
          killBtn.title = "Real: kills the forecast server process. Its supervisor starts it again by itself.";
          trainBtn.textContent = running ? "Stop tune" : "Fine-tune";
          trainBtn.classList.toggle("on", running);
          trainBtn.disabled = !ft || !!state.pending[`${b}:train`];
          killBtn.disabled = !sk || !!state.pending[`${b}:kill`];

          // A change of the job's state that this page did not ask for (it ended, or someone else started it).
          // While this page's own start or stop is on its way, that click writes the line.
          const prev = state.job[b], cur = ft ? ft.state : null;
          if (cur && prev !== undefined && prev !== cur && !state.pending[`${b}:train`]) {
            const stopped = isNum(ft.exit) && ft.exit < 0;
            if (cur === "running") addEvent(nowS(), "demo", `Real job: fine-tune is running on <b>${b}</b>`);
            else if (cur === "done") addEvent(nowS(), "demo", `Real job: fine-tune on <b>${b}</b> is done`);
            else if (cur === "failed") addEvent(nowS(), stopped ? "demo" : "fail", `Real job: fine-tune on <b>${b}</b> ${stopped ? "stopped" : "failed"}`);
          }
          if (cur) state.job[b] = cur;
        }

        if (state.health[b] !== undefined && state.health[b] !== be.healthy) {
          addEvent(nowS(), be.healthy ? "switch" : "fail",
            be.healthy ? `<b>${b}</b> is healthy again and rejoined` : `<b>${b}</b> marked down; traffic fails over`);
        }
        state.health[b] = be.healthy;
      }
      const pill = $("#pill-sim");
      if (pill) pill.hidden = !BOXES.some(b => state.sim[b] && state.sim[b].simulated);
    }

    // ------------------------------------------------------------------ model card
    function renderModel(m) {
      const note = $("#model-note"), badge = $("#model-badge"), grid = $("#model-grid");
      if (!m || !note || !badge || !grid) return;
      const set = (id, v) => { const el = $(id); if (el) el.textContent = v; };
      badge.hidden = !(m.available || m.simulated);
      badge.className = "tag " + (m.simulated ? "simtag" : "realtag");
      badge.textContent = m.simulated ? "SIMULATED" : "REAL MODEL";
      grid.hidden = !m.available;
      if (!m.available) {
        note.textContent = m.simulated ? SIM_NOTE
          : m.reason === "no_v1_info" ? "These boxes have no /v1/info, so the model is not known here."
          : "No box has answered /v1/info yet.";
        return;
      }
      set("#m-name", m.model ?? "–");
      set("#m-params", isNum(m.params_m) && m.params_m > 0 ? `${m.params_m.toFixed(1)} M` : "–");
      set("#m-device", m.device ?? "–");
      set("#m-latest", typeof m.latest === "string" && m.latest ? `${m.latest.replace("T", " ")}:00 UTC` : "–");
      set("#m-speed", isNum(m.ms_per_unit) ? `${m.ms_per_unit} ms per member-step${m.simulated ? " (emulated)" : ""}` : "not measured yet");
      note.textContent = (m.simulated ? SIM_NOTE + " " : "") + `From ${m.box ?? "a box"} /v1/info.`;
    }

    // ------------------------------------------------------------------ KPIs + controls
    function renderKpis(ov) {
      const o = ov.metrics.overall, st = ov.router;
      $("#k-rps").textContent = o.rps.toFixed(1);
      $("#k-p95").innerHTML = fmtMs(o.p95_ms);
      $("#k-p50").textContent = `p50 ${o.p50_ms == null ? "–" : Math.round(o.p50_ms) + " ms"}`;
      $("#k-p99").innerHTML = fmtMs(o.p99_ms);
      $("#k-err").textContent = o.errors;
      $("#k-err").style.color = o.errors ? "var(--err)" : "";
      $("#k-fo").textContent = `failovers ${o.failovers} · total ${st.failovers}`;
      $("#k-active").textContent = st.policy === "adaptive" ? st.adaptive.active : st.policy === "balanced" ? "both" : "spread";
      $("#k-pref").textContent = st.policy === "adaptive" ? `preferred ${st.adaptive.preferred || "none"}`
        : st.policy === "balanced" ? "by health score" : `rule ${st.policy}`;
      $("#pill-policy").textContent = `policy ${st.policy}`;
      const agent = ov.agent_mode === "offline" ? "agent offline (rules)" : `agent ${ov.agent_mode.replace("llm:", "")}`;
      $("#pill-agent").textContent = agent;
      $("#chat-mode").textContent = ov.agent_mode === "offline" ? "rule-based, no LLM configured" : ov.agent_mode.replace("llm:", "LLM: ");

      document.querySelectorAll("#seg-policy button").forEach(b => {
        b.classList.toggle("on", b.dataset.v === st.policy);
        b.setAttribute("aria-checked", b.dataset.v === st.policy);
      });
      $("#policy-hint").textContent = POLICY_HINT[st.policy] || "";
      const sel = $("#sel-pref");
      // "Both" = the balanced rule; a box = adaptive with that home box. Other rules: show "Both".
      if (document.activeElement !== sel) sel.value = st.policy === "adaptive" ? (st.adaptive.preferred || "") : "";
      if (document.activeElement !== $("#rng-load")) { $("#rng-load").value = ov.load_rps; $("#load-val").textContent = ov.load_rps; }

      for (const s of st.adaptive.switches) {
        const key = `${s.t}-${s.to}`;
        if (state.seenSwitches.has(key)) continue;
        state.seenSwitches.add(key);
        addEvent(state.clockOffset + s.t, "switch", `Switched <b>${esc(s.from)} → ${esc(s.to)}</b>: ${esc(s.reason)}`);
      }
    }

    function addEvent(ts, kind, html) {
      state.events.unshift({ ts, kind, html });
      state.events = state.events.slice(0, 60);
      $("#events").innerHTML = state.events.map(e =>
        `<li class="k-${e.kind}"><time>${clock(e.ts)}</time><span>${e.html}</span></li>`).join("");
      $("#ev-count").textContent = `${state.events.length}`;
    }

    // ------------------------------------------------------------------ charts
    function setupCanvas(c) {
      // Keep the CSS (logical) height in data-h: setting c.height below rewrites the attribute.
      if (!c.dataset.h) c.dataset.h = c.getAttribute("height");
      const dpr = window.devicePixelRatio || 1, w = c.clientWidth, h = +c.dataset.h;
      if (c.width !== Math.round(w * dpr) || c.height !== Math.round(h * dpr)) { c.width = Math.round(w * dpr); c.height = Math.round(h * dpr); c.style.height = h + "px"; }
      const g = c.getContext("2d");
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.clearRect(0, 0, w, h);
      return [g, w, h];
    }

    function drawChart() {
      const [g, w, h] = setupCanvas($("#chart"));
      const padL = 44, padB = 6, padT = 6, plotW = w - padL - 6, plotH = h - padT - padB;
      const lo = Math.log10(10), hi = Math.log10(10000), t0 = state.routerNow - WINDOW_S;
      const X = t => padL + (t - t0) / WINDOW_S * plotW;
      const Y = ms => padT + plotH - (Math.log10(Math.max(10, Math.min(10000, ms))) - lo) / (hi - lo) * plotH;
      g.font = "11px -apple-system, sans-serif"; g.textAlign = "right"; g.textBaseline = "middle";
      for (const v of [10, 30, 100, 300, 1000, 3000, 10000]) {
        g.strokeStyle = css("--line"); g.lineWidth = 1; g.beginPath(); g.moveTo(padL, Y(v)); g.lineTo(w - 6, Y(v)); g.stroke();
        g.fillStyle = css("--muted"); g.fillText(v >= 1000 ? `${v / 1000}s` : `${v}ms`, padL - 6, Y(v));
      }
      const col = { "box-a": css("--a"), "box-b": css("--b") };
      for (const r of state.reqs) {
        const x = X(r.t), y = Y(r.ms);
        if (r.status >= 500) {
          g.strokeStyle = css("--err"); g.lineWidth = 2; g.beginPath();
          g.moveTo(x - 4, y - 4); g.lineTo(x + 4, y + 4); g.moveTo(x + 4, y - 4); g.lineTo(x - 4, y + 4); g.stroke();
          continue;
        }
        g.globalAlpha = 0.75; g.fillStyle = col[r.box] || css("--muted");
        g.beginPath(); g.arc(x, y, 2.6, 0, Math.PI * 2); g.fill(); g.globalAlpha = 1;
        if (r.failover) { g.strokeStyle = css("--fo"); g.lineWidth = 1.5; g.beginPath(); g.arc(x, y, 5.5, 0, Math.PI * 2); g.stroke(); }
      }
      // share strip, one column per second
      const [s, sw, sh] = setupCanvas($("#share"));
      const bins = Array.from({ length: WINDOW_S }, () => ({ a: 0, b: 0, e: 0 }));
      for (const r of state.reqs) {
        const i = Math.floor(r.t - t0);
        if (i < 0 || i >= WINDOW_S) continue;
        if (r.status >= 500) bins[i].e++; else if (r.box === "box-a") bins[i].a++; else if (r.box === "box-b") bins[i].b++;
      }
      const bw = plotW / WINDOW_S;
      s.fillStyle = css("--panel-2"); s.fillRect(padL, 0, plotW, sh);
      bins.forEach((bn, i) => {
        const n = bn.a + bn.b + bn.e; if (!n) return;
        let y = 0; const x = padL + i * bw;
        for (const [v, c] of [[bn.a, css("--a")], [bn.b, css("--b")], [bn.e, css("--err")]]) {
          const hh = sh * v / n; s.fillStyle = c; s.fillRect(x + 0.5, y, Math.max(1, bw - 1), hh); y += hh;
        }
      });
      s.font = "11px -apple-system, sans-serif"; s.fillStyle = css("--muted"); s.textAlign = "right"; s.textBaseline = "middle";
      s.fillText("share", padL - 6, sh / 2);
    }

    // ------------------------------------------------------------------ polling
    async function poll() {
      try {
        const q = state.lastT == null ? "" : `?since=${state.lastT}`;
        const ov = await api(`api/overview${q}`);
        state.overview = ov;
        state.routerNow = ov.metrics.now;
        state.clockOffset = ov.ts - ov.metrics.now;
        if (state.lastT == null) state.lastT = Math.max(0, ov.metrics.now - WINDOW_S);
        const fresh = ov.metrics.requests || [];
        if (fresh.length) { state.reqs.push(...fresh); state.lastT = fresh[fresh.length - 1].t; }
        state.reqs = state.reqs.filter(r => r.t >= state.routerNow - WINDOW_S);
        setRouterPill(true);
        renderKpis(ov); renderBoxes(ov); drawChart();
        try { renderModel(ov.model); } catch (e) { console.error("model card:", e); }   // never blames the router
      } catch (e) {
        setRouterPill(false, e.message);
      }
    }
    function setRouterPill(ok, msg) {
      if (state.ok === ok) return;
      state.ok = ok;
      $("#pill-router").innerHTML = `<span class="dot ${ok ? "ok" : "bad"}"></span><span>${ok ? "Router connected" : "Router unreachable"}</span>`;
      if (!ok) $("#pill-router").title = msg || "";
    }

    // ------------------------------------------------------------------ chat
    function md(s) {
      return esc(s).replace(/\*\*(.+?)\*\*/g, "<b>$1</b>").replace(/\*(.+?)\*/g, "<i>$1</i>").replace(/\n/g, "<br>");
    }

    // ------------------------------------------------------------------ weather card
    function loadUnits() { try { return localStorage.getItem("wx-units") === "F" ? "F" : "C"; } catch { return "C"; } }
    function saveUnits(u) { try { localStorage.setItem("wx-units", u); } catch { /* storage blocked: keep in memory */ } }
    state.units = loadUnits();
    state.forecasts = new Map();  // card id -> forecast result, so a unit switch can re-render
    let fcSeq = 0;

    const T = c => c == null ? "–" : `${Math.round(state.units === "F" ? c * 9 / 5 + 32 : c)}°`;
    const Wind = ms => ms == null ? "–" : state.units === "F" ? `${Math.round(ms * 2.237)} mph` : `${Math.round(ms * 3.6)} km/h`;
    const Pct = v => v == null ? "–" : `${Math.round(v)}%`;
    const Rain = mm => mm == null ? "–" : `${(+mm).toFixed(1)} mm`;

    // Local time from the UTC valid time and longitude (solar time; good enough for day/night and labels).
    function local(vt, lon) { return new Date(Date.parse(vt) + lon / 15 * 3600e3); }
    const DAY = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    const hhmm = d => `${String(d.getUTCHours()).padStart(2, "0")}:00`;

    // What this forecast actually carries. The real AFNO model has no rain, humidity or cloud
    // output, so the card shows only what exists and never guesses the sky.
    function facts(r) {
      const any = k => (r.points || []).some(p => p[k] != null);
      return { cl: any("cl"), hum: any("hum"), pr: any("pr"), rain: r.summary?.precip_mm != null, sky: any("cl") || any("p") };
    }
    const Hpa = v => v == null ? "–" : `${Math.round(v)} hPa`;

    function condition(p, lon) {
      const h = local(p.vt, lon).getUTCHours(), night = h < 6 || h >= 18;
      if (p.cl == null && p.p == null) return { k: night ? "nighto" : "dayo", label: night ? "Night" : "Day", nosky: true };
      if (p.p != null && p.p >= 0.3) {
        if (p.t <= 0.5) return { k: "snow", label: "Snow" };
        return { k: "rain", label: p.p < 1 ? "Light rain" : "Rain" };
      }
      const cl = p.cl ?? 0;
      if (cl >= 75) return { k: "cloud", label: "Cloudy" };
      if (cl >= 35) return { k: night ? "pmoon" : "psun", label: "Partly cloudy" };
      return { k: night ? "moon" : "sun", label: night ? "Clear" : "Sunny" };
    }

    function icon(k, size = 28) {
      const sun = `<circle cx="12" cy="12" r="4.5" fill="#f5b301"/><g stroke="#f5b301" stroke-width="1.8" stroke-linecap="round">${[0, 45, 90, 135, 180, 225, 270, 315].map(a => { const r = a * Math.PI / 180; return `<line x1="${12 + 7 * Math.cos(r)}" y1="${12 + 7 * Math.sin(r)}" x2="${12 + 9.5 * Math.cos(r)}" y2="${12 + 9.5 * Math.sin(r)}"/>`; }).join("")}</g>`;
      const moon = `<path d="M15.5 3.5a8.5 8.5 0 1 0 5 15 7 7 0 0 1-5-15z" fill="#c9cfdb"/>`;
      const cloud = (dx = 0, dy = 0, fill = "#aeb6c4") => `<path transform="translate(${dx} ${dy})" d="M7 18h10a4 4 0 0 0 .5-7.97A5.5 5.5 0 0 0 7 9.5 4.25 4.25 0 0 0 7 18z" fill="${fill}"/>`;
      const drops = `<g stroke="#4c9bff" stroke-width="1.8" stroke-linecap="round"><line x1="9" y1="20" x2="8" y2="23"/><line x1="13" y1="20" x2="12" y2="23"/><line x1="17" y1="20" x2="16" y2="23"/></g>`;
      const flakes = `<g fill="#dfe8ff"><circle cx="8.5" cy="21.5" r="1.2"/><circle cx="12.5" cy="22.5" r="1.2"/><circle cx="16.5" cy="21.5" r="1.2"/></g>`;
      const body = {
        sun, moon, cloud: cloud(),
        // Outline sun/moon: time of day only, used when the model gives no sky data.
        dayo: `<circle cx="12" cy="12" r="4.5" fill="none" stroke="#9aa3b2" stroke-width="1.6"/><g stroke="#9aa3b2" stroke-width="1.4" stroke-linecap="round">${[0, 90, 180, 270].map(a => { const r = a * Math.PI / 180; return `<line x1="${12 + 7 * Math.cos(r)}" y1="${12 + 7 * Math.sin(r)}" x2="${12 + 9 * Math.cos(r)}" y2="${12 + 9 * Math.sin(r)}"/>`; }).join("")}</g>`,
        nighto: `<path d="M15.5 4a8 8 0 1 0 4.5 13.5 6.5 6.5 0 0 1-4.5-13.5z" fill="none" stroke="#9aa3b2" stroke-width="1.6"/>`,
        psun: `<g transform="translate(-3 -3) scale(.8)">${sun}</g>${cloud(2, 2)}`,
        pmoon: `<g transform="translate(-2 -3) scale(.75)">${moon}</g>${cloud(2, 2)}`,
        rain: `${cloud(0, -2, "#8f9aac")}${drops}`, snow: `${cloud(0, -2, "#aeb6c4")}${flakes}`,
      }[k] || cloud();
      return `<svg class="wx-ico" width="${size}" height="${size}" viewBox="0 0 24 24" aria-hidden="true">${body}</svg>`;
    }

    function unitToggle() {
      return `<div class="units" role="group" aria-label="Units">${["C", "F"].map(u =>
        `<button data-units="${u}" class="${state.units === u ? "on" : ""}" aria-pressed="${state.units === u}">°${u}</button>`).join("")}</div>`;
    }

    function stat(label, value) { return `<div class="wx-stat"><span>${label}</span><b>${value}</b></div>`; }

    function weatherCard(r, id) {
      const pts = r.points || []; if (!pts.length) return "";
      const now = pts[0], c = condition(now, r.lon), s = r.summary, f = facts(r);
      const steps = pts.filter(p => !p.i).slice(0, 12);
      const hasRain = s.precip_mm != null;
      return `<div class="wx" data-fc="${id}">
        <div class="wx-head">
          <div><div class="wx-place">${esc(r.place || `${r.lat.toFixed(2)}, ${r.lon.toFixed(2)}`)}</div>
            <div class="wx-sub">next ${r.hours_ahead} h · served by ${esc(r.served_by || "?")}</div></div>
          <div class="wx-tools">${unitToggle()}<button class="wx-max" data-open="${id}" aria-label="Open full forecast" title="Open full forecast"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></div>
        </div>
        <div class="wx-now">
          ${icon(c.k, 52)}
          <div><div class="wx-temp">${T(now.t)}</div><div class="wx-cond">${c.nosky ? "Temperature & wind (no sky data)" : c.label}</div><div class="wx-cond">H ${T(s.max_c)} · L ${T(s.min_c)}</div></div>
          <div class="wx-stats">${stat("Wind", Wind(now.w))}${f.hum ? stat("Humidity", Pct(now.hum)) : f.pr ? stat("Pressure", Hpa(now.pr)) : ""}${hasRain ? stat("Rain", Rain(s.precip_mm)) : ""}</div>
        </div>
        <div class="wx-strip">${steps.map(p => {
          const d = local(p.vt, r.lon), k = condition(p, r.lon).k;
          return `<div class="wx-step"><span>${d.getUTCHours() === 0 ? DAY[d.getUTCDay()] : hhmm(d)}</span>${icon(k, 26)}<b>${T(p.t)}</b></div>`;
        }).join("")}</div>
        ${s.ens_min_c != null ? `<div class="wx-note">Range across ${r.ensemble_members} ensemble members: ${T(s.ens_min_c)} to ${T(s.ens_max_c)}</div>` : ""}
        ${r.low_confidence ? `<div class="wx-warn">Beyond 72 h the model is less reliable.</div>` : ""}
      </div>`;
    }

    function dailyRows(r) {
      const days = new Map();
      r.points.forEach((p, i) => {
        const d = local(p.vt, r.lon), key = d.toISOString().slice(0, 10);
        if (!days.has(key)) days.set(key, { d, pts: [], idx: [] });
        days.get(key).pts.push(p); days.get(key).idx.push(i);
      });
      return [...days.values()].map(({ d, pts, idx }) => {
        const ts = pts.map(p => p.t), rain = pts.map(p => p.p).filter(v => v != null), hum = pts.map(p => p.hum).filter(v => v != null);
        const noon = pts.filter(p => !p.i).reduce((b, p) => Math.abs(local(p.vt, r.lon).getUTCHours() - 12) < Math.abs(local(b.vt, r.lon).getUTCHours() - 12) ? p : b, pts[0]);
        const worst = pts.some(p => condition(p, r.lon).k === "rain" || condition(p, r.lon).k === "snow") ? condition(pts.find(p => ["rain", "snow"].includes(condition(p, r.lon).k)), r.lon) : condition({ ...noon, vt: noon.vt }, r.lon);
        const ens = r.members_temp ? idx.flatMap(i => r.members_temp.map(m => m[i])).filter(v => v != null) : null;
        return { d, lo: Math.min(...ts), hi: Math.max(...ts), wind: Math.max(...pts.map(p => p.w)),
          rain: rain.length ? rain.reduce((a, b) => a + b, 0) : null, hum: hum.length ? hum.reduce((a, b) => a + b, 0) / hum.length : null,
          c: worst, ens: ens && ens.length ? [Math.min(...ens), Math.max(...ens)] : null, hours: pts.length };
      });
    }

    function fullForecast(r) {
      const days = dailyRows(r), s = r.summary, hasRain = s.precip_mm != null, f = facts(r);
      const gLo = Math.min(...days.map(d => d.ens ? d.ens[0] : d.lo)), gHi = Math.max(...days.map(d => d.ens ? d.ens[1] : d.hi));
      const pos = v => `${(100 * (v - gLo) / Math.max(1, gHi - gLo)).toFixed(1)}%`;
      const now = r.points[0], c = condition(now, r.lon);
      const steps = r.points.filter(p => !p.i);
      return `<div class="wxm-head">
          <div><h3>${esc(r.place || "Forecast")}</h3>
            <div class="wx-sub">${r.lat.toFixed(2)}, ${r.lon.toFixed(2)} · next ${r.hours_ahead} h · ${esc(r.model_version || "")} · served by <b>${esc(r.served_by || "?")}</b> in ${Math.round(r.latency_ms)} ms${r.failover ? " (failover)" : ""}</div></div>
          <div class="wx-tools">${unitToggle()}<button class="wxm-close" aria-label="Close">✕</button></div>
        </div>
        ${r.low_confidence ? `<div class="wx-warn">Beyond 72 h the model is less reliable. Treat later days as a rough guide.</div>` : ""}
        <div class="wxm-now">
          ${icon(c.k, 72)}
          <div><div class="wx-temp big">${T(now.t)}</div><div class="wx-cond">${c.nosky ? "No sky data from this model" : c.label} · next hour</div></div>
          <div class="wx-stats">${stat("Wind", Wind(now.w))}${f.hum ? stat("Humidity", Pct(now.hum)) : ""}${f.cl ? stat("Cloud", Pct(now.cl)) : ""}${f.pr ? stat("Pressure", Hpa(now.pr)) : ""}${hasRain ? stat("Rain total", Rain(s.precip_mm)) : stat("Rain", "not provided")}</div>
        </div>
        <h4>By day <span class="muted">(local solar time)</span></h4>
        <div class="wxm-days">${days.map(d => `
          <div class="wxm-day">
            <span class="dname">${DAY[d.d.getUTCDay()]}<small>${d.hours < 24 ? ` · ${d.hours} h` : ""}</small></span>
            ${icon(d.c.k, 30)}<span class="dcond">${d.c.label}</span>
            <span class="dlo">${T(d.lo)}</span>
            <span class="drange">${d.ens ? `<i class="ens" style="left:${pos(d.ens[0])};right:calc(100% - ${pos(d.ens[1])})"></i>` : ""}<i style="left:${pos(d.lo)};right:calc(100% - ${pos(d.hi)})"></i></span>
            <span class="dhi">${T(d.hi)}</span>
            <span class="dmeta">${Wind(d.wind)}${f.hum ? ` · ${Pct(d.hum)}` : ""}${hasRain ? ` · ${Rain(d.rain)}` : ""}</span>
          </div>`).join("")}</div>
        ${r.members_temp ? `<p class="muted">Lighter bar = range across ${r.ensemble_members} ensemble members.</p>` : ""}
        <h4>Every ${r.native_step_hours || 6} hours <span class="muted">(model steps)</span></h4>
        <div class="wxm-table-wrap"><table class="wxm-table">
          <thead><tr><th>Time</th><th>${f.sky ? "Conditions" : "Time of day"}</th><th>Temp</th><th>Wind</th>${f.hum ? "<th>Humidity</th>" : ""}${f.cl ? "<th>Cloud</th>" : ""}${f.pr ? "<th>Pressure</th>" : ""}${hasRain ? "<th>Rain</th>" : ""}</tr></thead>
          <tbody>${steps.map(p => { const d = local(p.vt, r.lon), k = condition(p, r.lon); return `<tr>
            <td>${DAY[d.getUTCDay()]} ${hhmm(d)}</td><td class="cond">${icon(k.k, 22)} ${k.label}</td><td><b>${T(p.t)}</b></td>
            <td>${Wind(p.w)}</td>${f.hum ? `<td>${Pct(p.hum)}</td>` : ""}${f.cl ? `<td>${Pct(p.cl)}</td>` : ""}${f.pr ? `<td>${Hpa(p.pr)}</td>` : ""}${hasRain ? `<td>${Rain(p.p)}</td>` : ""}</tr>`; }).join("")}</tbody>
        </table></div>
        <p class="muted">The model computes a value every ${r.native_step_hours || 6} hours. Hourly values in between are straight-line interpolations, so this table shows only the model steps.${hasRain ? "" : " This model run provides no rain data."}</p>`;
    }

    function openForecast(id) {
      const r = state.forecasts.get(id); if (!r) return;
      let m = $("#wx-modal");
      if (!m) {
        m = document.createElement("div"); m.id = "wx-modal"; m.className = "wxm"; m.setAttribute("role", "dialog"); m.setAttribute("aria-modal", "true");
        document.body.appendChild(m);
        m.addEventListener("click", e => { if (e.target === m || e.target.closest(".wxm-close")) closeForecast(); });
      }
      m.dataset.fc = id;
      m.innerHTML = `<div class="wxm-panel">${fullForecast(r)}</div>`;
      m.hidden = false; document.body.classList.add("modal-open");
      m.querySelector(".wxm-close").focus();
    }
    function closeForecast() { const m = $("#wx-modal"); if (m) { m.hidden = true; document.body.classList.remove("modal-open"); } }

    function setUnits(u) {
      if (u === state.units) return;
      state.units = u; saveUnits(u);
      document.querySelectorAll(".wx[data-fc]").forEach(el => { el.outerHTML = weatherCard(state.forecasts.get(el.dataset.fc), el.dataset.fc); });
      const m = $("#wx-modal"); if (m && !m.hidden) m.querySelector(".wxm-panel").innerHTML = fullForecast(state.forecasts.get(m.dataset.fc));
    }

    document.addEventListener("click", e => {
      const u = e.target.closest("[data-units]"); if (u) return setUnits(u.dataset.units);
      const o = e.target.closest("[data-open]"); if (o) return openForecast(o.dataset.open);
    });
    document.addEventListener("keydown", e => { if (e.key === "Escape") closeForecast(); });

    // Is this forecast from a mock? The answer's own model_version decides. null = not known.
    function forecastSimulated(r) {
      if (typeof r.simulated === "boolean") return r.simulated;
      return typeof r.model_version === "string" && r.model_version ? /mock/i.test(r.model_version) : null;
    }

    const REAL_TOOLS = ["start_finetune", "stop_finetune", "kill_forecast_server"];

    function renderSteps(steps) {
      if (!steps?.length) return "";
      return `<div class="steps">${steps.map(s => {
        const r = s.result || {};
        if (s.tool === "get_forecast" && r.served_by) {
          const sim = forecastSimulated(r);
          const chip = sim == null ? "" : `<span class="step ${sim ? "sim" : "real"}" title="model_version: ${esc(r.model_version)}">${sim ? "simulated data" : "real model"}</span>`;
          return `<span class="step ${esc(r.served_by)}">forecast · <b>${esc(r.served_by)}</b> · ${Math.round(r.latency_ms)} ms${r.failover ? " · failover" : ""}</span>${chip}`;
        }
        const kind = s.tool === "simulate_box" ? " · simulated" : REAL_TOOLS.includes(s.tool) ? " · real job" : "";
        return `<span class="step">${esc(s.tool)}${kind}${r.error ? " · error" : ""} · ${Math.round(s.ms)} ms</span>`;
      }).join("")}</div>`;
    }

    function addMsg(role, html) {
      const el = document.createElement("div");
      el.className = `msg ${role}`;
      el.innerHTML = html;
      $("#msgs").appendChild(el);
      $("#msgs").scrollTop = $("#msgs").scrollHeight;
      return el;
    }

    async function send(text) {
      text = text.trim();
      if (!text || state.busy) return;
      state.busy = true; $("#send").disabled = true;
      state.chat.push({ role: "user", content: text });
      addMsg("user", `<p>${esc(text)}</p>`);
      const pending = addMsg("bot", `<span class="typing"><i></i><i></i><i></i></span>`);
      try {
        const res = await api("api/chat", { messages: state.chat.slice(-12), units: state.units });
        state.chat.push({ role: "assistant", content: res.reply });
        const fc = (res.steps || []).find(s => s.tool === "get_forecast" && s.result?.points);
        let card = "";
        if (fc) { const id = `fc${++fcSeq}`; state.forecasts.set(id, fc.result); card = weatherCard(fc.result, id); }
        pending.innerHTML = `<p>${md(res.reply)}</p>${card}${renderSteps(res.steps)}${res.note ? `<div class="note">${esc(res.note)}</div>` : ""}`;
        for (const s of res.steps || []) {
          if (s.result?.error) continue;
          const box = s.args?.box, jobState = s.result?.status?.state;
          if (s.tool === "simulate_box") addEvent(nowS(), "demo", `Simulated: assistant set <b>${esc(box)}</b> to ${esc(s.args?.mode)}`);
          if (s.tool === "start_finetune") { if (jobState) state.job[box] = jobState; addEvent(nowS(), "demo", `Real job: assistant started the fine-tune on <b>${esc(box)}</b>`); }
          if (s.tool === "stop_finetune") { if (jobState) state.job[box] = jobState; addEvent(nowS(), "demo", `Real job: assistant stopped the fine-tune on <b>${esc(box)}</b>`); }
          if (s.tool === "kill_forecast_server") addEvent(nowS(), "fail", `Real job: assistant killed the forecast server on <b>${esc(box)}</b> (a real crash, not simulated). Its supervisor restarts it by itself.`);
          if (s.tool === "set_routing_policy") addEvent(nowS(), "demo", `Assistant changed rule to <b>${esc(s.args?.policy)}</b>`);
        }
        poll();
      } catch (e) {
        pending.innerHTML = `<p>Something went wrong: ${esc(e.message)}</p>`;
      } finally {
        state.busy = false; $("#send").disabled = false;
        $("#msgs").scrollTop = $("#msgs").scrollHeight;
      }
    }

    // ------------------------------------------------------------------ wiring
    function wire() {
      document.querySelectorAll("#seg-policy button").forEach(b => b.addEventListener("click", async () => {
        const preferred = b.dataset.v === "adaptive" ? ($("#sel-pref").value || "box-b") : b.dataset.v === "balanced" ? "" : undefined;
        await api("api/router/config", { policy: b.dataset.v, ...(preferred !== undefined ? { preferred } : {}) });
        state.seenSwitches.clear();
        addEvent(nowS(), "demo", `Rule changed to <b>${b.dataset.v}</b>`);
        poll();
      }));
      $("#sel-pref").addEventListener("change", async e => {
        const v = e.target.value;  // "" = Both → balanced rule; a box → adaptive with that home box
        await api("api/router/config", v ? { policy: "adaptive", preferred: v } : { policy: "balanced", preferred: "" });
        addEvent(nowS(), "demo", v ? `Preferred box set to <b>${esc(v)}</b> (adaptive)` : `Both boxes: <b>balanced</b> by health score`);
        poll();
      });
      let t;
      const setLoad = v => { $("#load-val").textContent = v; clearTimeout(t); t = setTimeout(() => api("api/load", { rps: +v }), 200); };
      $("#rng-load").addEventListener("input", e => setLoad(e.target.value));
      document.querySelectorAll(".quick button").forEach(b => b.addEventListener("click", () => {
        $("#rng-load").value = b.dataset.rps; setLoad(b.dataset.rps);
      }));
      $("#composer").addEventListener("submit", e => { e.preventDefault(); const v = $("#input").value; $("#input").value = ""; send(v); });
      $("#input").addEventListener("keydown", e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); $("#composer").requestSubmit(); } });
      $("#input").addEventListener("input", e => { e.target.style.height = "auto"; e.target.style.height = Math.min(120, e.target.scrollHeight) + "px"; });
      $("#chips").querySelectorAll("button").forEach(b => b.addEventListener("click", () => send(b.textContent)));
      window.addEventListener("resize", drawChart);
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", drawChart);
    }

    buildBoxes();
    wire();
    poll();
    setInterval(poll, 1000);
  ui-style-css: |
    :root {
      --bg: #f5f6f8; --panel: #ffffff; --panel-2: #f0f2f5; --line: #e2e5ea;
      --text: #15181d; --muted: #667080; --accent: #3b6cf6;
      --a: #1f9e89; --b: #8b5cf6; --err: #e5484d; --fo: #f59e0b; --ok: #1f9e60; --warn: #e8a317;
      --shadow: 0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.08);
      --radius: 12px;
      color-scheme: light;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0d1016; --panel: #151a22; --panel-2: #1c222c; --line: #262d39;
        --text: #e8ebf0; --muted: #8b95a5; --accent: #6b8cff;
        --a: #2fc4a8; --b: #a78bfa; --err: #ff6369; --fo: #fbbf24; --ok: #3ccf8e; --warn: #f5c04a;
        --shadow: none;
        color-scheme: dark;
      }
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; }
    body {
      background: var(--bg); color: var(--text);
      font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
    }
    button, input, select, textarea { font: inherit; color: inherit; }
    h2 { font-size: 13px; font-weight: 600; letter-spacing: .02em; text-transform: uppercase; color: var(--muted); margin: 0; }
    .muted { color: var(--muted); font-size: 12px; }

    /* top bar */
    .topbar {
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      padding: 12px 20px; background: var(--panel); border-bottom: 1px solid var(--line);
      position: sticky; top: 0; z-index: 5;
    }
    .brand { display: flex; align-items: center; gap: 10px; }
    .logo { width: 30px; height: 30px; color: var(--accent); }
    .brand-name { font-weight: 700; font-size: 16px; }
    .brand-sub { color: var(--muted); font-size: 12px; }
    .top-pills { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .pill {
      display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px;
      background: var(--panel-2); border: 1px solid var(--line); font-size: 12px; white-space: nowrap;
    }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); display: inline-block; }
    .dot.ok { background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 25%, transparent); }
    .dot.bad { background: var(--err); box-shadow: 0 0 0 3px color-mix(in srgb, var(--err) 25%, transparent); }
    .dot.warn { background: var(--warn); }

    /* layout */
    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 16px; padding: 16px 20px; height: calc(100vh - 59px); }
    .dash { overflow-y: auto; display: flex; flex-direction: column; gap: 16px; padding-right: 4px; min-width: 0; }
    .card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow); min-width: 0; }
    .card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; gap: 8px; }

    /* KPIs */
    .kpis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
    .kpi { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 14px; box-shadow: var(--shadow); }
    .kpi-label { color: var(--muted); font-size: 12px; }
    .kpi-value { font-size: 26px; font-weight: 650; font-variant-numeric: tabular-nums; margin-top: 2px; }
    .kpi-value small { font-size: 13px; color: var(--muted); font-weight: 500; margin-left: 2px; }
    .kpi-sub { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
    .kpi-active .kpi-value { font-size: 22px; }

    /* box cards */
    .boxes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .box { position: relative; border-left: 4px solid var(--c); transition: border-color .3s, opacity .3s; }
    .box.down { opacity: .75; border-left-color: var(--err); }
    .box-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .box-name { font-weight: 650; font-size: 16px; display: flex; align-items: center; gap: 8px; }
    .tag { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: var(--panel-2); border: 1px solid var(--line); color: var(--muted); }
    .tag.active { background: color-mix(in srgb, var(--c) 15%, transparent); color: var(--c); border-color: color-mix(in srgb, var(--c) 40%, transparent); }
    .tag.slow { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 40%, transparent); }
    .tag.error, .tag.downtag { color: var(--err); border-color: color-mix(in srgb, var(--err) 40%, transparent); }
    .box-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 14px; margin-top: 12px; align-items: end; }
    .share { font-size: 34px; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--c); line-height: 1; }
    .share-l { color: var(--muted); font-size: 12px; margin-top: 4px; }
    .meters { display: flex; flex-direction: column; gap: 8px; }
    .meter-l { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
    .bar { height: 6px; background: var(--panel-2); border-radius: 999px; overflow: hidden; margin-top: 3px; }
    .bar > i { display: block; height: 100%; background: var(--c); width: 0; transition: width .4s; border-radius: 999px; }
    .bar.hot > i { background: var(--warn); }
    .box-actions { display: flex; gap: 6px; margin-top: 14px; }
    .box-actions button, .quick button {
      flex: 1; padding: 6px 8px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel-2); cursor: pointer; font-size: 12px;
    }
    .box-actions button:hover, .quick button:hover { border-color: var(--accent); }
    .box-actions button.on { background: color-mix(in srgb, var(--c) 18%, transparent); border-color: var(--c); }
    .box-actions button[data-mode="error"].on { background: color-mix(in srgb, var(--err) 15%, transparent); border-color: var(--err); }
    .box-actions button[data-mode="slow"].on { background: color-mix(in srgb, var(--warn) 15%, transparent); border-color: var(--warn); }

    /* simulated or real, the real fine-tune job, the model card */
    [hidden] { display: none !important; }
    .box-tags { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    .tag.simtag, .pill.sim, .step.sim { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 45%, transparent); }
    .tag.simtag, .pill.sim { background: color-mix(in srgb, var(--warn) 12%, transparent); }
    .tag.realtag, .step.real { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 45%, transparent); }
    .tag.realtag { background: color-mix(in srgb, var(--ok) 12%, transparent); }
    .pill.sim { font-weight: 600; }
    .job-line { margin-top: 12px; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .job-line.run { color: var(--warn); }
    .job-line.bad { color: var(--err); }
    .job-line:not([hidden]) ~ .box-actions { margin-top: 8px; }
    .box-actions button:disabled { opacity: .5; cursor: default; }
    .box-actions button[data-act="train"].on { background: color-mix(in srgb, var(--warn) 15%, transparent); border-color: var(--warn); }
    .box-actions button[data-act="kill"]:hover:not(:disabled) { border-color: var(--err); }
    .model-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
    .model-v { font-size: 15px; font-weight: 650; font-variant-numeric: tabular-nums; margin-top: 2px; overflow-wrap: anywhere; }
    .model-card .hint { min-height: 0; }
    .model-card .hint:empty { display: none; }

    /* chart */
    .chart-card canvas { width: 100%; display: block; }
    #share { margin-top: 6px; border-radius: 6px; }
    .chart-foot { display: flex; justify-content: space-between; color: var(--muted); font-size: 11px; margin-top: 6px; gap: 8px; }
    .legend { display: flex; gap: 12px; font-size: 12px; color: var(--muted); flex-wrap: wrap; }
    .legend span { display: inline-flex; align-items: center; gap: 5px; }
    .sw { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .sw-a { background: var(--a); } .sw-b { background: var(--b); } .sw-err { background: var(--err); } .sw-fo { background: transparent; border: 2px solid var(--fo); }

    /* controls */
    .row2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
    .field { margin-bottom: 14px; }
    .field:last-child { margin-bottom: 0; }
    .field label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; }
    .seg { display: grid; grid-template-columns: repeat(5, 1fr); background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px; padding: 3px; gap: 3px; }
    .seg button { border: 0; background: transparent; padding: 7px 4px; border-radius: 7px; cursor: pointer; font-size: 12px; }
    .seg button.on { background: var(--panel); box-shadow: var(--shadow); font-weight: 600; color: var(--accent); outline: 1px solid var(--line); }
    .hint { color: var(--muted); font-size: 12px; margin: 6px 0 0; min-height: 17px; }
    select { width: 100%; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel-2); }
    input[type=range] { width: 100%; accent-color: var(--accent); }
    .quick { display: flex; gap: 6px; margin-top: 6px; }

    .score-parts { font-size: 11px; color: var(--muted); line-height: 1.35; }
    .meter-l small { font-weight: 400; }
    .events { list-style: none; margin: 0; padding: 0; max-height: 230px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; font-size: 12.5px; }
    .events li { display: grid; grid-template-columns: 58px 1fr; gap: 8px; }
    .events li.muted { display: block; }
    .events time { color: var(--muted); font-variant-numeric: tabular-nums; }
    .events .k-switch b { color: var(--accent); }
    .events .k-demo b { color: var(--warn); }
    .events .k-fail b { color: var(--err); }

    /* chat */
    .chat { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); display: flex; flex-direction: column; min-height: 0; box-shadow: var(--shadow); }
    .chat-head { padding: 14px 16px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .msgs { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
    .msg { max-width: 92%; padding: 10px 12px; border-radius: 12px; }
    .msg p { margin: 0; }
    .msg.user { align-self: flex-end; background: var(--accent); color: #fff; border-bottom-right-radius: 4px; }
    .msg.bot { align-self: flex-start; background: var(--panel-2); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
    .msg.bot.intro { color: var(--muted); }
    .msg .note { color: var(--warn); font-size: 12px; margin-top: 6px; }
    .steps { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .step { font-size: 11px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel); color: var(--muted); font-variant-numeric: tabular-nums; }
    .step b { color: var(--text); font-weight: 600; }
    .step.box-a { border-color: color-mix(in srgb, var(--a) 50%, transparent); }
    .step.box-b { border-color: color-mix(in srgb, var(--b) 50%, transparent); }
    /* weather card */
    .wx { margin-top: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 12px; }
    .wx-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
    .wx-place { font-weight: 650; font-size: 15px; }
    .wx-sub { color: var(--muted); font-size: 12px; }
    .wx-tools { display: flex; gap: 6px; align-items: center; }
    .units { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
    .units button { border: 0; background: transparent; padding: 3px 8px; cursor: pointer; font-size: 12px; color: var(--muted); }
    .units button.on { background: var(--accent); color: #fff; }
    .wx-max, .wxm-close { border: 1px solid var(--line); background: var(--panel-2); border-radius: 8px; width: 28px; height: 26px; display: grid; place-items: center; cursor: pointer; color: var(--muted); }
    .wx-max:hover, .wxm-close:hover { color: var(--accent); border-color: var(--accent); }
    .wx-now { display: grid; grid-template-columns: auto 1fr auto; gap: 10px; align-items: center; margin: 10px 0 8px; }
    .wx-temp { font-size: 34px; font-weight: 650; line-height: 1; font-variant-numeric: tabular-nums; }
    .wx-temp.big { font-size: 52px; }
    .wx-cond { color: var(--muted); font-size: 12.5px; margin-top: 4px; }
    .wx-stats { display: grid; gap: 4px 12px; grid-template-columns: auto auto; font-size: 12px; }
    .wx-stat { display: contents; }
    .wx-stat span { color: var(--muted); }
    .wx-stat b { font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }
    .wx-strip { display: flex; gap: 4px; overflow-x: auto; padding: 6px 0 2px; border-top: 1px solid var(--line); scrollbar-width: thin; }
    .wx-step { flex: 0 0 auto; min-width: 46px; display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 11.5px; padding: 4px 2px; }
    .wx-step span { color: var(--muted); }
    .wx-step b { font-variant-numeric: tabular-nums; }
    .wx-note { font-size: 12px; color: var(--muted); margin-top: 6px; }
    .wx-warn { font-size: 12px; color: var(--warn); margin-top: 6px; }
    .wx-ico { flex: 0 0 auto; display: block; }

    /* maximized forecast */
    .wxm { position: fixed; inset: 0; background: rgba(5, 8, 14, .55); backdrop-filter: blur(3px); z-index: 50; display: grid; place-items: center; padding: 20px; }
    .wxm[hidden] { display: none; }
    body.modal-open { overflow: hidden; }
    .wxm-panel { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; width: min(920px, 100%); max-height: calc(100vh - 40px); overflow-y: auto; padding: 22px 24px; box-shadow: 0 20px 60px rgba(0,0,0,.35); }
    .wxm-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
    .wxm-head h3 { margin: 0; font-size: 22px; }
    .wxm-now { display: grid; grid-template-columns: auto auto 1fr; gap: 18px; align-items: center; margin: 18px 0 8px; padding: 14px 16px; background: var(--panel-2); border-radius: 12px; }
    .wxm-now .wx-stats { justify-self: end; grid-template-columns: auto auto auto auto; gap: 4px 14px; font-size: 13px; }
    .wxm-panel h4 { margin: 18px 0 8px; font-size: 13px; text-transform: uppercase; letter-spacing: .02em; color: var(--muted); }
    .wxm-days { display: flex; flex-direction: column; }
    .wxm-day { display: grid; grid-template-columns: 74px 34px 110px 44px minmax(80px, 1fr) 44px 190px; gap: 10px; align-items: center; padding: 8px 4px; border-bottom: 1px solid var(--line); font-variant-numeric: tabular-nums; }
    .wxm-day:last-child { border-bottom: 0; }
    .dname { font-weight: 600; } .dname small { color: var(--muted); font-weight: 400; }
    .dcond { color: var(--muted); font-size: 12.5px; }
    .dlo { color: var(--muted); text-align: right; } .dhi { font-weight: 600; }
    .drange { position: relative; height: 6px; background: var(--panel-2); border-radius: 999px; }
    .drange i { position: absolute; top: 0; bottom: 0; border-radius: 999px; background: linear-gradient(90deg, #4c9bff, #f5b301); }
    .drange i.ens { background: var(--line); top: -2px; bottom: -2px; }
    .dmeta { color: var(--muted); font-size: 12.5px; text-align: right; }
    .wxm-table-wrap { overflow-x: auto; }
    .wxm-table { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; }
    .wxm-table th { text-align: left; color: var(--muted); font-weight: 500; font-size: 12px; padding: 6px 8px; border-bottom: 1px solid var(--line); }
    .wxm-table td { padding: 6px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
    .wxm-table td.cond { display: flex; align-items: center; gap: 6px; }
    @media (max-width: 760px) {
      .wxm { padding: 0; place-items: stretch; }
      .wxm-panel { border-radius: 0; width: 100%; max-height: none; height: 100dvh; padding: 16px; }
      .wxm-now { grid-template-columns: auto 1fr; }
      .wxm-now .wx-stats { grid-column: 1 / -1; justify-self: stretch; grid-template-columns: auto auto; }
      .wxm-day { grid-template-columns: 82px 30px 40px minmax(50px, 1fr) 40px; }
      .dname { white-space: nowrap; }
      .wxm-day .dcond, .wxm-day .dmeta { display: none; }
    }
    .typing { display: inline-flex; gap: 4px; }
    .typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: blink 1.2s infinite; }
    .typing i:nth-child(2) { animation-delay: .2s; } .typing i:nth-child(3) { animation-delay: .4s; }
    @keyframes blink { 0%, 80%, 100% { opacity: .25; } 40% { opacity: 1; } }
    .chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 16px 10px; }
    .chips button { font-size: 12px; padding: 5px 10px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel-2); cursor: pointer; }
    .chips button:hover { border-color: var(--accent); color: var(--accent); }
    .composer { display: flex; gap: 8px; padding: 12px 16px 16px; border-top: 1px solid var(--line); }
    .composer textarea { flex: 1; resize: none; border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; background: var(--panel-2); max-height: 120px; outline: none; }
    .composer textarea:focus { border-color: var(--accent); }
    .composer button { width: 40px; border-radius: 10px; border: 0; background: var(--accent); color: #fff; cursor: pointer; display: grid; place-items: center; }
    .composer button svg { width: 18px; height: 18px; }
    .composer button:disabled { opacity: .5; cursor: default; }

    /* responsive */
    @media (max-width: 1180px) {
      .layout { grid-template-columns: 1fr; height: auto; }
      .chat { height: 640px; }
      .dash { overflow: visible; }
    }
    @media (max-width: 760px) {
      .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .model-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .boxes, .row2 { grid-template-columns: 1fr; }
      .layout { padding: 12px; }
      .topbar { padding: 10px 12px; }
      .brand-sub { display: none; }
    }

    /* five actions per box: three simulated, two real (need the supervisor) */
    .box-actions.five { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
    .box-actions.five button { padding: 6px 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .box-actions button.real { border-style: solid; font-weight: 600; }
    .box-actions button:disabled { opacity: .45; cursor: not-allowed; }
    @media (max-width: 760px) { .box-actions.five { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
services:
  box-a:
    image:
      uri: docker://python:3.12-slim
    files:
      /app/contract.py: file://contract-py
      /app/mock_server.py: file://mock-server-py
    script: |
      #!/bin/sh
      set -e
      echo "[box-a] host=$(hostname) ip=$(hostname -i 2>/dev/null || true)"
      pip install --quiet --no-cache-dir --disable-pip-version-check fastapi uvicorn httpx pydantic
      cd /app
      exec python mock_server.py --name box-a --host 0.0.0.0 --port 8001 --seed 1
    resource:
      cpu:
        cores: 2
      memory:
        size: 2GB
    network:
      ports:
        - name: http
          port: 8001
          protocol: tcp
  box-b:
    image:
      uri: docker://python:3.12-slim
    files:
      /app/contract.py: file://contract-py
      /app/mock_server.py: file://mock-server-py
    script: |
      #!/bin/sh
      set -e
      echo "[box-b] host=$(hostname) ip=$(hostname -i 2>/dev/null || true)"
      pip install --quiet --no-cache-dir --disable-pip-version-check fastapi uvicorn httpx pydantic
      cd /app
      exec python mock_server.py --name box-b --host 0.0.0.0 --port 8002 --seed 2
    resource:
      cpu:
        cores: 2
      memory:
        size: 2GB
    network:
      ports:
        - name: http
          port: 8002
          protocol: tcp
  router:
    image:
      uri: docker://python:3.12-slim
    files:
      /app/router.py: file://router-py
    depends-on:
      - name: box-a
        status: RUNNING
      - name: box-b
        status: RUNNING
    script: |
      #!/bin/sh
      set -e
      pip install --quiet --no-cache-dir --disable-pip-version-check fastapi uvicorn httpx pydantic
      # Show how the boxes resolve from here; useful if routing fails.
      for h in box-a box-b; do echo "[router] $h -> $(getent hosts $h || echo unresolved)"; done
      cd /app
      exec python router.py --host 0.0.0.0 --port 8000 --policy adaptive --preferred box-b \
        --backend box-a=http://box-a:8001 --backend box-b=http://box-b:8002
    resource:
      cpu:
        cores: 1
      memory:
        size: 1GB
    network:
      ports:
        - name: http
          port: 8000
          protocol: tcp
  ui:
    image:
      uri: docker://python:3.12-slim
    files:
      /app/ui/server.py: file://ui-server-py
      /app/ui/agent.py: file://ui-agent-py
      /app/ui/static/index.html: file://ui-index-html
      /app/ui/static/app.js: file://ui-app-js
      /app/ui/static/style.css: file://ui-style-css
    depends-on:
      - name: router
        status: RUNNING
    script: |
      #!/bin/sh
      set -e
      pip install --quiet --no-cache-dir --disable-pip-version-check fastapi uvicorn httpx pydantic
      cd /app/ui
      exec python server.py --host 0.0.0.0 --port 8080 --router http://router:8000 \
        --box box-a=http://box-a:8001 --box box-b=http://box-b:8002
    resource:
      cpu:
        cores: 1
      memory:
        size: 1GB
    network:
      ports:
        - name: http
          port: 8080
          protocol: tcp
      endpoints:
        - name: control-room
          port-name: http
          protocol: http
jobs:
  hold:
    image:
      uri: docker://python:3.12-slim
    command: ["sleep", "14400"]
    depends-on:
      - name: ui
        status: RUNNING
    resource:
      cpu:
        cores: 1
      memory:
        size: 256MB
