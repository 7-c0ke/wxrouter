  inference-init-py: |
    """GPU inference subsystem for wxrouter.

      model.py     tiny autoregressive forecast net; weights + numpy/torch backends
      engine.py    batching, concurrency, warm-up, timeouts, retries
      metrics.py   p50/p95/p99, throughput, error rate, JSON snapshot for the router
      gpu.py       GPU utilisation and memory (nvidia-smi / torch)
      forecast.py  contract.ForecastRequest <-> model rows
      server.py    real forecast server implementing API.md (drop-in for mock_server.py)
      bench.py     cold/warm, batch and concurrency benchmark -> JSON

    Run from the repo root: `python -m inference.server`, `python -m inference.bench`.
    """
    from .config import EngineConfig
    from .engine import InferenceEngine, InferenceError, InferenceTimeout, Overloaded

    __all__ = ["EngineConfig", "InferenceEngine", "InferenceError", "InferenceTimeout", "Overloaded"]
  inference-afno-py: |
    """Serve the weather team's trained AFNO model through the inference engine.

    This is the adapter between two pieces that already exist:

      weather/forecast_core.py   the model, the stored analyses, ensemble noise, units
      serve/forecast_server.py   to_v1(): the team's own API.md response builder

    and the engine in this package, which adds batching across requests, timeouts,
    retries and the metrics document. A row is one ensemble member's starting state
    (20, 120, 240); `aux` carries each row's (lat, lon); one step is 6 hours.

      python -m inference.server --model afno --weights /wx/bundle/weights/afno_event.pt --data /wx/bundle

    Needs PyTorch, NumPy and NVIDIA PhysicsNeMo, like the team's server.
    """
    from __future__ import annotations

    import hashlib
    import os
    import sys
    import time
    from pathlib import Path

    import numpy as np

    from .model import sort_by_horizon, unsort

    ROOT = Path(os.environ.get("WX_REPO") or Path(__file__).resolve().parent.parent)  # where weather/ and serve/ are
    for _p in (ROOT / "weather", ROOT / "serve"):
        if str(_p) not in sys.path:
            sys.path.insert(0, str(_p))

    STEP_HOURS = 6


    class AfnoBackend:
        """Engine backend around forecast_core.Forecaster. Batches rows from different requests."""

        name = "afno"

        def __init__(self, weights: str | None = None, data_dir: str | None = None, device: str = "auto",
                     forecaster=None):
            import forecast_core
            import torch

            self.core, self.torch = forecast_core, torch
            self.fc = forecaster or forecast_core.Forecaster(weights, data_dir, device)
            self.device = str(self.fc.device).split(":")[0]
            self.device_name = torch.cuda.get_device_name(0) if self.device == "cuda" else self.device
            self.precision = "bf16-autocast" if self.device == "cuda" else "fp32"
            self.model_version = "afno-19m"
            if weights:
                digest = hashlib.sha256()
                with open(weights, "rb") as f:
                    for block in iter(lambda: f.read(1 << 20), b""):
                        digest.update(block)
                self.model_version = f"afno-19m-{digest.hexdigest()[:12]}"  # same naming as serve/forecast_server.py

        def warmup_input(self):
            shape = self.core.STATE_SHAPE
            return np.zeros((1, *shape), np.float32), 1, np.zeros((1, 2), np.float32)

        def rollout(self, x: np.ndarray, steps: int, row_steps=None, aux=None) -> np.ndarray:
            """x (rows, 20, 120, 240) z-scores, aux (rows, 2) lat/lon -> z at each row's place, (rows, steps, 20)."""
            torch, core = self.torch, self.core
            order, live = sort_by_horizon(row_steps, steps, x.shape[0])
            if order is not None:
                x, aux = x[order], aux[order]
            rows = x.shape[0]
            corners = [core.grid_weights(float(lat), float(lon)) for lat, lon in aux]
            dev = self.fc.device
            ii = torch.tensor([[c[0] for c in cs] for cs in corners], device=dev)
            jj = torch.tensor([[c[1] for c in cs] for cs in corners], device=dev)
            ww = torch.tensor([[c[2] for c in cs] for cs in corners], dtype=torch.float32, device=dev)
            rr = torch.arange(rows, device=dev)[:, None]
            t = torch.from_numpy(np.ascontiguousarray(x, dtype=np.float32)).to(dev)
            kept = torch.zeros((rows, steps, x.shape[1]), dtype=torch.float32, device=dev)
            try:
                with torch.inference_mode():
                    for s in range(steps):
                        n = live[s]
                        if n < t.shape[0]:
                            t = t[:n]  # rows whose forecast has ended drop out of the batch
                        if self.device == "cuda":
                            with torch.autocast("cuda", dtype=torch.bfloat16):
                                out = self.fc.model(t)
                        else:
                            out = self.fc.model(t)
                        t = out.float()  # cast and feed back, as in training and in forecast_core.rollout_point
                        vals = t[rr[:n], :, ii[:n], jj[:n]]  # (n, 4 corners, channels)
                        kept[:n, s] = (vals * ww[:n, :, None]).sum(dim=1)
                return unsort(kept.cpu().numpy(), order)
            except torch.OutOfMemoryError:
                torch.cuda.empty_cache()
                raise

        def memory(self) -> dict:
            if self.device != "cuda":
                return {}
            cuda, mb = self.torch.cuda, 1024 * 1024
            return {"allocated_mb": round(cuda.memory_allocated() / mb, 1),
                    "reserved_mb": round(cuda.memory_reserved() / mb, 1),
                    "peak_allocated_mb": round(cuda.max_memory_allocated() / mb, 1)}

        def reset_peak_memory(self) -> None:
            if self.device == "cuda":
                self.torch.cuda.reset_peak_memory_stats()


    class AfnoService:
        """Turns an API.md request into engine rows and the engine's output into the API.md response."""

        def __init__(self, backend: AfnoBackend):
            import forecast_server  # the team's server: only its response builder is used

            self.backend, self.core, self.fs = backend, backend.core, forecast_server

        def prepare(self, req: dict):
            """-> (x, steps, aux, ctx). Raises LookupError when the server holds no analysis to start from."""
            store = self.backend.fc.store
            when = store.latest()
            state = store.get(when) if when is not None else None
            if state is None:
                raise LookupError("no analysis is held; put state files in the data folder's states/")
            members = req.get("ensemble_members", 1)
            steps = (req["hours_ahead"] + STEP_HOURS - 1) // STEP_HOURS
            x = self.core.perturbed_states(state, when, range(members))
            aux = np.tile(np.array([[req["lat"], req["lon"]]], np.float32), (members, 1))
            return x, steps, aux, {"when": when, "state": state, "steps": steps, "t0": time.perf_counter()}

        def respond(self, req: dict, z: np.ndarray, ctx: dict, box: str, timing: dict) -> dict:
            fc, members = self.backend.fc, req.get("ensemble_members", 1)
            series = self.core.point_series(z, 0, fc.mean, fc.std, detail=True)
            each = series.pop("_members")
            start = self.core.start_values(ctx["state"], req["lat"], req["lon"], fc.mean, fc.std)
            answer = {"node": box, "init_time": self.fs.time_text(ctx["when"]), "members": members, "member_offset": 0,
                      "point": {"lat": req["lat"], "lon": req["lon"], **series}, "units": members * ctx["steps"],
                      "timing_ms": {"queue": timing["queue_ms"], "gpu": timing["compute_ms"],
                                    "total": round((time.perf_counter() - ctx["t0"]) * 1000, 2)}}
            asked = {"hours_ahead": req["hours_ahead"], "step_hours": req.get("step_hours", 1),
                     "request_id": req.get("request_id")}
            return self.fs.to_v1(answer, asked, ctx["when"], start, each, self.backend.model_version)
  inference-afno-check-py: |
    """Check and time the trained AFNO model behind the inference engine, on one GPU.

    Starts two servers on this machine, one after the other, with the same weights:

      team      serve/forecast_server.py   (the weather team's server, one request at a time)
      engine    inference.server --model afno   (this package: batches rows across requests)

    For each it sends the same forecasts and compares the answers, then measures
    latency and throughput with 1 and N clients at once. Only httpx is needed here;
    the servers need PyTorch and PhysicsNeMo.

      python -m inference.afno_check --weights /wx/bundle/weights/afno_event.pt --data /wx/bundle --repo /wx/repo
    """
    from __future__ import annotations

    import argparse
    import asyncio
    import json
    import os
    import subprocess
    import sys
    import time
    from datetime import UTC, datetime
    from pathlib import Path

    import httpx

    HERE = Path(__file__).resolve().parent.parent
    BEGIN, END = "===WXROUTER_AFNO_JSON_BEGIN===", "===WXROUTER_AFNO_JSON_END==="
    CHECKS = [{"lat": 41.98, "lon": -87.9, "hours_ahead": 48, "step_hours": 6},
              {"lat": -33.87, "lon": 151.21, "hours_ahead": 120, "step_hours": 6, "ensemble_members": 4},
              {"lat": 64.1, "lon": -21.9, "hours_ahead": 20, "step_hours": 1}]
    LOAD = {"lat": 37.77, "lon": -122.42, "hours_ahead": 48, "step_hours": 6}


    def pct(vals: list[float], q: float) -> float:
        s = sorted(vals)
        k = (len(s) - 1) * q
        lo, hi = int(k), min(int(k) + 1, len(s) - 1)
        return round(s[lo] + (s[hi] - s[lo]) * (k - lo), 2)


    async def wait_health(client: httpx.AsyncClient, url: str, proc: subprocess.Popen, timeout: float) -> float:
        t0 = time.perf_counter()
        while time.perf_counter() - t0 < timeout:
            if proc.poll() is not None:
                raise SystemExit(f"FAILED: server at {url} exited with code {proc.returncode}")
            try:
                if (await client.get(f"{url}/health", timeout=2)).status_code == 200:
                    return round(time.perf_counter() - t0, 2)
            except httpx.HTTPError:
                pass
            await asyncio.sleep(0.5)
        raise SystemExit(f"FAILED: {url} not healthy after {timeout:.0f}s")


    async def load(client: httpx.AsyncClient, url: str, clients: int, requests: int) -> dict:
        lat, comp, errors = [], [], 0
        todo = iter(range(requests))

        async def one_client() -> None:
            nonlocal errors
            for _ in todo:
                t = time.perf_counter()
                try:
                    r = await client.post(f"{url}/v1/forecast", json=LOAD, timeout=120)
                    if r.status_code != 200:
                        errors += 1
                        continue
                    lat.append((time.perf_counter() - t) * 1000)
                    comp.append(r.json()["timing"]["compute_ms"])
                except httpx.HTTPError:
                    errors += 1

        t0 = time.perf_counter()
        await asyncio.gather(*(one_client() for _ in range(clients)))
        wall = time.perf_counter() - t0
        return {"clients": clients, "requests": requests, "errors": errors, "requests_per_s": round(len(lat) / wall, 2),
                "p50_ms": pct(lat, 0.5) if lat else None, "p95_ms": pct(lat, 0.95) if lat else None,
                "p99_ms": pct(lat, 0.99) if lat else None, "compute_p50_ms": pct(comp, 0.5) if comp else None}


    async def run_server(name: str, cmd: list[str], port: int, a, env: dict) -> dict:
        url = f"http://127.0.0.1:{port}"
        proc = subprocess.Popen(cmd, cwd=a.repo, env=env)  # noqa: ASYNC220 - returns at once
        try:
            async with httpx.AsyncClient() as client:
                ready_s = await wait_health(client, url, proc, a.ready_timeout)
                answers = []
                for body in CHECKS:
                    r = await client.post(f"{url}/v1/forecast", json=body, timeout=120)
                    r.raise_for_status()
                    answers.append(r.json())
                await load(client, url, 1, 5)  # settle
                sweeps = [await load(client, url, c, a.requests) for c in a.clients]
                for path in ("/v1/metrics", "/metrics", "/stats"):
                    r = await client.get(f"{url}{path}", timeout=5)
                    if r.status_code == 200:
                        extra = r.json()
                        break
            out = {"server": name, "ready_s": ready_s, "model_version": answers[0]["model_version"],
                   "init_time": answers[0].get("init_time"), "load": sweeps, "metrics": extra, "answers": answers}
            for s in sweeps:
                print(f"  {name}: {s['clients']} clients -> {s['requests_per_s']} req/s, p50 {s['p50_ms']} ms, "
                      f"p95 {s['p95_ms']} ms, GPU call p50 {s['compute_p50_ms']} ms, errors {s['errors']}", flush=True)
            return out
        finally:
            proc.terminate()
            try:
                proc.wait(timeout=20)
            except subprocess.TimeoutExpired:
                proc.kill()


    def compare(team: dict, engine: dict) -> dict:
        """Largest difference between the two servers' answers to the same requests."""
        worst = {"temp_c": 0.0, "wind_ms": 0.0, "pressure_hpa": 0.0}
        points = 0
        for a, b in zip(team["answers"], engine["answers"]):
            assert [p["lead_hours"] for p in a["forecast"]] == [p["lead_hours"] for p in b["forecast"]]
            series = [(a["forecast"], b["forecast"])]
            for ma, mb in zip(a.get("members") or [], b.get("members") or []):
                series.append((ma["points"], mb["points"]))
            for pa, pb in series:
                for x, y in zip(pa, pb):
                    points += 1
                    for k, cur in worst.items():
                        worst[k] = max(cur, abs(x[k] - y[k]))
        worst = {k: round(v, 3) for k, v in worst.items()}
        # bf16 autocast on the GPU is not bit-reproducible between batch shapes, so allow a small gap
        return {"points_compared": points, "max_abs_diff": worst, "same_init_time": team["init_time"] == engine["init_time"],
                "agree": worst["temp_c"] <= 0.5 and worst["wind_ms"] <= 0.5 and worst["pressure_hpa"] <= 1.0}


    def markdown(res: dict) -> str:
        c, g = res["compare"], res["gpu"]
        lines = [f"# AFNO behind the inference engine, {res['created_at']}", "",
                 f"GPU: {g}. Weights `{res['servers'][0]['model_version']}`, start time {res['servers'][0]['init_time']}.", "",
                 (f"Same requests to both servers: {c['points_compared']} forecast points compared, largest difference "
                 f"{c['max_abs_diff']['temp_c']} C, {c['max_abs_diff']['wind_ms']} m/s, {c['max_abs_diff']['pressure_hpa']} hPa "
                 f"-> agree: **{c['agree']}**."), "",
                 "One 48 h forecast per request (8 model steps):", "",
                 "| server | clients | req/s | p50 ms | p95 ms | p99 ms | GPU call p50 ms | errors |", "|---|---:|---:|---:|---:|---:|---:|---:|"]
        for s in res["servers"]:
            for row in s["load"]:
                lines.append(f"| {s['server']} | {row['clients']} | {row['requests_per_s']} | {row['p50_ms']} | {row['p95_ms']} | "
                             f"{row['p99_ms']} | {row['compute_p50_ms']} | {row['errors']} |")
        return "\n".join(lines) + "\n"


    def main() -> None:
        ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
        ap.add_argument("--weights", required=True)
        ap.add_argument("--data", required=True)
        ap.add_argument("--repo", default=str(HERE), help="checkout holding serve/ and weather/")
        ap.add_argument("--inference-root", default=str(HERE), help="folder holding the inference/ package")
        ap.add_argument("--clients", type=lambda s: [int(v) for v in s.split(",")], default=[1, 4, 16])
        ap.add_argument("--requests", type=int, default=48)
        ap.add_argument("--ready-timeout", type=float, default=300)
        ap.add_argument("--out", default="results/afno")
        ap.add_argument("--emit-markers", action="store_true")
        a = ap.parse_args()
        env = dict(os.environ, WX_REPO=a.repo, PYTHONUNBUFFERED="1")
        env["PYTHONPATH"] = os.pathsep.join(filter(None, [a.inference_root, a.repo, env.get("PYTHONPATH", "")]))
        py = sys.executable
        team_cmd = [py, "serve/forecast_server.py", "--node", "team", "--port", "8101", "--host", "127.0.0.1",
                    "--weights", a.weights, "--data", a.data]
        engine_cmd = [py, "-m", "inference.server", "--model", "afno", "--name", "engine", "--port", "8102",
                      "--require-gpu", "--timeout-s", "120", "--weights", a.weights, "--data", a.data]
        team = asyncio.run(run_server("team", team_cmd, 8101, a, env))
        engine = asyncio.run(run_server("engine", engine_cmd, 8102, a, env))
        dev = engine["metrics"].get("device", {})
        if dev.get("type") != "cuda":
            raise SystemExit(f"FAILED: the engine ran the model on {dev.get('type')}, not CUDA")
        res = {"schema": "wxrouter.afno.check/v1", "created_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
               "gpu": dev.get("name"), "node": engine["metrics"].get("node"), "compare": compare(team, engine),
               "gpu_memory": engine["metrics"].get("gpu_memory"), "servers": [team, engine]}
        for s in res["servers"]:
            s["answers"] = s["answers"][:1]  # keep one full answer as a sample
        md = markdown(res)
        print(md)
        out = Path(a.out) / datetime.now().strftime("%Y%m%d-%H%M%S")
        out.mkdir(parents=True, exist_ok=True)
        (out / "afno_check.json").write_text(json.dumps(res, indent=2))
        (out / "table.md").write_text(md)
        print(f"wrote {out}/afno_check.json and table.md")
        if a.emit_markers:
            print(BEGIN)
            print(json.dumps(res))
            print(END)
        if not res["compare"]["agree"]:
            raise SystemExit("FAILED: the two servers disagree")


    if __name__ == "__main__":
        main()
  inference-bench-py: |
    """Benchmark the inference engine and write machine-readable JSON.

      python -m inference.bench                 # full run, results/inference/<timestamp>/
      python -m inference.bench --quick         # a few seconds; used by the Fuzzball smoke test
      python -m inference.bench --require-gpu   # exit 2 instead of falling back to CPU

    What it measures:
      cold_start   import, model load, first inference, then warm inference
      batch_sweep  one direct GPU call per batch size: latency and rows/s
      serving      the async engine under N concurrent clients, with batching off
                   (baseline, max_batch_rows=1) and on (optimized), same requests
      precision    fp32 vs fp16 autocast (CUDA only)

    Nothing here is simulated. Every number is a wall-clock measurement on the
    device named in `environment`.
    """
    from __future__ import annotations

    import argparse
    import asyncio
    import json
    import platform
    import sys
    import time
    from dataclasses import replace
    from datetime import UTC, datetime
    from pathlib import Path

    import numpy as np

    from .config import EngineConfig, add_engine_args, engine_config_from_args
    from .engine import InferenceEngine, InferenceError, InferenceTimeout, Overloaded
    from .forecast import build_rows, issue_time
    from .gpu import query_smi
    from .metrics import latency_summary, log_event, setup_logging
    from .model import MODEL_VERSION

    BENCH_SCHEMA = "wxrouter.inference.bench/v1"
    BEGIN, END = "===WXROUTER_BENCH_JSON_BEGIN===", "===WXROUTER_BENCH_JSON_END==="


    def rows_for(n: int, seed: int = 0) -> np.ndarray:
        """n single-member requests at seeded random locations."""
        rng = np.random.default_rng(seed)
        issued = issue_time()
        return np.concatenate([build_rows(float(rng.uniform(-60, 60)), float(rng.uniform(-180, 180)), 1, issued)
                               for _ in range(n)])


    def environment(engine: InferenceEngine, import_ms: float | None) -> dict:
        b = engine.backend
        env = {"python": platform.python_version(), "platform": platform.platform(), "machine": platform.machine(),
               "backend": b.name, "device": b.device, "device_name": b.device_name, "precision": b.precision,
               "model_version": MODEL_VERSION, "hidden": engine.cfg.hidden, "layers": engine.cfg.layers,
               "numpy": np.__version__, "torch_import_ms": import_ms, "nvidia_smi": query_smi() or None}
        if b.name == "torch":
            env["torch"] = b.torch.__version__
            env["cuda_available"] = b.torch.cuda.is_available()
            env["torch_threads"] = b.torch.get_num_threads()
        return env


    def time_import(backend: str) -> float | None:
        if backend == "numpy":
            return None
        t0 = time.perf_counter()
        try:
            import torch  # noqa: F401
        except ImportError:
            return None
        return round((time.perf_counter() - t0) * 1000, 1)


    def batch_sweep(engine: InferenceEngine, sizes: list[int], hours: int, iters: int) -> list[dict]:
        out = []
        for n in sizes:
            x = rows_for(n)
            engine.infer_sync(x, hours)  # settle allocator for this shape
            engine.backend.reset_peak_memory()
            ms = []
            for _ in range(iters):
                t = time.perf_counter()
                engine.infer_sync(x, hours)
                ms.append((time.perf_counter() - t) * 1000)
            mean = sum(ms) / len(ms)
            out.append({"batch_rows": n, "hours_ahead": hours, "iterations": iters, "latency_ms": latency_summary(ms),
                        "rows_per_s": round(n / mean * 1000, 1), "ms_per_row": round(mean / n, 4),
                        "gpu_memory": engine.backend.memory()})
            log_event("bench_batch", **{k: v for k, v in out[-1].items() if k != "gpu_memory"})
        return out


    async def serve_once(cfg: EngineConfig, backend, clients: int, requests: int, hours: int, label: str) -> dict:
        """`clients` closed-loop clients send `requests` single-member forecasts through the engine."""
        engine = InferenceEngine(cfg, backend=backend)
        engine.ready = True  # backend is already warm
        await engine.start()
        xs = rows_for(requests, seed=1)
        lat_ms, errors = [], 0
        todo = iter(range(requests))

        async def client() -> None:
            nonlocal errors
            for i in todo:
                t = time.perf_counter()
                try:
                    await engine.infer(xs[i:i + 1], hours)
                    lat_ms.append((time.perf_counter() - t) * 1000)
                except (Overloaded, InferenceTimeout, InferenceError):
                    errors += 1

        backend.reset_peak_memory()
        t0 = time.perf_counter()
        await asyncio.gather(*(client() for _ in range(clients)))
        wall = time.perf_counter() - t0
        snap = engine.snapshot()
        await engine.stop()
        row = {"mode": label, "clients": clients, "requests": requests, "hours_ahead": hours,
               "max_batch_rows": cfg.max_batch_rows, "engine_concurrency": cfg.concurrency,
               "latency_ms": latency_summary(lat_ms), "requests_per_s": round(len(lat_ms) / wall, 1),
               "errors": errors, "error_rate": round(errors / requests, 5),
               "mean_batch_rows": snap["batches"]["mean_rows"], "gpu_memory": snap["gpu_memory"]}
        log_event("bench_serving", **{k: v for k, v in row.items() if k != "gpu_memory"})
        return row


    async def serving_sweep(cfg: EngineConfig, backend, clients: list[int], requests: int, hours: int) -> list[dict]:
        out = []
        for c in clients:
            out.append(await serve_once(replace(cfg, max_batch_rows=1), backend, c, requests, hours, "baseline"))
            out.append(await serve_once(cfg, backend, c, requests, hours, "batched"))
        return out


    FP16_TOLERANCE = 0.05  # model outputs are in [-1, 1]


    def precision_compare(cfg: EngineConfig, rows: int, hours: int, iters: int) -> list[dict]:
        """fp32 vs fp16 autocast on the same inputs: speed, and how far the fp16 answers drift."""
        out, ref = [], None
        x = rows_for(rows)
        for amp in (False, True):
            eng = InferenceEngine(replace(cfg, amp=amp))
            eng.load()
            y = eng.infer_sync(x, hours)
            r = batch_sweep(eng, [rows], hours, iters)[0]
            row = {"precision": eng.backend.precision, **r, "finite": bool(np.isfinite(y).all())}
            if ref is None:
                ref = y
            else:
                diff = float(np.abs(y - ref).max())
                row["max_abs_diff_vs_fp32"] = round(diff, 5)
                row["numerically_valid"] = row["finite"] and diff <= FP16_TOLERANCE
            out.append(row)
        return out


    def markdown(res: dict) -> str:
        env, cold = res["environment"], res["cold_start"]
        lines = [f"# Inference benchmark, {res['created_at']}", "",
                 (f"Device: **{env['device_name']}** ({env['backend']}, {env['precision']}), "
                 f"model `{env['model_version']}` hidden={env['hidden']} layers={env['layers']}"), "",
                 "## Cold start", "", "| torch import ms | model load ms | first inference ms | warm inference ms |",
                 "|---:|---:|---:|---:|",
                 f"| {env['torch_import_ms']} | {cold['load_ms']} | {cold['first_inference_ms']} | {cold['warm_inference_ms']} |",
                 "", f"## One GPU call per batch ({res['params']['hours_ahead']} h forecast)", "",
                 "| batch rows | p50 ms | p95 ms | p99 ms | rows/s | ms/row | peak GPU MB |", "|---:|---:|---:|---:|---:|---:|---:|"]
        for r in res["batch_sweep"]:
            l = r["latency_ms"]
            lines.append(f"| {r['batch_rows']} | {l['p50']:.2f} | {l['p95']:.2f} | {l['p99']:.2f} | {r['rows_per_s']} | "
                         f"{r['ms_per_row']} | {r['gpu_memory'].get('peak_allocated_mb', '')} |")
        lines += ["", "## Serving: baseline (no batching) vs batched", "",
                  "| clients | mode | p50 ms | p95 ms | p99 ms | req/s | mean batch | errors |", "|---:|---|---:|---:|---:|---:|---:|---:|"]
        for r in res["serving"]:
            l = r["latency_ms"]
            lines.append(f"| {r['clients']} | {r['mode']} | {l['p50']:.2f} | {l['p95']:.2f} | {l['p99']:.2f} | "
                         f"{r['requests_per_s']} | {r['mean_batch_rows']} | {r['errors']} |")
        if res.get("precision"):
            lines += ["", "## Precision", "", "| precision | batch rows | p50 ms | rows/s | peak GPU MB | max diff vs fp32 | valid |",
                      "|---|---:|---:|---:|---:|---:|---|"]
            lines += [f"| {r['precision']} | {r['batch_rows']} | {r['latency_ms']['p50']:.2f} | {r['rows_per_s']} | "
                      f"{r['gpu_memory'].get('peak_allocated_mb', '')} | {r.get('max_abs_diff_vs_fp32', '')} | "
                      f"{r.get('numerically_valid', '')} |" for r in res["precision"]]
        return "\n".join(lines) + "\n"


    def ints(s: str) -> list[int]:
        return [int(v) for v in s.split(",") if v]


    def run(a: argparse.Namespace) -> dict:
        import_ms = time_import(a.backend)
        cfg = engine_config_from_args(a)
        engine = InferenceEngine(cfg)
        engine.load()
        if cfg.require_gpu and engine.backend.device != "cuda":
            raise RuntimeError(f"CUDA GPU required but the model is on {engine.backend.device}")
        x1 = rows_for(1)
        warm = []
        for _ in range(20):
            t = time.perf_counter()
            engine.infer_sync(x1, 12)
            warm.append((time.perf_counter() - t) * 1000)
        cold = {**engine.cold_start, "warm_inference_ms": round(sorted(warm)[len(warm) // 2], 3),
                "note": "first_inference_ms and warm_inference_ms are one 12 h, 1-row forecast"}
        res = {
            "schema": BENCH_SCHEMA,
            "created_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "environment": environment(engine, import_ms),
            "params": {"hours_ahead": a.hours, "batch_sizes": a.batch_sizes, "clients": a.clients,
                       "requests": a.requests, "iterations": a.iterations, "quick": a.quick},
            "cold_start": cold,
            "batch_sweep": batch_sweep(engine, a.batch_sizes, a.hours, a.iterations),
            "serving": asyncio.run(serving_sweep(cfg, engine.backend, a.clients, a.requests, a.hours)),
            "precision": (precision_compare(cfg, max(a.batch_sizes), a.hours, a.iterations)
                          if engine.backend.device == "cuda" else []),
        }
        return res


    def main() -> None:
        ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
        ap.add_argument("--out", default="results/inference", help="a <timestamp>/ folder is created inside")
        ap.add_argument("--hours", type=int, default=48, help="forecast length used for every request")
        ap.add_argument("--batch-sizes", type=ints, default=[1, 4, 16, 64, 256])
        ap.add_argument("--clients", type=ints, default=[1, 8, 32], help="concurrent client counts")
        ap.add_argument("--requests", type=int, default=400, help="requests per serving run")
        ap.add_argument("--iterations", type=int, default=30, help="GPU calls per batch size")
        ap.add_argument("--quick", action="store_true", help="small smoke run")
        ap.add_argument("--emit-markers", action="store_true",
                        help="also print the JSON on stdout between marker lines, for scraping job logs")
        ap.add_argument("--log-level", default="INFO")
        add_engine_args(ap)
        a = ap.parse_args()
        if a.quick:
            a.batch_sizes, a.clients, a.requests, a.iterations = [1, 16, 64], [1, 16], 64, 5
        setup_logging(a.log_level)
        try:
            res = run(a)
        except RuntimeError as e:
            if "GPU required" not in str(e):
                raise
            log_event("bench_no_gpu", error=str(e))
            print(f"FAILED: {e}", file=sys.stderr)
            sys.exit(2)
        out = Path(a.out) / datetime.now().strftime("%Y%m%d-%H%M%S")
        out.mkdir(parents=True, exist_ok=True)
        (out / "bench.json").write_text(json.dumps(res, indent=2))
        (out / "table.md").write_text(markdown(res))
        print(markdown(res))
        print(f"wrote {out}/bench.json and table.md")
        if a.emit_markers:
            print(BEGIN)
            print(json.dumps(res))
            print(END)


    if __name__ == "__main__":
        main()
  inference-cluster-bench-py: |
    """Benchmark two real inference boxes behind router.py, including a failure scenario.

    One seeded trace (loadgen.make_trace) is replayed for every case, so the cases
    are comparable:

      single_gpu_no_batching   straight at one box, max_batch_rows=1
      single_gpu_batching      straight at one box, batching on
      two_gpu_<policy>         through the router, one run per routing policy
      fault_<policy>           through the router while box A is slowed, then
                               stopped, then started again

    Faults are real: "slow" puts a second load on that box's GPU, "kill" stops the
    server process and "restart" is the supervisor starting it again (cold start).

    Runs anywhere the boxes and the router are reachable. It needs only httpx and
    loadgen.py, so on Fuzzball it runs as a plain script next to loadgen.py:

      python -m inference.cluster_bench --router http://127.0.0.1:8000 \\
          --box box-a=http://127.0.0.1:8001 --box box-b=http://127.0.0.1:8002 --out results/cluster
    """
    from __future__ import annotations

    import argparse
    import asyncio
    import json
    import statistics
    import sys
    import time
    from datetime import UTC, datetime
    from pathlib import Path

    import httpx


    def _root_loadgen():
        """The team's loadgen.py, loaded by path under its own name: bench/loadgen.py is also called
        `loadgen`, and whichever is imported first would otherwise win."""
        import importlib.util

        here = Path(__file__).resolve().parent
        path = next(p for p in (here / "loadgen.py", here.parent / "loadgen.py") if p.exists())
        spec = importlib.util.spec_from_file_location("wxrouter_root_loadgen", path)
        mod = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = mod  # dataclasses look their module up here
        spec.loader.exec_module(mod)
        return mod


    loadgen = _root_loadgen()

    SCHEMA = "wxrouter.cluster.bench/v1"
    BEGIN, END = "===WXROUTER_CLUSTER_JSON_BEGIN===", "===WXROUTER_CLUSTER_JSON_END==="
    PROBE = {"lat": 40.0, "lon": -100.0, "hours_ahead": 48, "request_id": "calibrate"}


    async def get_json(client: httpx.AsyncClient, url: str, timeout: float = 2.0):
        try:
            r = await client.get(url, timeout=timeout)
            return r.status_code, r.json()
        except (httpx.HTTPError, ValueError):
            return 0, None


    async def post_json(client: httpx.AsyncClient, url: str, body: dict, timeout: float = 30.0):
        try:
            r = await client.post(url, json=body, timeout=timeout)
            return r.status_code, r.json()
        except (httpx.HTTPError, ValueError) as e:
            return 0, {"error": type(e).__name__}


    async def wait_ready(client, boxes: dict[str, str], router: str | None, timeout: float, why: str) -> float:
        """Wait until every box answers /health 200 and the router (if any) calls every box healthy."""
        t0 = time.perf_counter()
        while True:
            codes = [(await get_json(client, f"{u}/health"))[0] for u in boxes.values()]
            ok = all(c == 200 for c in codes)
            if ok and router:
                code, st = await get_json(client, f"{router}/router/status")
                ok = code == 200 and all(b["healthy"] for b in st["backends"].values())
            waited = time.perf_counter() - t0
            if ok:
                return waited
            if waited > timeout:
                raise SystemExit(f"not ready after {timeout:.0f}s ({why}): box health codes {codes}")
            await asyncio.sleep(0.5)


    async def placement(client, boxes: dict[str, str]) -> dict:
        out = {}
        for name, url in boxes.items():
            _, m = await get_json(client, f"{url}/v1/metrics", 5)
            m = m or {}
            out[name] = {"node": m.get("node"), "device": m.get("device"), "cold_start": m.get("cold_start"),
                         "model_version": m.get("model_version")}
        return out


    def distinct_nodes(place: dict) -> bool | None:
        """True when every box reports a different GPU UUID (or, without one, a different first address)."""
        ids = []
        for p in place.values():
            node = p.get("node") or {}
            ids.append(node.get("gpu_uuid") or (node.get("addresses") or [None])[0])
        if any(i is None for i in ids):
            return None
        return len(set(ids)) == len(ids)


    async def median_compute_ms(client, url: str, n: int = 12) -> float | None:
        vals = []
        for _ in range(n):
            code, body = await post_json(client, f"{url}/v1/forecast", PROBE)
            if code == 200:
                vals.append(body["timing"]["compute_ms"])
        return round(statistics.median(vals), 2) if vals else None


    async def calibrate_slow(client, url: str, factor: float) -> dict:
        """How much the real GPU load slows one 48 h forecast on an otherwise idle box."""
        normal = await median_compute_ms(client, url)
        await post_json(client, f"{url}/admin/mode", {"mode": "slow", "slow_factor": factor})
        await asyncio.sleep(1.0)
        slow = await median_compute_ms(client, url)
        await post_json(client, f"{url}/admin/mode", {"mode": "normal"})
        return {"slow_factor_requested": factor, "compute_ms_normal": normal, "compute_ms_slow": slow,
                "measured_slowdown": round(slow / normal, 2) if normal and slow else None}


    def timeline(rows: list[dict], duration: float) -> list[dict]:
        """Per second of send time: requests, errors, who served them, latency."""
        out = []
        for sec in range(int(duration) + 1):
            rs = [r for r in rows if int(r["t"]) == sec]
            if not rs:
                continue
            ok = sorted(r["latency_ms"] for r in rs if r["status"] == 200)
            by = {}
            for r in rs:
                if r["status"] == 200:
                    by[r["served_by"]] = by.get(r["served_by"], 0) + 1
            out.append({"t": sec, "requests": len(rs), "errors": len(rs) - len(ok), "served_by": by,
                        "p50_ms": round(loadgen.pct(ok, 0.5), 1) if ok else None,
                        "p95_ms": round(loadgen.pct(ok, 0.95), 1) if ok else None})
        return out


    def fault_report(tl: list[dict], events: list[loadgen.Event]) -> dict:
        """What happened around each fault on the faulted box: its share of traffic, errors, time to return."""
        def share(box: str, t0: float, t1: float) -> float | None:
            n = sum(sum(s["served_by"].values()) for s in tl if t0 <= s["t"] < t1)
            mine = sum(s["served_by"].get(box, 0) for s in tl if t0 <= s["t"] < t1)
            return round(100 * mine / n, 1) if n else None

        def errors(t0: float, t1: float) -> int:
            return sum(s["errors"] for s in tl if t0 <= s["t"] < t1)

        end = (tl[-1]["t"] + 1) if tl else 0
        rep = {}
        by = {(e.action, e.box): e.t for e in events}
        for (action, box), t in by.items():
            if action == "slow":
                t_end = by.get(("normal", box), end)
                rep["slow"] = {"box": box, "from_s": t, "to_s": t_end,
                               "share_before_pct": share(box, 0, t), "share_during_pct": share(box, t + 2, t_end),
                               "share_after_pct": share(box, t_end + 2, by.get(("kill", box), end)),
                               "errors_during": errors(t, t_end)}
            if action == "kill":
                t_back = by.get(("restart", box), end)
                served_again = next((s["t"] for s in tl if s["t"] >= t_back and s["served_by"].get(box, 0) > 0), None)
                rep["stop"] = {"box": box, "stopped_s": t, "restart_s": t_back,
                               "errors_while_down": errors(t, t_back), "errors_after_restart": errors(t_back, end),
                               "first_served_again_s": served_again,
                               "seconds_to_serve_again": None if served_again is None else served_again - t_back,
                               "share_last_5s_pct": share(box, end - 5, end)}
        return rep


    def case_switches(status: dict | None, n_before: int, samples: list[dict]) -> list[dict]:
        """The router's switches made during this case. The router stamps them on its own clock, so
        `t_case` (seconds into the case) comes from when our samples saw the active box change."""
        if not status or status["policy"] != "adaptive":
            return []
        new = [dict(s) for s in status["adaptive"]["switches"][n_before:]]
        seen, last = [], None
        for s in samples:
            active = (s.get("router") or {}).get("active")
            if active and last and active != last:
                seen.append(s["t"])
            last = active or last
        if len(seen) == len(new):
            for sw, t in zip(new, seen):
                sw["t_case"] = t
        return new


    async def run_case(client, label: str, target: str, trace: list[dict], events: list[loadgen.Event],
                       boxes: dict[str, str], router: str | None, direct_box: str | None, a) -> dict:
        samples: list[dict] = []
        stop = asyncio.Event()
        start = time.perf_counter()

        async def sampler() -> None:
            while not stop.is_set():
                row = {"t": round(time.perf_counter() - start, 2)}
                for name, url in boxes.items():
                    code, s = await get_json(client, f"{url}/stats", 1.0)
                    row[name] = ({"up": True, "gpu_util": s["gpu_util"], "in_flight": s["in_flight"],
                                  "queue_depth": s["queue_depth"], "p50_ms": s["p50_latency_ms"], "mode": s["mode"]}
                                 if code == 200 else {"up": False})
                if router:
                    code, st = await get_json(client, f"{router}/router/status", 1.0)
                    if code == 200:
                        row["router"] = {"active": st["adaptive"]["active"],
                                         "healthy": [n for n, b in st["backends"].items() if b["healthy"]]}
                samples.append(row)
                await asyncio.sleep(a.sample_s)

        async def on_event(_client, ev: loadgen.Event) -> None:
            url = boxes[ev.box]
            if ev.action == "kill":
                back = next((e.t for e in events if e.action == "restart" and e.box == ev.box and e.t > ev.t), ev.t + 10)
                await post_json(client, f"{url}/admin/stop", {"down_s": round(back - ev.t, 2)}, 3)
            elif ev.action == "restart":
                pass  # the box's supervisor starts it again after down_s
            else:
                await post_json(client, f"{url}/admin/mode", {"mode": ev.action, "slow_factor": ev.arg or a.slow_factor}, 10)

        before = (await get_json(client, f"{router}/router/status"))[1] if router else None
        n_before = len(before["adaptive"]["switches"]) if before else 0
        print(f"  {label}: {len(trace)} requests" + (f", events {[e.label() for e in events]}" if events else ""), flush=True)
        task = asyncio.create_task(sampler())
        rows = await loadgen.replay(target, trace, events, on_event, a.client_timeout)
        wall = time.perf_counter() - start
        stop.set()
        await task
        if direct_box:
            for r in rows:
                if r["status"] == 200:
                    r["served_by"] = direct_box
        status = (await get_json(client, f"{router}/router/status"))[1] if router else None
        policy = status["policy"] if status else "direct"
        summary = loadgen.summarize(policy if policy == "adaptive" else label, rows, status)
        summary["policy"] = policy
        ok = sum(1 for r in rows if r["status"] == 200)
        summary.update(label=label, wall_s=round(wall, 2), ok_per_s=round(ok / wall, 1),
                       offered_per_s=round(len(trace) / max(trace[-1]["t"], 1e-9), 1))
        tl = timeline(rows, trace[-1]["t"])
        case = {"label": label, "policy": policy, "summary": summary, "timeline": tl, "samples": samples,
                "events": [{"t": e.t, "action": e.action, "box": e.box, "arg": e.arg} for e in events],
                "switches": case_switches(status, n_before, samples),
                "failovers": status["failovers"] if status else None}
        if events:
            case["fault_report"] = fault_report(tl, events)
        case["boxes_after"] = {}
        for name, url in boxes.items():
            _, m = await get_json(client, f"{url}/v1/metrics", 3)
            if m:
                case["boxes_after"][name] = {k: m.get(k) for k in ("load", "compute_ms", "batches", "gpu_memory", "errors")}
        if a.out:
            loadgen.write_jsonl(Path(a.out) / f"raw-{label}.jsonl", sorted(rows, key=lambda r: r["t"]))
        print(f"    -> errors {summary['errors']}, p50 {summary['p50_ms']} ms, p95 {summary['p95_ms']} ms, "
              f"p99 {summary['p99_ms']} ms, {summary['ok_per_s']} ok/s, A {summary['share_a_pct']}% B {summary['share_b_pct']}%",
              flush=True)
        return case


    def markdown(res: dict) -> str:
        p = res["params"]
        lines = [f"# Two-box routing benchmark, {res['created_at']}", "",
                 f"Trace: seed {p['seed']}, {p['rps']} req/s; steady cases {p['duration']} s, fault cases {p['fault_duration']} s.",
                 f"Fault events: `{p['events']}`.", ""]
        for name, pl in res["placement"].items():
            node, dev = pl.get("node") or {}, pl.get("device") or {}
            lines.append(f"- **{name}**: {dev.get('name')} ({dev.get('type')}, {dev.get('precision')}), "
                         f"node addresses {node.get('addresses')}, GPU {node.get('gpu_uuid')}")
        lines += [f"- distinct nodes: **{res['distinct_nodes']}**", ""]
        cal = res.get("calibration")
        if cal:
            lines += [(f"Slow mode (factor {cal['slow_factor_requested']}): one 48 h forecast took "
                      f"{cal['compute_ms_normal']} ms idle and {cal['compute_ms_slow']} ms under the GPU load "
                      f"({cal['measured_slowdown']}x)."), ""]
        lines += ["| case | policy | reqs | errors | p50 ms | p95 ms | p99 ms | ok/s | box A % | box B % | failovers | switches |",
                  "|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|"]
        for c in res["cases"]:
            s = c["summary"]
            lines.append(f"| {c['label']} | {c['policy']} | {s['requests']} | {s['errors']} | {s['p50_ms']} | {s['p95_ms']} | "
                         f"{s['p99_ms']} | {s['ok_per_s']} | {s['share_a_pct']} | {s['share_b_pct']} | {s['failovers']} | "
                         f"{len(c['switches'])} |")
        for c in res["cases"]:
            fr = c.get("fault_report")
            if not fr:
                continue
            lines += ["", f"**{c['label']}**"]
            if "slow" in fr:
                f = fr["slow"]
                lines.append(f"- {f['box']} slowed {f['from_s']:g}-{f['to_s']:g} s: its share went {f['share_before_pct']}% -> "
                             f"{f['share_during_pct']}% -> {f['share_after_pct']}% (before, during, after); "
                             f"{f['errors_during']} errors")
            if "stop" in fr:
                f = fr["stop"]
                lines.append(f"- {f['box']} stopped at {f['stopped_s']:g} s, restarted at {f['restart_s']:g} s: "
                             f"{f['errors_while_down']} errors while down, served again "
                             f"{f['seconds_to_serve_again']} s after the restart, share in the last 5 s {f['share_last_5s_pct']}%")
            for sw in c["switches"]:
                lines.append(f"- switch at {sw.get('t_case', '?')} s: {sw['from']} -> {sw['to']} ({sw['reason']})")
        return "\n".join(lines) + "\n"


    async def main_async(a) -> dict:
        boxes = dict(b.split("=", 1) for b in a.box)
        names = list(boxes)
        first = names[0]
        events = loadgen.parse_events(a.events)
        steady = loadgen.make_trace(a.seed, a.duration, a.rps)
        faulty = loadgen.make_trace(a.seed, a.fault_duration, a.rps)
        limits = httpx.Limits(max_connections=200, max_keepalive_connections=50)
        async with httpx.AsyncClient(limits=limits) as client:
            waited = await wait_ready(client, boxes, a.router, a.ready_timeout, "start")
            print(f"ready after {waited:.1f}s", flush=True)
            place = await placement(client, boxes)
            distinct = distinct_nodes(place)
            for name, pl in place.items():
                print(f"  {name}: {json.dumps(pl['node'])} {json.dumps(pl['device'])}", flush=True)
            print(f"  distinct nodes: {distinct}", flush=True)
            if a.require_distinct_nodes and distinct is not True:
                raise SystemExit("FAILED: the boxes are not provably on different GPU nodes")
            if a.require_gpu and any((pl["device"] or {}).get("type") != "cuda" for pl in place.values()):
                raise SystemExit("FAILED: a box is not running on CUDA")
            res = {"schema": SCHEMA, "created_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
                   "params": {"seed": a.seed, "rps": a.rps, "duration": a.duration, "fault_duration": a.fault_duration,
                              "events": ",".join(f"{e.t:g}:{e.action}:{e.box}" + (f":{e.arg:g}" if e.arg else "")
                                                 for e in events),
                              "slow_factor": a.slow_factor, "adaptive_home_in_fault_cases": a.preferred, "policies": a.policies, "fault_policies": a.fault_policies},
                   "placement": place, "distinct_nodes": distinct, "cases": []}
            if a.admin:
                res["calibration"] = await calibrate_slow(client, boxes[first], a.slow_factor)
                print(f"  slow calibration: {res['calibration']}", flush=True)

            async def settle(router: str | None) -> None:
                if a.admin:
                    for url in boxes.values():
                        await post_json(client, f"{url}/admin/mode", {"mode": "normal"})
                await wait_ready(client, boxes, router, a.ready_timeout, "between cases")
                await asyncio.sleep(a.settle_s)

            if a.admin and not a.skip_single:
                one = {first: boxes[first]}
                for label, rows_per_call in (("single_gpu_no_batching", 1), ("single_gpu_batching", a.max_batch_rows)):
                    await settle(None)
                    await post_json(client, f"{boxes[first]}/admin/engine", {"max_batch_rows": rows_per_call})
                    res["cases"].append(await run_case(client, label, boxes[first], steady, [], one, None, first, a))
                await post_json(client, f"{boxes[first]}/admin/engine", {"max_batch_rows": a.max_batch_rows})
            if a.router:
                for prefix, policies, trace, evs in (("two_gpu", a.policies, steady, []),
                                                     ("fault", a.fault_policies if a.admin else [], faulty, events)):
                    for policy in policies:
                        await settle(a.router)
                        home = a.preferred if (prefix == "fault" and policy == "adaptive") else ""
                        code, _ = await post_json(client, f"{a.router}/router/config", {"policy": policy, "preferred": home})
                        if code != 200:
                            print(f"  skipping {policy}: router refused it ({code})", flush=True)
                            continue
                        await asyncio.sleep(1.0)
                        res["cases"].append(await run_case(client, f"{prefix}_{policy}", a.router, trace, evs,
                                                           boxes, a.router, None, a))
                await settle(a.router)
        return res


    def names(s: str) -> list[str]:
        return [v for v in s.split(",") if v]


    def main() -> None:
        ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
        ap.add_argument("--router", default="", help="router URL; empty runs only the single-box cases")
        ap.add_argument("--box", action="append", required=True, help="NAME=URL; the first one is box A")
        ap.add_argument("--policies", type=names, default=["static", "round_robin", "least_loaded", "adaptive", "balanced"])
        ap.add_argument("--fault-policies", type=names, default=["static", "round_robin", "least_loaded", "adaptive", "balanced"])
        ap.add_argument("--seed", type=int, default=42)
        ap.add_argument("--rps", type=float, default=200.0)
        ap.add_argument("--duration", type=float, default=30.0, help="steady cases, seconds")
        ap.add_argument("--fault-duration", type=float, default=60.0)
        ap.add_argument("--events", default="10:slow:box-a,25:normal:box-a,35:kill:box-a,45:restart:box-a",
                        help="T:ACTION:BOX[:ARG] list for the fault cases")
        ap.add_argument("--preferred", default="box-a", help="adaptive's home box in the fault cases; '' for none")
        ap.add_argument("--slow-factor", type=float, default=4.0)
        ap.add_argument("--max-batch-rows", type=int, default=64)
        ap.add_argument("--no-admin", dest="admin", action="store_false",
                        help="boxes have no /admin hooks: skip single-box and fault cases")
        ap.add_argument("--skip-single", action="store_true")
        ap.add_argument("--require-distinct-nodes", action="store_true")
        ap.add_argument("--require-gpu", action="store_true")
        ap.add_argument("--ready-timeout", type=float, default=600.0)
        ap.add_argument("--settle-s", type=float, default=3.0)
        ap.add_argument("--sample-s", type=float, default=0.5)
        ap.add_argument("--client-timeout", type=float, default=30.0)
        ap.add_argument("--out", default="results/cluster", help="a <timestamp>/ folder is created inside")
        ap.add_argument("--emit-markers", action="store_true")
        a = ap.parse_args()
        a.router = a.router.rstrip("/")
        if a.out:
            a.out = str(Path(a.out) / datetime.now().strftime("%Y%m%d-%H%M%S"))
            Path(a.out).mkdir(parents=True, exist_ok=True)
        res = asyncio.run(main_async(a))
        md = markdown(res)
        print(md)
        if a.out:
            (Path(a.out) / "cluster_bench.json").write_text(json.dumps(res, indent=2))
            (Path(a.out) / "table.md").write_text(md)
            print(f"wrote {a.out}/cluster_bench.json, table.md and raw-*.jsonl")
        if a.emit_markers:
            print(BEGIN)
            print(json.dumps(res))
            print(END)
        sys.stdout.flush()


    if __name__ == "__main__":
        main()
  inference-config-py: |
    """Engine settings. Every field is also a CLI flag on the server and the bench."""
    from __future__ import annotations

    import argparse
    from dataclasses import dataclass, fields


    @dataclass
    class EngineConfig:
        box: str = "box-a"
        device: str = "auto"  # auto (cuda, else cpu) | cuda | mps | cpu
        backend: str = "auto"  # auto (torch if installed, else numpy) | torch | numpy
        hidden: int = 256  # model width
        layers: int = 4  # residual blocks per forecast hour
        seed: int = 0  # weight seed; both boxes must use the same one
        amp: bool = False  # fp16 autocast on CUDA; off because on the GB10 it was slower and drifted (see README)
        max_batch_rows: int = 64  # rows (request x ensemble member) per GPU call; 1 disables batching
        max_wait_ms: float = 0.0  # extra wait to fill a batch; 0 = only batch what is already queued
        concurrency: int = 1  # GPU calls running at once
        max_queue: int = 256  # waiting requests before 503
        timeout_s: float = 10.0  # per GPU call
        retries: int = 1  # retries after a failed GPU call (not after a timeout)
        retry_backoff_ms: float = 20.0
        warmup_runs: int = 3
        require_gpu: bool = False  # fail at load instead of falling back to CPU


    def add_engine_args(ap: argparse.ArgumentParser) -> None:
        for f in fields(EngineConfig):
            flag = "--" + f.name.replace("_", "-")
            if f.type == "bool":
                ap.add_argument(flag, action=argparse.BooleanOptionalAction, default=f.default)
            else:
                ap.add_argument(flag, type=type(f.default), default=f.default)


    def engine_config_from_args(a: argparse.Namespace) -> EngineConfig:
        return EngineConfig(**{f.name: getattr(a, f.name) for f in fields(EngineConfig)})
  inference-contention-py: |
    """A real, controllable load on the same device as the model.

    `Burner.set(factor)` starts `round(factor) - 1` threads that run matrix products
    on the model's device until told to stop, the way a training job sharing the
    GPU would. Nothing is simulated: forecasts get slower because the GPU is busy,
    and the slowdown you get is whatever the hardware gives, not exactly `factor`.
    """
    from __future__ import annotations

    import threading

    import numpy as np


    class Burner:
        def __init__(self, backend, size: int = 1024):
            self.backend, self.size = backend, size
            self.factor = 1.0
            self._stop = threading.Event()
            self._threads: list[threading.Thread] = []

        def set(self, factor: float) -> None:
            self.clear()
            self.factor = max(1.0, float(factor))
            self._stop = threading.Event()
            for i in range(max(0, round(self.factor) - 1)):
                t = threading.Thread(target=self._run, args=(self._stop,), name=f"burner-{i}", daemon=True)
                t.start()
                self._threads.append(t)

        def clear(self) -> None:
            self._stop.set()
            for t in self._threads:
                t.join(timeout=5)
            self._threads = []
            self.factor = 1.0

        @property
        def active(self) -> bool:
            return bool(self._threads)

        def _run(self, stop: threading.Event) -> None:
            n = self.size
            if getattr(self.backend, "name", "") == "torch":
                torch, device = self.backend.torch, self.backend.device
                a = torch.randn(n, n, device=device)
                while not stop.is_set():
                    a = torch.tanh(a @ a / n)
                    if device == "cuda":
                        torch.cuda.synchronize()
            else:
                a = np.random.default_rng(0).standard_normal((n, n)).astype(np.float32)
                while not stop.is_set():
                    a = np.tanh(a @ a / n)
  inference-engine-py: |
    """Inference engine: loads the model, batches requests, runs them on the GPU.

    Requests wait in a queue. Each of `concurrency` workers takes whatever is queued
    (up to `max_batch_rows` rows), runs it as one GPU call on a thread, and hands
    each request its slice. So batches form by themselves under load and a lone
    request is never delayed, unless `max_wait_ms` is set.

    A GPU call that raises is retried `retries` times. One that exceeds `timeout_s`
    is not retried: its thread is still busy, so the caller gets InferenceTimeout
    (503 from the server) and the router fails over to the other box.
    """
    from __future__ import annotations

    import asyncio
    import logging
    import time
    from concurrent.futures import ThreadPoolExecutor
    from dataclasses import asdict, dataclass

    import numpy as np

    from .config import EngineConfig
    from .gpu import GpuMonitor, node_identity
    from .metrics import METRICS_SCHEMA, MetricsRecorder, log_event
    from .model import FEATURES, MODEL_VERSION, make_backend


    class Overloaded(Exception):
        """Queue full or engine not ready. Maps to 503."""


    class InferenceTimeout(Exception):
        """GPU call exceeded timeout_s. Maps to 503."""


    class InferenceError(Exception):
        """GPU call failed after all retries. Maps to 500."""


    @dataclass
    class _Job:
        x: np.ndarray  # (rows, FEATURES)
        steps: int
        future: asyncio.Future
        enqueued: float
        aux: np.ndarray | None = None  # per-row extras for backends that need them (AFNO: lat, lon)


    class InferenceEngine:
        def __init__(self, cfg: EngineConfig | None = None, backend=None):
            self.cfg = cfg or EngineConfig()
            self.backend = backend  # tests inject fakes here
            self.metrics = MetricsRecorder()
            self.gpu = GpuMonitor()
            self.ready = False
            self.load_error: str | None = None
            self.cold_start: dict = {}
            self.node: dict = {}
            self.in_flight = 0  # requests inside a GPU call
            self.started = time.monotonic()
            self._queue: asyncio.Queue[_Job] | None = None
            self._workers: list[asyncio.Task] = []
            self._pool: ThreadPoolExecutor | None = None

        # ------------------------------------------------------------ load
        def load(self) -> None:
            """Build the backend and warm it up. Blocking; safe to call from a thread."""
            t0 = time.perf_counter()
            if self.backend is None:
                self.backend = make_backend(self.cfg)
            load_ms = (time.perf_counter() - t0) * 1000
            if hasattr(self.backend, "warmup_input"):
                x, steps, aux = self.backend.warmup_input()
                args = (x, steps, None, aux)
            else:
                args = (np.zeros((1, FEATURES), np.float32), 12)
            warm = []
            for _ in range(max(1, self.cfg.warmup_runs)):
                t = time.perf_counter()
                self.backend.rollout(*args)
                warm.append(round((time.perf_counter() - t) * 1000, 3))
            self.backend.reset_peak_memory()
            self.node = node_identity()
            self.cold_start = {"load_ms": round(load_ms, 3), "first_inference_ms": warm[0],
                               "warmup_ms": warm, "ready_ms": round((time.perf_counter() - t0) * 1000, 3)}
            self.ready = True
            log_event("engine_ready", box=self.cfg.box, backend=self.backend.name, device=self.backend.device,
                      device_name=self.backend.device_name, precision=self.backend.precision, **self.cold_start)

        async def start(self) -> None:
            self._queue = asyncio.Queue()
            self._pool = ThreadPoolExecutor(self.cfg.concurrency + 1, thread_name_prefix="gpu")
            try:
                if not self.ready:
                    await asyncio.get_running_loop().run_in_executor(self._pool, self.load)
            except Exception as e:
                self.load_error = f"{type(e).__name__}: {e}"
                log_event("engine_load_failed", logging.ERROR, box=self.cfg.box, error=self.load_error)
                raise
            self.gpu.start()
            self._workers = [asyncio.create_task(self._worker()) for _ in range(self.cfg.concurrency)]

        async def stop(self) -> None:
            self.ready = False
            for w in self._workers:
                w.cancel()
            await asyncio.gather(*self._workers, return_exceptions=True)
            self._workers = []
            self.gpu.stop()
            if self._pool:
                self._pool.shutdown(wait=False, cancel_futures=True)

        # ------------------------------------------------------------ inference
        def infer_sync(self, x: np.ndarray, steps: int, aux: np.ndarray | None = None) -> np.ndarray:
            """One direct GPU call, no queue. For offline batch jobs and the bench."""
            x = np.ascontiguousarray(x, np.float32)
            return self.backend.rollout(x, steps) if aux is None else self.backend.rollout(x, steps, None, aux)

        async def infer(self, x: np.ndarray, steps: int, aux: np.ndarray | None = None) -> tuple[np.ndarray, dict]:
            """Queue `x` (rows, FEATURES) for a `steps`-hour rollout.

            Returns (y, timing): y is (rows, steps, OUTPUTS); timing has queue_ms and compute_ms.
            """
            if not self.ready or self._queue is None:
                self.metrics.error("rejected")
                raise Overloaded("engine not ready")
            if self._queue.qsize() >= self.cfg.max_queue:
                self.metrics.error("rejected")
                raise Overloaded("queue full")
            job = _Job(np.ascontiguousarray(x, np.float32), steps,
                       asyncio.get_running_loop().create_future(), time.perf_counter(), aux)
            self._queue.put_nowait(job)
            return await job.future

        async def _worker(self) -> None:
            cfg, queue = self.cfg, self._queue
            carry: _Job | None = None
            while True:
                batch = [carry or await queue.get()]
                carry = None
                rows = len(batch[0].x)
                deadline = time.perf_counter() + cfg.max_wait_ms / 1000
                while rows < cfg.max_batch_rows:
                    wait = deadline - time.perf_counter()
                    try:
                        nxt = queue.get_nowait() if wait <= 0 else await asyncio.wait_for(queue.get(), wait)
                    except (TimeoutError, asyncio.QueueEmpty):
                        break
                    if rows + len(nxt.x) > cfg.max_batch_rows:
                        carry = nxt  # starts the next batch
                        break
                    batch.append(nxt)
                    rows += len(nxt.x)
                batch = [j for j in batch if not j.future.done()]  # drop requests whose client left
                if batch:
                    await self._run_batch(batch)

        async def _run_batch(self, batch: list[_Job]) -> None:
            cfg, loop = self.cfg, asyncio.get_running_loop()
            steps = max(j.steps for j in batch)
            x = np.concatenate([j.x for j in batch]) if len(batch) > 1 else batch[0].x
            row_steps = [j.steps for j in batch for _ in range(len(j.x))]
            call = [self.backend.rollout, x, steps, row_steps]
            if batch[0].aux is not None:
                call.append(np.concatenate([j.aux for j in batch]))
            started = time.perf_counter()
            self.in_flight += len(batch)
            self.metrics.batch(len(batch), len(x))
            y, err, kind = None, None, "error"
            try:
                for attempt in range(cfg.retries + 1):
                    try:
                        y = await asyncio.wait_for(
                            loop.run_in_executor(self._pool, *call), cfg.timeout_s)
                        break
                    except TimeoutError:
                        err, kind = InferenceTimeout(f"GPU call exceeded {cfg.timeout_s}s"), "timeout"
                        log_event("inference_timeout", logging.ERROR, box=cfg.box, rows=len(x), steps=steps)
                        break
                    except Exception as e:  # noqa: BLE001 - any backend failure is retryable
                        err = InferenceError(f"{type(e).__name__}: {e}")
                        log_event("inference_failed", logging.WARNING, box=cfg.box, rows=len(x), steps=steps,
                                  attempt=attempt + 1, error=str(err))
                        if attempt < cfg.retries:
                            self.metrics.retries += 1
                            await asyncio.sleep(cfg.retry_backoff_ms / 1000 * (attempt + 1))
            finally:
                self.in_flight -= len(batch)
            done = time.perf_counter()
            compute_ms = (done - started) * 1000
            offset = 0
            for j in batch:
                n = len(j.x)
                if y is None:
                    self.metrics.error(kind)
                    if not j.future.done():
                        j.future.set_exception(err)
                else:
                    queue_ms = (started - j.enqueued) * 1000
                    self.metrics.ok(queue_ms, compute_ms, (done - j.enqueued) * 1000, n)
                    if not j.future.done():
                        j.future.set_result((y[offset:offset + n, :j.steps],
                                             {"queue_ms": queue_ms, "compute_ms": compute_ms,
                                              "batch_requests": len(batch), "batch_rows": len(x)}))
                offset += n
            log_event("batch", logging.DEBUG, box=cfg.box, requests=len(batch), rows=len(x), steps=steps,
                      compute_ms=round(compute_ms, 2), ok=y is not None)

        # ------------------------------------------------------------ metrics
        @property
        def queue_depth(self) -> int:
            return self._queue.qsize() if self._queue else 0

        def gpu_util(self) -> float:
            """NVML utilisation when there is a GPU, else the busy share of GPU slots."""
            util = self.gpu.last.get("gpu_util")
            if util is None:
                calls = min(self.cfg.concurrency, self.in_flight)
                util = calls / self.cfg.concurrency
            return round(float(util), 3)

        def status(self) -> str:
            if not self.ready:
                return "down"
            return "degraded" if self.queue_depth >= self.cfg.max_queue // 2 else "ok"

        def snapshot(self) -> dict:
            """Everything the router might want, as one JSON-able dict."""
            b = self.backend
            return {
                "schema": METRICS_SCHEMA,
                "box": self.cfg.box,
                "model_version": getattr(b, "model_version", MODEL_VERSION),
                "availability": {"status": self.status(), "ready": self.ready, "load_error": self.load_error,
                                 "uptime_s": round(time.monotonic() - self.started, 1)},
                "node": self.node,
                "device": {"backend": getattr(b, "name", None), "type": getattr(b, "device", None),
                           "name": getattr(b, "device_name", None), "precision": getattr(b, "precision", None)},
                "load": {"in_flight": self.in_flight, "queue_depth": self.queue_depth,
                         "max_concurrency": self.cfg.concurrency, "max_queue": self.cfg.max_queue,
                         "gpu_util": self.gpu_util()},
                **self.metrics.snapshot(),
                "gpu_memory": {**(b.memory() if b and self.ready else {}),
                               "device_used_mb": self.gpu.last.get("memory_used_mb"),
                               "device_total_mb": self.gpu.last.get("memory_total_mb")},
                "cold_start": self.cold_start,
                "config": asdict(self.cfg),
            }
  inference-forecast-py: |
    """Turn an API.md forecast request into model rows, and model output into the response.

    Works on plain dicts so this module (and the bench) does not need pydantic.
    """
    from __future__ import annotations

    import math
    from datetime import UTC, datetime, timedelta

    import numpy as np

    from .model import FEATURES, MODEL_VERSION

    CONTRACT_VERSION = "1.0"  # kept equal to contract.CONTRACT_VERSION by a test
    _TWO_PI = 2 * math.pi


    def issue_time() -> datetime:
        return datetime.now(UTC).replace(minute=0, second=0, microsecond=0)


    def build_rows(lat: float, lon: float, members: int, issued: datetime) -> np.ndarray:
        """One row per ensemble member. Member 0 is unperturbed; the rest get a fixed nudge."""
        la, lo = math.radians(lat), math.radians(lon)
        hour = (issued.hour + lon / 15) % 24 / 24 * _TWO_PI
        doy = issued.timetuple().tm_yday / 365.25 * _TWO_PI
        base = np.array([math.sin(la), math.cos(la), math.sin(lo), math.cos(lo),
                         math.sin(hour), math.cos(hour), math.sin(doy), math.cos(doy)], np.float32)
        x = np.tile(base, (members, 1))
        for m in range(1, members):
            x[m] += 0.05 * np.random.default_rng(m).standard_normal(FEATURES).astype(np.float32)
        return x


    def to_physical(y: np.ndarray, lat: float, lon: float, issued: datetime, leads: list[int]) -> np.ndarray:
        """Map model output in [-1, 1] to temp_c, wind_ms, precip_mm, pressure_hpa at `leads`.

        y is (members, hours, 4) with one step per hour. Returns (members, len(leads), 4).
        """
        idx = np.array(leads) - 1
        y = y[:, idx, :].astype(np.float64)
        local_hour = (issued.hour + np.array(leads) + lon / 15) % 24
        diurnal = 5 * np.sin((local_hour - 9) / 24 * _TWO_PI)
        out = np.empty_like(y)
        out[..., 0] = 27 - 0.45 * abs(lat) + diurnal + 4 * y[..., 0]
        out[..., 1] = np.maximum(0.0, 4 + 3 * y[..., 1])
        out[..., 2] = np.maximum(0.0, 2 * y[..., 2] - 0.5)
        out[..., 3] = 1013 + 8 * y[..., 3]
        return out.round(1)


    def _points(values: np.ndarray, leads: list[int], valid: list[str]) -> list[dict]:
        return [{"lead_hours": lead, "valid_time": vt, "temp_c": t, "wind_ms": w, "precip_mm": p, "pressure_hpa": q}
                for lead, vt, (t, w, p, q) in zip(leads, valid, values.tolist())]


    def build_response(req: dict, y: np.ndarray, issued: datetime, box: str, timing: dict) -> dict:
        """`req` is a validated ForecastRequest as a dict; the result matches ForecastResponse."""
        hours, step, members = req["hours_ahead"], req.get("step_hours", 1), req.get("ensemble_members", 1)
        leads = list(range(step, hours + 1, step))
        valid = [(issued + timedelta(hours=h)).strftime("%Y-%m-%dT%H:%M:%SZ") for h in leads]
        phys = to_physical(y, req["lat"], req["lon"], issued, leads)
        if members > 1:
            member_list = [{"member": m, "points": _points(phys[m], leads, valid)} for m in range(members)]
            forecast = _points(phys.mean(axis=0).round(1), leads, valid)
        else:
            member_list, forecast = None, _points(phys[0], leads, valid)
        return {
            "request_id": req.get("request_id"), "box": box, "model_version": MODEL_VERSION,
            "contract_version": CONTRACT_VERSION, "issued_at": issued.strftime("%Y-%m-%dT%H:%M:%SZ"),
            "lat": req["lat"], "lon": req["lon"], "hours_ahead": hours, "step_hours": step,
            "low_confidence": hours > 72, "forecast": forecast, "members": member_list, "timing": timing,
        }
  inference-gpu-py: |
    """GPU utilisation and memory from nvidia-smi, sampled on a background thread.

    /stats must stay cheap, so readers only ever see the last sample. On machines
    without nvidia-smi (laptops) every field is None and callers fall back to
    in_flight / max_concurrency.
    """
    from __future__ import annotations

    import shutil
    import socket
    import subprocess
    import threading

    QUERY = "utilization.gpu,memory.used,memory.total,name"


    def _num(s: str):
        try:
            return float(s)
        except ValueError:  # "[N/A]" on unified-memory boxes such as DGX Spark
            return None


    def parse_smi(line: str) -> dict:
        parts = [p.strip() for p in line.split(",")]
        if len(parts) < 4:
            return {}
        util = _num(parts[0])
        return {"gpu_util": None if util is None else round(util / 100, 3),
                "memory_used_mb": _num(parts[1]), "memory_total_mb": _num(parts[2]),
                "name": ",".join(parts[3:]).strip()}


    def query_smi(timeout: float = 2.0) -> dict:
        exe = shutil.which("nvidia-smi")
        if not exe:
            return {}
        try:
            out = subprocess.run([exe, f"--query-gpu={QUERY}", "--format=csv,noheader,nounits"],
                                 capture_output=True, text=True, timeout=timeout, check=True).stdout
        except (subprocess.SubprocessError, OSError):
            return {}
        lines = out.strip().splitlines()
        return parse_smi(lines[0]) if lines else {}


    class GpuMonitor:
        def __init__(self, interval_s: float = 1.0):
            self.interval_s = interval_s
            self.last: dict = {}
            self._stop = threading.Event()
            self._thread: threading.Thread | None = None

        def start(self) -> None:
            if self._thread or not shutil.which("nvidia-smi"):
                return
            self.last = query_smi()
            self._thread = threading.Thread(target=self._run, name="gpu-monitor", daemon=True)
            self._thread.start()

        def _run(self) -> None:
            while not self._stop.wait(self.interval_s):
                self.last = query_smi() or self.last

        def stop(self) -> None:
            self._stop.set()


    def _run(cmd: list[str]) -> str:
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=3, check=True).stdout.strip()
        except (subprocess.SubprocessError, OSError):
            return ""


    def node_identity() -> dict:
        """Which machine and which GPU this process is on, to prove two boxes are on different nodes."""
        smi = shutil.which("nvidia-smi")
        uuid = _run([smi, "--query-gpu=uuid", "--format=csv,noheader"]).splitlines() if smi else []
        return {"hostname": socket.gethostname(),
                "addresses": _run(["hostname", "-I"]).split() if shutil.which("hostname") else [],
                "gpu_uuid": uuid[0].strip() if uuid else None}
  inference-metrics-py: |
    """Latency, throughput and error bookkeeping, plus JSON-lines logging."""
    from __future__ import annotations

    import json
    import logging
    import sys
    import time
    from collections import deque

    METRICS_SCHEMA = "wxrouter.inference.metrics/v1"


    def percentile(values, q: float) -> float:
        """Linear-interpolated percentile, q in 0..1. Empty input gives 0."""
        if not values:
            return 0.0
        s = sorted(values)
        pos = q * (len(s) - 1)
        lo = int(pos)
        hi = min(lo + 1, len(s) - 1)
        return s[lo] + (s[hi] - s[lo]) * (pos - lo)


    def latency_summary(values) -> dict:
        vals = list(values)
        return {"count": len(vals),
                "mean": round(sum(vals) / len(vals), 3) if vals else 0.0,
                "p50": round(percentile(vals, 0.50), 3),
                "p95": round(percentile(vals, 0.95), 3),
                "p99": round(percentile(vals, 0.99), 3),
                "max": round(max(vals), 3) if vals else 0.0}


    class MetricsRecorder:
        """Counters for one engine. Only touched from the event loop, so no locks."""

        def __init__(self, window: int = 2000, rate_window_s: float = 10.0):
            self.started = time.monotonic()
            self.rate_window_s = rate_window_s
            self.total_ms: deque[float] = deque(maxlen=window)
            self.queue_ms: deque[float] = deque(maxlen=window)
            self.compute_ms: deque[float] = deque(maxlen=window)
            self.done: deque[tuple[float, int]] = deque(maxlen=20000)  # (finish time, rows)
            self.ewma_ms = 0.0
            self.requests_total = 0  # finished, ok or not, plus rejected
            self.errors_total = 0
            self.timeouts = 0
            self.rejected = 0
            self.retries = 0
            self.batches = 0
            self.batch_rows = 0
            self.batch_requests = 0

        def ok(self, queue_ms: float, compute_ms: float, total_ms: float, rows: int) -> None:
            self.requests_total += 1
            self.total_ms.append(total_ms)
            self.queue_ms.append(queue_ms)
            self.compute_ms.append(compute_ms)
            self.done.append((time.monotonic(), rows))
            self.ewma_ms = total_ms if self.ewma_ms == 0 else 0.8 * self.ewma_ms + 0.2 * total_ms

        def error(self, kind: str) -> None:
            self.requests_total += 1
            self.errors_total += 1
            if kind == "timeout":
                self.timeouts += 1
            elif kind == "rejected":
                self.rejected += 1

        def batch(self, requests: int, rows: int) -> None:
            self.batches += 1
            self.batch_requests += requests
            self.batch_rows += rows

        def throughput(self) -> dict:
            now = time.monotonic()
            span = min(self.rate_window_s, max(now - self.started, 1e-6))
            recent = [rows for t, rows in self.done if now - t <= span]
            return {"window_s": round(span, 2),
                    "requests_per_s": round(len(recent) / span, 2),
                    "rows_per_s": round(sum(recent) / span, 2)}

        def snapshot(self) -> dict:
            n = self.requests_total
            return {
                "latency_ms": {"ewma": round(self.ewma_ms, 3), **latency_summary(self.total_ms)},
                "queue_ms": latency_summary(self.queue_ms),
                "compute_ms": latency_summary(self.compute_ms),
                "throughput": self.throughput(),
                "errors": {"requests_total": n, "errors_total": self.errors_total,
                           "error_rate": round(self.errors_total / n, 5) if n else 0.0,
                           "timeouts": self.timeouts, "rejected": self.rejected, "retries": self.retries},
                "batches": {"count": self.batches,
                            "mean_requests": round(self.batch_requests / self.batches, 2) if self.batches else 0.0,
                            "mean_rows": round(self.batch_rows / self.batches, 2) if self.batches else 0.0},
            }


    class JsonFormatter(logging.Formatter):
        def format(self, record: logging.LogRecord) -> str:
            out = {"ts": round(record.created, 3), "level": record.levelname, "event": record.getMessage()}
            out.update(getattr(record, "fields", {}))
            if record.exc_info:
                out["exc"] = self.formatException(record.exc_info)
            return json.dumps(out, default=str)


    def setup_logging(level: str = "INFO") -> None:
        """One JSON object per line on stderr, so stdout stays clean for results."""
        handler = logging.StreamHandler(sys.stderr)
        handler.setFormatter(JsonFormatter())
        log = logging.getLogger("wxrouter.inference")
        log.handlers[:] = [handler]
        log.setLevel(level.upper())
        log.propagate = False


    def log_event(event: str, level: int = logging.INFO, **fields) -> None:
        logging.getLogger("wxrouter.inference").log(level, event, extra={"fields": fields})
  inference-model-py: |
    """Tiny autoregressive forecast model with a torch (GPU) and a numpy (CPU) backend.

    The weights are seeded random numbers, NOT a trained weather model. The point is
    a real GPU workload whose cost grows with forecast length and ensemble size, the
    same way the mock's cost model does. Swap in the weather team's model by writing
    another backend with the same `rollout()` signature.

    One forecast hour is `layers` residual blocks on a `hidden`-wide state. A rollout
    of `steps` hours returns one 4-vector in [-1, 1] per hour; forecast.py turns that
    into temperature, wind, precipitation and pressure.
    """
    from __future__ import annotations

    import numpy as np

    FEATURES = 8
    OUTPUTS = 4
    MODEL_VERSION = "wx-tiny-untrained-0.1"


    def init_weights(hidden: int, layers: int, seed: int) -> dict[str, np.ndarray]:
        rng = np.random.default_rng(seed)

        def mat(i: int, o: int, gain: float = 1.0) -> np.ndarray:
            return (rng.standard_normal((i, o)) * gain / np.sqrt(i)).astype(np.float32)

        w = {"enc_w": mat(FEATURES, hidden), "enc_b": np.zeros(hidden, np.float32)}
        for i in range(layers):
            w[f"w1_{i}"] = mat(hidden, hidden)
            w[f"b1_{i}"] = np.zeros(hidden, np.float32)
            w[f"w2_{i}"] = mat(hidden, hidden, 0.5)
            w[f"b2_{i}"] = np.zeros(hidden, np.float32)
        w["dec_w"] = mat(hidden, OUTPUTS)
        w["dec_b"] = np.zeros(OUTPUTS, np.float32)
        return w


    def sort_by_horizon(row_steps, steps: int, rows: int):
        """For a batch whose rows want different forecast lengths: the order that puts the longest
        first, and how many rows are still running at each hour. (None, all rows) when they all match."""
        if row_steps is None or len(set(row_steps)) <= 1:
            return None, [rows] * steps
        rs = np.asarray(row_steps)
        order = np.argsort(-rs, kind="stable")
        return order, [int((rs > t).sum()) for t in range(steps)]


    def unsort(out: np.ndarray, order) -> np.ndarray:
        if order is None:
            return out
        res = np.empty_like(out)
        res[order] = out
        return res


    class NumpyBackend:
        """CPU fallback that needs only numpy. Same weights and maths as TorchBackend."""

        name = "numpy"
        device = "cpu"
        device_name = "cpu (numpy)"
        precision = "fp32"

        def __init__(self, hidden: int, layers: int, seed: int):
            self.w = init_weights(hidden, layers, seed)
            self.layers = layers

        def rollout(self, x: np.ndarray, steps: int, row_steps=None) -> np.ndarray:
            w = self.w
            order, live = sort_by_horizon(row_steps, steps, x.shape[0])
            if order is not None:
                x = x[order]
            h = np.tanh(x @ w["enc_w"] + w["enc_b"])
            out = np.zeros((x.shape[0], steps, OUTPUTS), np.float32)
            for t in range(steps):
                n = live[t]
                h = h[:n]  # rows whose forecast has ended drop out of the batch
                for i in range(self.layers):
                    h = h + np.tanh(h @ w[f"w1_{i}"] + w[f"b1_{i}"]) @ w[f"w2_{i}"] + w[f"b2_{i}"]
                h = np.tanh(h)
                out[:n, t] = np.tanh(h @ w["dec_w"] + w["dec_b"])
            return unsort(out, order)

        def memory(self) -> dict:
            return {}

        def reset_peak_memory(self) -> None:
            pass


    class TorchBackend:
        name = "torch"

        def __init__(self, hidden: int, layers: int, seed: int, device: str, amp: bool):
            import torch

            self.torch = torch
            self.device = device
            self.layers = layers
            self.amp = amp and device == "cuda"
            self.precision = "fp16-autocast" if self.amp else "fp32"
            if device == "cuda":
                self.device_name = torch.cuda.get_device_name(0)
                torch.backends.cuda.matmul.allow_tf32 = True
            else:
                self.device_name = device
            self.w = {k: torch.from_numpy(v).to(device) for k, v in init_weights(hidden, layers, seed).items()}

        def rollout(self, x: np.ndarray, steps: int, row_steps=None) -> np.ndarray:
            torch, w = self.torch, self.w
            order, live = sort_by_horizon(row_steps, steps, x.shape[0])
            if order is not None:
                x = x[order]
            try:
                with torch.inference_mode(), torch.autocast("cuda", dtype=torch.float16, enabled=self.amp):
                    h = torch.tanh(torch.from_numpy(x).to(self.device) @ w["enc_w"] + w["enc_b"])
                    out = torch.zeros((x.shape[0], steps, OUTPUTS), dtype=h.dtype, device=self.device)
                    for t in range(steps):
                        n = live[t]
                        if n < h.shape[0]:
                            h = h[:n]  # rows whose forecast has ended drop out of the batch
                        for i in range(self.layers):
                            h = torch.addmm(w[f"b2_{i}"], torch.tanh(torch.addmm(w[f"b1_{i}"], h, w[f"w1_{i}"])),
                                            w[f"w2_{i}"]) + h
                        h = torch.tanh(h)
                        out[:n, t] = torch.tanh(torch.addmm(w["dec_b"], h, w["dec_w"]))
                return unsort(out.float().cpu().numpy(), order)  # .cpu() waits for the GPU, so timings are honest
            except torch.OutOfMemoryError:
                torch.cuda.empty_cache()  # give the retry a chance
                raise

        def memory(self) -> dict:
            if self.device != "cuda":
                return {}
            cuda, mb = self.torch.cuda, 1024 * 1024
            return {"allocated_mb": round(cuda.memory_allocated() / mb, 1),
                    "reserved_mb": round(cuda.memory_reserved() / mb, 1),
                    "peak_allocated_mb": round(cuda.max_memory_allocated() / mb, 1)}

        def reset_peak_memory(self) -> None:
            if self.device == "cuda":
                self.torch.cuda.reset_peak_memory_stats()


    def make_backend(cfg):
        """Pick the backend and device. Falls back to CPU unless cfg.require_gpu."""
        torch = None
        if cfg.backend in ("auto", "torch"):
            try:
                import torch
            except ImportError:
                if cfg.backend == "torch":
                    raise
        cuda = bool(torch and torch.cuda.is_available())
        if (cfg.require_gpu or cfg.device == "cuda") and not cuda:
            raise RuntimeError("CUDA GPU required but not available "
                               f"(torch={'missing' if torch is None else torch.__version__})")
        if torch is None:
            return NumpyBackend(cfg.hidden, cfg.layers, cfg.seed)
        device = cfg.device if cfg.device != "auto" else ("cuda" if cuda else "cpu")
        return TorchBackend(cfg.hidden, cfg.layers, cfg.seed, device, cfg.amp)
  inference-report-py: |
    """Turn benchmark JSON into one self-contained HTML report with charts and tables.

      python -m inference.report --bench results/inference/<run>/bench.json \\
          [--cluster results/cluster/<run>/cluster_bench.json] [--afno results/afno/<run>/afno_check.json] \\
          --out results/report.html

    Standard library only. Every chart is inline SVG with a hover tooltip on each
    mark and the same numbers in a table underneath. Sections whose input file is
    not given are left out, so the report never shows a chart without data.
    """
    from __future__ import annotations

    import argparse
    import html
    import json
    from pathlib import Path

    # Two categorical slots, validated for colour-blind separation on both surfaces (dataviz palette).
    CSS = """
    :root { --surface:#fcfcfb; --page:#f9f9f7; --ink:#0b0b0b; --ink2:#52514e; --muted:#898781; --grid:#e1e0d9;
            --axis:#c3c2b7; --s1:#2a78d6; --s2:#eb6834; --event:#898781; }
    @media (prefers-color-scheme: dark) {
      :root { --surface:#1a1a19; --page:#0d0d0d; --ink:#f0efec; --ink2:#c3c2b7; --muted:#898781; --grid:#2c2c2a;
              --axis:#383835; --s1:#3987e5; --s2:#d95926; --event:#898781; } }
    body { background:var(--page); color:var(--ink); font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif;
           margin:0; padding:32px; max-width:980px; margin-inline:auto; }
    h1 { font-size:24px; margin:0 0 4px; } h2 { font-size:18px; margin:40px 0 4px; } h3 { font-size:15px; margin:0 0 2px; }
    p, li { color:var(--ink2); } p.lead { color:var(--ink); }
    .tag { display:inline-block; font-size:12px; padding:1px 8px; border:1px solid var(--axis); border-radius:10px;
           color:var(--ink2); margin-left:6px; vertical-align:middle; }
    figure { background:var(--surface); border:1px solid var(--grid); border-radius:8px; padding:16px; margin:16px 0; }
    figcaption { color:var(--ink2); font-size:13px; margin-bottom:8px; }
    svg { width:100%; height:auto; display:block; } svg text { fill:var(--ink2); font-size:12px; }
    svg .val { fill:var(--ink); } svg .axis { stroke:var(--axis); } svg .grid { stroke:var(--grid); }
    .legend { display:flex; gap:16px; font-size:13px; color:var(--ink2); margin:4px 0 8px; }
    .legend i { display:inline-block; width:12px; height:12px; border-radius:3px; margin-right:6px; vertical-align:-1px; }
    .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:12px; margin:16px 0; }
    .tile { background:var(--surface); border:1px solid var(--grid); border-radius:8px; padding:12px 14px; }
    .tile b { display:block; font-size:24px; color:var(--ink); } .tile span { font-size:13px; color:var(--ink2); }
    table { border-collapse:collapse; width:100%; font-size:13px; margin-top:8px; }
    th, td { text-align:right; padding:4px 8px; border-bottom:1px solid var(--grid); color:var(--ink2); }
    th:first-child, td:first-child { text-align:left; } th { color:var(--ink); font-weight:600; }
    details summary { cursor:pointer; color:var(--ink2); font-size:13px; }
    """

    W, H, L, R, T, B = 720, 300, 56, 16, 16, 40


    def esc(v) -> str:
        return html.escape(str(v))


    def fmt(v: float) -> str:
        if v is None:
            return ""
        return f"{v:,.0f}" if abs(v) >= 100 else f"{v:,.1f}" if abs(v) >= 10 else f"{v:,.2f}"


    def nice_max(v: float) -> float:
        if v <= 0:
            return 1.0
        mag = 10 ** (len(str(int(v))) - 1)
        for m in (1, 2, 2.5, 5, 10):
            if v <= m * mag:
                return m * mag
        return 10 * mag


    def frame(ymax: float, unit: str) -> list[str]:
        out = []
        for k in range(5):
            y = T + (H - T - B) * (1 - k / 4)
            out.append(f'<line class="{"axis" if k == 0 else "grid"}" x1="{L}" x2="{W - R}" y1="{y:.1f}" y2="{y:.1f}"/>')
            out.append(f'<text x="{L - 8}" y="{y + 4:.1f}" text-anchor="end">{fmt(ymax * k / 4)}</text>')
        out.append(f'<text x="{L + 6}" y="{T + 4}" text-anchor="start">{esc(unit)}</text>')
        return out


    def table(head: list[str], rows: list[list]) -> str:
        th = "".join(f"<th>{esc(h)}</th>" for h in head)
        body = "".join("<tr>" + "".join(f"<td>{esc(c)}</td>" for c in r) + "</tr>" for r in rows)
        return f"<details><summary>Data table</summary><table><tr>{th}</tr>{body}</table></details>"


    def legend(names: list[str]) -> str:
        if len(names) < 2:
            return ""
        return '<div class="legend">' + "".join(
            f'<span><i style="background:var(--s{i + 1})"></i>{esc(n)}</span>' for i, n in enumerate(names)) + "</div>"


    def bars(title: str, caption: str, cats: list[str], series: dict[str, list[float]], unit: str, xlabel: str) -> str:
        """Grouped bars: one group per category, one bar per series, a value label on every bar."""
        names = list(series)
        ymax = nice_max(max(max(v) for v in series.values()))
        plot_w, plot_h = W - L - R, H - T - B
        group = plot_w / len(cats)
        bw = min(46, (group - 24) / len(names) - 2)
        svg = frame(ymax, unit)
        for ci, cat in enumerate(cats):
            x0 = L + group * ci + (group - (bw + 2) * len(names)) / 2
            for si, name in enumerate(names):
                v = series[name][ci]
                h = plot_h * v / ymax
                x, y = x0 + (bw + 2) * si, T + plot_h - h
                r = min(4, h)
                path = (f"M{x:.1f},{T + plot_h:.1f} V{y + r:.1f} Q{x:.1f},{y:.1f} {x + r:.1f},{y:.1f} H{x + bw - r:.1f} "
                        f"Q{x + bw:.1f},{y:.1f} {x + bw:.1f},{y + r:.1f} V{T + plot_h:.1f} Z")
                svg.append(f'<path d="{path}" fill="var(--s{si + 1})"><title>{esc(name)}, {esc(cat)} {esc(xlabel)}: '
                           f'{fmt(v)} {esc(unit)}</title></path>')
                svg.append(f'<text class="val" x="{x + bw / 2:.1f}" y="{y - 5:.1f}" text-anchor="middle">{fmt(v)}</text>')
            svg.append(f'<text x="{L + group * (ci + 0.5):.1f}" y="{H - B + 16}" text-anchor="middle">{esc(cat)}</text>')
        svg.append(f'<text x="{L + plot_w / 2:.1f}" y="{H - 6}" text-anchor="middle">{esc(xlabel)}</text>')
        rows = [[c] + [fmt(series[n][i]) for n in names] for i, c in enumerate(cats)]
        return (f"<figure><h3>{esc(title)}</h3><figcaption>{esc(caption)}</figcaption>{legend(names)}"
                f'<svg viewBox="0 0 {W} {H}" role="img" aria-label="{esc(title)}">{"".join(svg)}</svg>'
                f"{table([xlabel] + [f'{n} ({unit})' for n in names], rows)}</figure>")


    def lines(title: str, caption: str, xs: list[float], series: dict[str, list[float | None]], unit: str, xlabel: str,
              events: list[tuple[float, str]] = (), tick_labels: list[str] | None = None) -> str:
        """Lines over a numeric x axis, a marker with a tooltip at every point, optional event markers."""
        names = list(series)
        ymax = nice_max(max((v for s in series.values() for v in s if v is not None), default=1))
        xmin, xmax = min(xs), max(xs)
        plot_w, plot_h = W - L - R, H - T - B

        def px(x: float) -> float:
            return L + plot_w * (x - xmin) / max(xmax - xmin, 1e-9)

        def py(v: float) -> float:
            return T + plot_h * (1 - v / ymax)

        svg = frame(ymax, unit)
        for t, label in events:
            svg.append(f'<line x1="{px(t):.1f}" x2="{px(t):.1f}" y1="{T}" y2="{T + plot_h}" stroke="var(--event)" '
                       f'stroke-dasharray="3 3"><title>{esc(label)} at {t:g} s</title></line>')
            svg.append(f'<text x="{px(t) + 4:.1f}" y="{T + 12}" text-anchor="start">{esc(label)}</text>')
        for si, name in enumerate(names):
            pts = [(px(x), py(v), x, v) for x, v in zip(xs, series[name]) if v is not None]
            if not pts:
                continue
            d = " ".join(f"{'M' if i == 0 else 'L'}{x:.1f},{y:.1f}" for i, (x, y, _, _) in enumerate(pts))
            svg.append(f'<path d="{d}" fill="none" stroke="var(--s{si + 1})" stroke-width="2"/>')
            for x, y, xv, v in pts:
                svg.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="7" fill="transparent"><title>{esc(name)} at {esc(tick_labels[int(xv)]) if tick_labels else f"{xv:g}"} '
                           f'{esc(xlabel)}: {fmt(v)} {esc(unit)}</title></circle>')
                if len(pts) <= 12:
                    svg.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="4" fill="var(--s{si + 1})" stroke="var(--surface)" '
                               f'stroke-width="2" pointer-events="none"/>')
            if len(names) > 1:
                x, y, _, _ = pts[-1]
                svg.append(f'<text class="val" x="{min(x + 6, W - R - 4):.1f}" y="{y - 8:.1f}" text-anchor="end">{esc(name)}</text>')
        ticks = xs if len(xs) <= 8 else [xmin + (xmax - xmin) * k / 6 for k in range(7)]
        for i, x in enumerate(ticks):
            label = tick_labels[i] if tick_labels else f"{x:g}"
            svg.append(f'<text x="{px(x):.1f}" y="{H - B + 16}" text-anchor="middle">{esc(label)}</text>')
        svg.append(f'<text x="{L + plot_w / 2:.1f}" y="{H - 6}" text-anchor="middle">{esc(xlabel)}</text>')
        rows = [[tick_labels[i] if tick_labels else f"{x:g}"] + [fmt(series[n][i]) for n in names] for i, x in enumerate(xs)]
        return (f"<figure><h3>{esc(title)}</h3><figcaption>{esc(caption)}</figcaption>{legend(names)}"
                f'<svg viewBox="0 0 {W} {H}" role="img" aria-label="{esc(title)}">{"".join(svg)}</svg>'
                f"{table([xlabel] + [f'{n} ({unit})' for n in names], rows)}</figure>")


    def tiles(items: list[tuple[str, str]]) -> str:
        return '<div class="tiles">' + "".join(f'<div class="tile"><b>{esc(v)}</b><span>{esc(k)}</span></div>'
                                               for k, v in items) + "</div>"


    def kind(env: dict) -> str:
        return "real GPU" if env.get("device") == "cuda" else "CPU only"


    def bench_section(b: dict) -> str:
        env, cold = b["environment"], b["cold_start"]
        serving = b["serving"]
        clients = sorted({r["clients"] for r in serving})

        def pick(mode: str, key) -> list[float]:
            return [key(next(r for r in serving if r["clients"] == c and r["mode"] == mode)) for c in clients]

        top = max(clients)
        base = next(r for r in serving if r["clients"] == top and r["mode"] == "baseline")
        bat = next(r for r in serving if r["clients"] == top and r["mode"] == "batched")
        out = [f'<h2>One GPU: batching <span class="tag">{kind(env)}</span></h2>',
               (f"<p>{esc(env['device_name'])}, {esc(env['backend'])} {esc(env.get('torch', ''))}, {esc(env['precision'])}, "
               f"model <code>{esc(env['model_version'])}</code> (a seeded stand-in, not a trained weather model). "
               f"{b['params']['hours_ahead']} h forecasts. Run at {esc(b['created_at'])}.</p>"),
               tiles([(f"req/s at {top} clients, batched", fmt(bat["requests_per_s"])),
                      (f"req/s at {top} clients, no batching", fmt(base["requests_per_s"])),
                      ("p95 latency, batched", f"{fmt(bat['latency_ms']['p95'])} ms"),
                      ("p95 latency, no batching", f"{fmt(base['latency_ms']['p95'])} ms"),
                      ("cold start: load + first inference", f"{fmt(cold['load_ms'] + cold['first_inference_ms'])} ms"),
                      ("warm inference (12 h, 1 row)", f"{fmt(cold['warm_inference_ms'])} ms")]),
               bars("Throughput by number of clients", "Requests completed per second. Higher is better.",
                    [str(c) for c in clients], {"no batching": pick("baseline", lambda r: r["requests_per_s"]),
                                                "batched": pick("batched", lambda r: r["requests_per_s"])},
                    "req/s", "concurrent clients"),
               bars("p95 latency by number of clients", "What the slowest 5% of requests waited. Lower is better.",
                    [str(c) for c in clients], {"no batching": pick("baseline", lambda r: r["latency_ms"]["p95"]),
                                                "batched": pick("batched", lambda r: r["latency_ms"]["p95"])},
                    "ms", "concurrent clients"),
               lines("Rows per second by batch size", "One model call per batch; a row is one ensemble member.",
                     list(range(len(b["batch_sweep"]))), {"rows/s": [r["rows_per_s"] for r in b["batch_sweep"]]},
                     "rows/s", "rows per call", tick_labels=[str(r["batch_rows"]) for r in b["batch_sweep"]])]
        if b.get("precision"):
            rows = [[r["precision"], r["batch_rows"], fmt(r["latency_ms"]["p50"]), fmt(r["rows_per_s"]),
                     r["gpu_memory"].get("peak_allocated_mb", ""), r.get("max_abs_diff_vs_fp32", ""),
                     r.get("numerically_valid", "")] for r in b["precision"]]
            th = "".join(f"<th>{h}</th>" for h in ["precision", "rows", "p50 ms", "rows/s", "peak GPU MB",
                                                    "max diff vs fp32", "valid"])
            out.append("<figure><h3>fp32 vs fp16 autocast</h3><figcaption>Outputs are in [-1, 1]; fp16 counts as valid only "
                       f"within 0.05 of fp32.</figcaption><table><tr>{th}</tr>"
                       + "".join("<tr>" + "".join(f"<td>{esc(c)}</td>" for c in r) + "</tr>" for r in rows)
                       + "</table></figure>")
        return "".join(out)


    def cluster_section(c: dict) -> str:
        place = c["placement"]
        cuda = all((p.get("device") or {}).get("type") == "cuda" for p in place.values())
        out = [f'<h2>Two GPUs: routing policies <span class="tag">{"real GPU" if cuda else "CPU only"}</span></h2><ul>']
        for name, p in place.items():
            node, dev = p.get("node") or {}, p.get("device") or {}
            out.append(f"<li><b>{esc(name)}</b>: {esc(dev.get('name'))}, node {esc((node.get('addresses') or ['?'])[0])}, "
                       f"GPU {esc(node.get('gpu_uuid'))}</li>")
        out.append(f"<li>On different GPU nodes: <b>{esc(c['distinct_nodes'])}</b></li></ul>")
        cal = c.get("calibration")
        if cal:
            out.append(f"<p>Slow mode is a real second load on the box's GPU. On an idle box one 48 h forecast went from "
                       f"{cal['compute_ms_normal']} ms to {cal['compute_ms_slow']} ms ({cal['measured_slowdown']}x).</p>")
        cases = c["cases"]
        [x["label"] for x in cases]
        head = ["case", "requests", "errors", "p50 ms", "p95 ms", "p99 ms", "ok/s", "box A %", "box B %", "failovers", "switches"]
        rows = [[x["label"], x["summary"]["requests"], x["summary"]["errors"], x["summary"]["p50_ms"], x["summary"]["p95_ms"],
                 x["summary"]["p99_ms"], x["summary"]["ok_per_s"], x["summary"]["share_a_pct"], x["summary"]["share_b_pct"],
                 x["summary"]["failovers"], len(x["switches"])] for x in cases]
        th = "".join(f"<th>{h}</th>" for h in head)
        out.append(f"<figure><h3>Every case, same seeded trace ({c['params']['rps']} req/s offered)</h3><table><tr>{th}</tr>"
                   + "".join("<tr>" + "".join(f"<td>{esc(v)}</td>" for v in r) + "</tr>" for r in rows) + "</table></figure>")
        for prefix, title in (("single_gpu", "one GPU"), ("two_gpu", "two GPUs, no faults"), ("fault", "two GPUs with faults")):
            group = [x for x in cases if x["label"].startswith(prefix)]
            if not group:
                continue
            names = [x["label"].replace(prefix + "_", "") for x in group]
            out.append(bars(f"Latency, {title}", "p50 and p95 of successful requests, as the client saw them.",
                            names, {"p50": [x["summary"]["p50_ms"] for x in group],
                                    "p95": [x["summary"]["p95_ms"] for x in group]}, "ms", "case"))
            if prefix != "single_gpu":
                out.append(bars(f"Where requests went, {title}", "Share of successful requests served by each box.",
                                names, {"box A": [x["summary"]["share_a_pct"] for x in group],
                                        "box B": [x["summary"]["share_b_pct"] for x in group]}, "%", "case"))
        for x in cases:
            if not x["label"].startswith("fault"):
                continue
            tl = x["timeline"]
            xs = [s["t"] for s in tl]
            ev = [(e["t"], f"{e['action']} {e['box']}") for e in x["events"]]
            out.append(lines(f"Failure recovery timeline: {x['policy']}",
                             "Requests served per second by each box. Dashed lines are the faults.", xs,
                             {"box A": [s["served_by"].get("box-a", 0) for s in tl],
                              "box B": [s["served_by"].get("box-b", 0) for s in tl]}, "req/s", "seconds", ev))
            out.append(lines(f"p95 latency over time: {x['policy']}", "Per second of send time.", xs,
                             {"p95": [s["p95_ms"] for s in tl]}, "ms", "seconds", ev))
            fr = x.get("fault_report") or {}
            notes = []
            if "slow" in fr:
                f = fr["slow"]
                notes.append(f"While {f['box']} was slowed its share went from {f['share_before_pct']}% to "
                             f"{f['share_during_pct']}%, with {f['errors_during']} errors.")
            if "stop" in fr:
                f = fr["stop"]
                notes.append(f"While {f['box']} was stopped there were {f['errors_while_down']} errors; it served again "
                             f"{f['seconds_to_serve_again']} s after its restart. {len(x['switches'])} switches in total.")
            if notes:
                out.append("<p>" + " ".join(esc(n) for n in notes) + "</p>")
        return "".join(out)


    def afno_section(a: dict) -> str:
        c = a["compare"]
        out = ['<h2>The trained weather model (AFNO) <span class="tag">real GPU</span></h2>',
               (f"<p>{esc(a['gpu'])}. The team's server and the engine loaded the same weights "
               f"(<code>{esc(a['servers'][0]['model_version'])}</code>). {c['points_compared']} forecast points compared: "
               f"largest difference {c['max_abs_diff']['temp_c']} C, {c['max_abs_diff']['wind_ms']} m/s, "
               f"{c['max_abs_diff']['pressure_hpa']} hPa. Agree: <b>{c['agree']}</b>.</p>")]
        clients = [r["clients"] for r in a["servers"][0]["load"]]
        by = {s["server"]: s["load"] for s in a["servers"]}
        names = {"team": "team server", "engine": "engine (batched)"}
        out.append(bars("AFNO throughput by number of clients", "One 48 h forecast per request.", [str(k) for k in clients],
                        {names[k]: [r["requests_per_s"] for r in v] for k, v in by.items()}, "req/s", "concurrent clients"))
        out.append(bars("AFNO p95 latency by number of clients", "Lower is better.", [str(k) for k in clients],
                        {names[k]: [r["p95_ms"] for r in v] for k, v in by.items()}, "ms", "concurrent clients"))
        return "".join(out)


    def build(bench: list[dict], cluster: dict | None, afno: dict | None) -> str:
        body = ["<h1>wxrouter inference report</h1>",
                '<p class="lead">Every number below was measured. Each section says whether it ran on a real GPU or on a CPU.</p>']
        body += [bench_section(b) for b in bench]
        if cluster:
            body.append(cluster_section(cluster))
        if afno:
            body.append(afno_section(afno))
        return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" '
                f'content="width=device-width,initial-scale=1"><title>wxrouter inference report</title><style>{CSS}</style>'
                f'</head><body>{"".join(body)}</body></html>')


    def main() -> None:
        ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
        ap.add_argument("--bench", action="append", default=[], help="bench.json; repeat for several runs")
        ap.add_argument("--cluster", help="cluster_bench.json")
        ap.add_argument("--afno", help="afno_check.json")
        ap.add_argument("--out", default="results/report.html")
        a = ap.parse_args()

        def load(p):
            return json.loads(Path(p).read_text()) if p else None

        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
        Path(a.out).write_text(build([load(p) for p in a.bench], load(a.cluster), load(a.afno)))
        print(f"wrote {a.out}")


    if __name__ == "__main__":
        main()
  inference-server-py: |
    """Real forecast server: the API.md contract backed by the inference engine.

    Drop-in replacement for mock_server.py, so the router needs no changes:

      python -m inference.server --box box-a --port 8001

    Adds one endpoint beyond the contract, `GET /v1/metrics`, with the full JSON
    metrics snapshot (latency p50/p95/p99, throughput, load, availability, GPU
    memory, node identity). `--metrics-file` also writes that snapshot to disk.

    While the model loads, /health answers 503 "down", so the router keeps traffic
    away until warm-up has finished.

    Test hooks, only with `--admin`:
      POST /admin/mode    {"mode": "normal"|"slow"|"error"|"hang", "slow_factor": 4}
                          same call as the mock, so loadgen.py events work unchanged.
                          "slow" starts a real load on the same GPU (contention.py).
      POST /admin/engine  {"max_batch_rows": 1}   change batching while running
      POST /admin/stop    {"down_s": 15}          exit the process; with --supervise
                          it is started again after down_s (a real stop and cold start)
    """
    from __future__ import annotations

    import argparse
    import asyncio
    import json
    import os
    import signal
    import subprocess
    import sys
    import tempfile
    import time
    from contextlib import asynccontextmanager

    import uvicorn
    from fastapi import FastAPI, HTTPException, Request
    from fastapi.responses import JSONResponse
    from pydantic import BaseModel, Field

    from contract import ForecastRequest, ForecastResponse, Health, Stats

    from .config import EngineConfig, add_engine_args, engine_config_from_args
    from .contention import Burner
    from .engine import InferenceEngine, InferenceError, InferenceTimeout, Overloaded
    from .forecast import build_response, build_rows, issue_time
    from .metrics import log_event, percentile, setup_logging
    from .model import MODEL_VERSION


    class AdminMode(BaseModel):
        mode: str = Field(..., pattern="^(normal|slow|error|hang)$")
        slow_factor: float = Field(3.0, ge=1.0, le=50.0)


    class AdminEngine(BaseModel):
        max_batch_rows: int = Field(..., ge=1, le=4096)


    class AdminStop(BaseModel):
        down_s: float = Field(10.0, ge=0.0, le=600.0)


    def write_json_atomic(path: str, data: dict) -> None:
        tmp = f"{path}.tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, path)


    def create_app(engine: InferenceEngine, metrics_file: str | None = None, metrics_interval_s: float = 2.0,
                   admin: bool = False, restart_file: str | None = None, service=None) -> FastAPI:
        """`service` is an inference.afno.AfnoService to serve the trained model; None serves the tiny one."""
        cfg = engine.cfg
        version = service.backend.model_version if service else MODEL_VERSION
        state = {"mode": "normal", "burner": None}

        async def dump_metrics() -> None:
            while True:
                await asyncio.sleep(metrics_interval_s)
                write_json_atomic(metrics_file, snapshot())

        @asynccontextmanager
        async def lifespan(app: FastAPI):
            tasks = [asyncio.create_task(engine.start())]  # load in the background; /health says "down" meanwhile
            if metrics_file:
                tasks.append(asyncio.create_task(dump_metrics()))
            yield
            if state["burner"]:
                state["burner"].clear()
            for t in tasks:
                t.cancel()
            await asyncio.gather(*tasks, return_exceptions=True)
            await engine.stop()

        app = FastAPI(title=f"wxrouter inference server ({cfg.box})", lifespan=lifespan)

        def snapshot() -> dict:
            snap = engine.snapshot()
            snap["mode"] = state["mode"]
            if state["mode"] == "error":
                snap["availability"]["status"] = "down"
            elif state["mode"] == "slow" and snap["availability"]["status"] == "ok":
                snap["availability"]["status"] = "degraded"
            return snap

        @app.post("/v1/forecast", response_model=ForecastResponse)
        async def forecast(req: ForecastRequest):
            t0 = time.perf_counter()
            if state["mode"] == "error":
                engine.metrics.error("rejected")
                raise HTTPException(503, "box unavailable (admin error mode)")
            if state["mode"] == "hang":
                await asyncio.sleep(3600)
            try:
                if service:
                    asked = req.model_dump()
                    x, steps, aux, ctx = await asyncio.to_thread(service.prepare, asked)
                    y, t = await engine.infer(x, steps, aux)
                else:
                    issued = issue_time()
                    y, t = await engine.infer(build_rows(req.lat, req.lon, req.ensemble_members, issued), req.hours_ahead)
            except (Overloaded, InferenceTimeout, LookupError) as e:
                raise HTTPException(503, str(e)) from e
            except InferenceError as e:
                raise HTTPException(500, str(e)) from e
            timing = {"queue_ms": round(t["queue_ms"], 2), "compute_ms": round(t["compute_ms"], 2), "total_ms": 0.0}
            if service:
                return JSONResponse(service.respond(asked, y, ctx, cfg.box, timing))
            body = build_response(req.model_dump(), y, issued, cfg.box, timing)
            timing["total_ms"] = round((time.perf_counter() - t0) * 1000, 2)
            return JSONResponse(body)  # already contract-shaped; skip a second validation pass

        @app.get("/health", response_model=Health)
        async def health():
            status = snapshot()["availability"]["status"]
            body = {"status": status, "box": cfg.box, "model_version": version, "contract_version": "1.0",
                    "uptime_s": round(time.monotonic() - engine.started, 1)}
            return JSONResponse(body, status_code=503 if status == "down" else 200)

        @app.get("/stats", response_model=Stats)
        async def stats():
            m = engine.metrics
            recent = list(m.total_ms)[-200:]
            return Stats(
                box=cfg.box, in_flight=engine.in_flight, queue_depth=engine.queue_depth,
                max_concurrency=cfg.concurrency, gpu_util=engine.gpu_util(),
                ewma_latency_ms=round(m.ewma_ms, 1),
                p50_latency_ms=round(percentile(recent, 0.50), 1),
                p95_latency_ms=round(percentile(recent, 0.95), 1),
                requests_total=m.requests_total, errors_total=m.errors_total,
                mode="training" if state["mode"] == "slow" else "normal",  # the contract's word for a busy GPU
            )

        @app.get("/v1/metrics")
        async def metrics():
            return snapshot()

        if not admin:
            return app

        @app.post("/admin/mode")
        async def set_mode(m: AdminMode):
            if not engine.ready:
                raise HTTPException(503, "engine not ready")
            if state["burner"] is None:
                state["burner"] = Burner(engine.backend)
            burner: Burner = state["burner"]
            await asyncio.to_thread(burner.set if m.mode == "slow" else burner.clear,
                                    *([m.slow_factor] if m.mode == "slow" else []))
            state["mode"] = m.mode
            log_event("admin_mode", box=cfg.box, mode=m.mode, slow_factor=m.slow_factor, burners=len(burner._threads))
            return {"box": cfg.box, "mode": m.mode, "slow_factor": m.slow_factor, "burner_threads": len(burner._threads)}

        @app.post("/admin/engine")
        async def set_engine(e: AdminEngine):
            cfg.max_batch_rows = e.max_batch_rows
            log_event("admin_engine", box=cfg.box, max_batch_rows=e.max_batch_rows)
            return {"box": cfg.box, "max_batch_rows": cfg.max_batch_rows}

        @app.post("/admin/stop")
        async def stop(s: AdminStop, request: Request):
            server = getattr(request.app.state, "server", None)
            if server is None:
                raise HTTPException(409, "not running under `python -m inference.server`")
            if restart_file:
                with open(restart_file, "w") as f:  # noqa: ASYNC230 - a few bytes, just before exit
                    f.write(str(s.down_s))
            log_event("admin_stop", box=cfg.box, down_s=s.down_s, restart=bool(restart_file))
            server.should_exit = True
            return {"box": cfg.box, "stopping": True, "down_s": s.down_s, "will_restart": bool(restart_file)}

        return app


    def supervise(argv: list[str]) -> int:
        """Run the server as a child and start it again after an /admin/stop. Ends when the child ends on its own."""
        fd, restart_file = tempfile.mkstemp(prefix="wx-restart-")
        os.close(fd)
        os.unlink(restart_file)
        child: subprocess.Popen | None = None

        def forward(signum, _frame):
            if child and child.poll() is None:
                child.send_signal(signum)

        signal.signal(signal.SIGTERM, forward)
        signal.signal(signal.SIGINT, forward)
        args = [a for a in argv if a != "--supervise"]
        while True:
            child = subprocess.Popen([sys.executable, "-m", "inference.server", *args, "--restart-file", restart_file])
            code = child.wait()
            if not os.path.exists(restart_file):
                return code
            with open(restart_file) as f:
                down_s = float(f.read().strip() or 0)
            os.unlink(restart_file)
            log_event("supervisor_restart", down_s=down_s, exit_code=code)
            time.sleep(down_s)


    def main() -> None:
        ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
        ap.add_argument("--name", help="alias for --box, to match mock_server.py")
        ap.add_argument("--host", default="127.0.0.1")
        ap.add_argument("--port", type=int, default=8001)
        ap.add_argument("--metrics-file", help="write the JSON metrics snapshot here every --metrics-interval s")
        ap.add_argument("--metrics-interval", type=float, default=2.0)
        ap.add_argument("--admin", action="store_true", help="enable the /admin test hooks")
        ap.add_argument("--supervise", action="store_true", help="restart the server after an /admin/stop")
        ap.add_argument("--restart-file", help=argparse.SUPPRESS)
        ap.add_argument("--model", choices=["tiny", "afno"], default="tiny",
                        help="tiny: the seeded stand-in; afno: the weather team's trained model (needs --weights, --data)")
        ap.add_argument("--weights", help="afno: the model file written by weather/train.py")
        ap.add_argument("--data", help="afno: the bundle folder (stats.json, states/)")
        ap.add_argument("--log-level", default="INFO")
        add_engine_args(ap)
        a = ap.parse_args()
        setup_logging(a.log_level)
        if a.supervise:
            sys.exit(supervise(sys.argv[1:]))
        if a.name:
            a.box = a.name
        cfg: EngineConfig = engine_config_from_args(a)
        log_event("server_start", box=cfg.box, host=a.host, port=a.port, admin=a.admin)
        engine, service = InferenceEngine(cfg), None
        if a.model == "afno":
            from .afno import AfnoBackend, AfnoService

            if not (a.weights and a.data):
                ap.error("--model afno needs --weights and --data")
            if cfg.max_batch_rows == EngineConfig.max_batch_rows:
                cfg.max_batch_rows = 20  # one row is a whole global state; the team's server also uses 20
            engine.backend = AfnoBackend(a.weights, a.data, "cuda" if cfg.require_gpu else cfg.device)
            if cfg.require_gpu and engine.backend.device != "cuda":
                raise SystemExit("CUDA GPU required but the AFNO model is on " + engine.backend.device)
            service = AfnoService(engine.backend)
        app = create_app(engine, a.metrics_file, a.metrics_interval, a.admin, a.restart_file, service)
        server = uvicorn.Server(uvicorn.Config(app, host=a.host, port=a.port, log_level="warning"))
        app.state.server = server
        server.run()


    if __name__ == "__main__":
        main()
volumes:
  results:
    name: wxdesk
jobs:
  gpu-smoke:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:26.02-py3
    files:
      /app/inference/__init__.py: file://inference-init-py
      /app/inference/afno.py: file://inference-afno-py
      /app/inference/afno_check.py: file://inference-afno-check-py
      /app/inference/bench.py: file://inference-bench-py
      /app/inference/cluster_bench.py: file://inference-cluster-bench-py
      /app/inference/config.py: file://inference-config-py
      /app/inference/contention.py: file://inference-contention-py
      /app/inference/engine.py: file://inference-engine-py
      /app/inference/forecast.py: file://inference-forecast-py
      /app/inference/gpu.py: file://inference-gpu-py
      /app/inference/metrics.py: file://inference-metrics-py
      /app/inference/model.py: file://inference-model-py
      /app/inference/report.py: file://inference-report-py
      /app/inference/server.py: file://inference-server-py
    script: |
      #!/bin/sh
      set -e
      echo "[gpu-smoke] host=$(hostname) arch=$(uname -m)"
      nvidia-smi || echo "[gpu-smoke] nvidia-smi not available"
      python -c "import torch; print('[gpu-smoke] torch', torch.__version__, 'cuda', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NO GPU')"
      cd /app
      python -m inference.bench --quick --require-gpu --emit-markers --out /wx/wxrouter-inference
    mounts:
      /wx: results
    resource:
      cpu:
        cores: 4
      memory:
        size: 16GB
      devices:
        nvidia.com/gpu: 1
    policy:
      timeout:
        execute: 15m
