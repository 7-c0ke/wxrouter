# Onprem Fuzzball settings. Copy to `env` on the control plane, fill in, then `source ./env` (with ./: a bare
# `source env` finds /usr/bin/env on PATH first and fails with "cannot execute binary file").
# No secrets here: the Depot access key and passwords are asked for at the prompt by the scripts.

# --- the control plane (40-core MicroK8s server)
export CP_IP=                       # its IP that both GPU servers can reach, e.g. 10.0.0.50
export INTERNAL_INTERFACE=          # its network interface for that IP, e.g. enp36s0f0 (ip -br addr)
export METALLB_RANGE=               # free IPs for MetalLB, e.g. 10.0.0.240-10.0.0.241 (or one: 10.0.0.240-10.0.0.240)
export METALLB_IP=                  # the first of them: the cluster's address
export DOMAIN="${METALLB_IP}.nip.io"  # api.$DOMAIN, auth.$DOMAIN, nats.$DOMAIN (nip.io needs internet DNS)

# --- CIQ Depot (from the CIQ portal, "my products")
export DEPOT_USER=                  # your Depot username (the access key is asked for, never stored)
export FUZZBALL_VERSION=            # e.g. 4.4.x, the version the portal offers

# --- Keycloak / first owner
export REALM_ID=                    # uuidgen
export OWNER_EMAIL=                 # the first owner's email

# --- storage and NFS
export STORAGE_CLASS=microk8s-hostpath   # MicroK8s' hostpath-storage addon (CIQ's single-node example: local-path)
export NFS_SERVER_IP="${CP_IP}"
export NFS_PATH=/srv/fuzzball/shared

# --- the GPU servers (compute nodes)
export GPU_NODES="10.0.0.134 178.168.1.4"     # Traderui, neal-master
export GPU_HOSTNAMES="Traderui neal-master"   # exactly as `hostname` prints them (used by the static provisioner)
