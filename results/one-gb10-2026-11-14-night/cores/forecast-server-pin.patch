@@ -817,6 +817,35 @@ class PiecesTest(unittest.TestCase):
         self.assertEqual((fs.percentile(hundred, 50), fs.percentile(hundred, 95)), (50.0, 95.0))
         self.assertEqual(fs.percentile([1.0, 2.0, 3.0], 50), 2.0)
 
+    def test_fast_cores_are_the_ones_with_the_top_clock_rate(self):
+        # The event stack's box service: cores 0 to 11 of a GB10, of which 5 to 9 are the fast ones.
+        khz = dict.fromkeys(range(12), 2808000)
+        khz.update(dict.fromkeys(range(5, 10), 3900000))
+        self.assertEqual(fs.fast_cores(list(range(12)), khz), [5, 6, 7, 8, 9])
+        self.assertIsNone(fs.fast_cores([5, 6, 7], khz), "all of its cores are fast: nothing to choose")
+        self.assertIsNone(fs.fast_cores([0, 1, 2], khz), "all of its cores are slow: nothing to choose")
+        self.assertIsNone(fs.fast_cores([], khz))
+        khz[3] = None
+        self.assertIsNone(fs.fast_cores(list(range(12)), khz), "one rate could not be read: leave it alone")
+
+    def test_pinning_reads_the_rates_and_never_fails_the_start(self):
+        folder = tempfile.mkdtemp(prefix="forecast_server_test_")
+        self.addCleanup(shutil.rmtree, folder, True)
+        self.assertIsNone(fs.pin_to_fast_cores(folder), "no rates to read (or no such call here): nothing is changed")
+        if not hasattr(os, "sched_getaffinity"):
+            return                                   # macOS: the call does not exist, and that must not matter
+        before = os.sched_getaffinity(0)
+        self.addCleanup(os.sched_setaffinity, 0, before)
+        allowed = sorted(before)
+        if len(allowed) < 2:
+            return
+        for n, c in enumerate(allowed):              # pretend that the first core is the only fast one
+            os.makedirs(os.path.join(folder, "cpu%d" % c, "cpufreq"))
+            with open(os.path.join(folder, "cpu%d" % c, "cpufreq", "cpuinfo_max_freq"), "w") as f:
+                f.write("3900000\n" if n == 0 else "2808000\n")
+        self.assertEqual(fs.pin_to_fast_cores(folder), [allowed[0]])
+        self.assertEqual(os.sched_getaffinity(0), {allowed[0]})
+
     def test_prometheus_text_leaves_unknowns_out(self):
         text = fs.prom_text({"node": "A", "queued": 3, "ms_per_unit": None, "gpu": {"util_pct": None, "temp_c": 70},
                              "busy_other": True, "served_total": 5})
