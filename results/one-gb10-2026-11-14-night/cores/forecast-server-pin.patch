diff --git a/serve/forecast_server.py b/serve/forecast_server.py
index 5228a49..9a41c15 100644
--- a/serve/forecast_server.py
+++ b/serve/forecast_server.py
@@ -1058,6 +1058,45 @@ class Server(ThreadingHTTPServer):
         ThreadingHTTPServer.handle_error(self, request, client_address)
 
 
+def fast_cores(allowed, max_khz):
+    """The fastest of the cores this process may use, or None when there is nothing to choose.
+    `max_khz` maps a core to its top clock rate in kHz (None when it could not be read)."""
+    rates = [max_khz.get(c) for c in allowed]
+    if not allowed or any(r is None for r in rates):
+        return None
+    top = max(rates)
+    fast = [c for c in allowed if max_khz[c] == top]
+    return fast if len(fast) < len(allowed) else None
+
+
+def pin_to_fast_cores(sysfs="/sys/devices/system/cpu"):
+    """Keep this process on the fastest of its cores. Returns those cores, or None when nothing was changed.
+
+    A GB10 has ten fast cores and ten slower ones, and a job can get some of each (the event stack's box
+    service had cores 0 to 11: five fast, seven slow). A model run is hundreds of small GPU calls, each
+    launched by one CPU thread, so the core under that thread sets the pace: on one GB10 the same forecast
+    took 7.5 ms a model step on a fast core and 18.3 ms on a slow one (Nov 14, 2026). The system usually keeps
+    the busy thread on a fast core, but it is free not to. inference/gpu.py pins itself the same way; a
+    teammate found the effect there first.
+
+    Call it first in main(): threads started later inherit the setting."""
+    try:
+        allowed = sorted(os.sched_getaffinity(0))
+        khz = {}
+        for c in allowed:
+            try:
+                with open("%s/cpu%d/cpufreq/cpuinfo_max_freq" % (sysfs, c)) as f:
+                    khz[c] = int(f.read().strip())
+            except (OSError, ValueError):
+                khz[c] = None
+        fast = fast_cores(allowed, khz)
+        if fast:
+            os.sched_setaffinity(0, fast)
+        return fast
+    except Exception:           # no such call on this system (macOS), or not allowed: serve as before
+        return None
+
+
 def main(argv=None):
     p = argparse.ArgumentParser(description="The forecast server of one node (docs/CONTRACT.md, section 1).")
     p.add_argument("--node", default="A", help="this node's name, as it appears in every answer (default A)")
@@ -1078,6 +1117,8 @@ def main(argv=None):
     p.add_argument("--device", default="auto", choices=["auto", "cuda", "cpu", "mps"],
                    help="real mode: where the model runs (default auto)")
     p.add_argument("--batch", type=int, default=20, help="real mode: how many members advance together (default 20)")
+    p.add_argument("--no-pin", action="store_true",
+                   help="real mode: do not keep the server on the fastest of its CPU cores (default: keep it there)")
     args = p.parse_args(argv)
     if not 0 <= args.port <= 65535:
         p.error("--port must be from 0 to 65535")
@@ -1086,6 +1127,12 @@ def main(argv=None):
     if not args.ms_per_unit >= 0:
         p.error("--ms-per-unit must be 0 or more")
 
+    if not args.mock and not args.no_pin:
+        cores = pin_to_fast_cores()             # before any other thread exists
+        if cores:
+            print("cores: kept on the %d fastest of this process's cores (%s)"
+                  % (len(cores), ",".join(str(c) for c in cores)), flush=True)
+
     stop = threading.Event()
